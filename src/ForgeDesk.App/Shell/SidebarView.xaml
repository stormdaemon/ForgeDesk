<UserControl x:Class="ForgeDesk.App.Shell.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:shell="clr-namespace:ForgeDesk.App.Shell"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Shell;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             x:Name="Root"
             Focusable="False">
  <UserControl.Resources>
    <!-- Home / Activity -->
    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:ShellNavItemViewModel}">
      <Button AutomationProperties.Name="{Binding Title}" Command="{Binding NavigateCommand}" Style="{StaticResource ShellNavButtonStyle}"
              ToolTip="{Binding ToolTip}" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Width="20" VerticalAlignment="Center" FontSize="18" Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeBody}" Text="{Binding Title}"
                     Visibility="{Binding DataContext.Sidebar.IsCollapsed, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- A project: avatar, name, branch, status dot or running spinner, context menu. -->
    <DataTemplate x:Key="ProjectItemTemplate" DataType="{x:Type vm:ProjectNavItemViewModel}">
      <Button AutomationProperties.Name="{Binding Name}" Command="{Binding OpenCommand}" Style="{StaticResource ShellProjectButtonStyle}"
              ToolTip="{Binding ToolTip}">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Command="{Binding OpenCommand}" Header="Open">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Open16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding OpenInExplorerCommand}" Header="Open in Explorer">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="FolderOpen16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding TogglePinCommand}" Header="{Binding PinMenuText}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Pin16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding RenameCommand}" Header="Rename…">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Rename16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding RemoveCommand}" Foreground="{DynamicResource ForgeDangerBrush}" Header="Remove from ForgeDesk…">
              <MenuItem.Icon>
                <ui:SymbolIcon Foreground="{DynamicResource ForgeDangerBrush}" Symbol="Delete16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Button.ContextMenu>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid VerticalAlignment="Center">
            <controls:ProjectAvatar Color="{Binding Color}" ProjectName="{Binding Name}" Size="24" />
            <!-- Rail mode: the status sits on the avatar's corner. -->
            <Border Width="10" Height="10" Margin="0,0,-3,-3" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="5"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    Visibility="{Binding DataContext.Sidebar.IsCollapsed, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <controls:StatusDot Size="6" Status="{Binding Status, Converter={StaticResource StatusToneToKind}}"
                                    Visibility="{Binding Status, Converter={StaticResource StatusToneToVisibility}}" />
                <controls:StatusDot Size="6" Status="Running" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
          </Grid>

          <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"
                      Visibility="{Binding DataContext.Sidebar.IsCollapsed, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Name}" />
            <TextBlock Margin="0,1,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding SecondaryText}"
                       Visibility="{Binding SecondaryText, Converter={StaticResource NullToCollapsed}}" />
          </StackPanel>

          <Grid Grid.Column="2" VerticalAlignment="Center"
                Visibility="{Binding DataContext.Sidebar.IsCollapsed, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
            <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True" ToolTip="A command is running"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <controls:StatusDot Status="{Binding Status, Converter={StaticResource StatusToneToKind}}">
              <controls:StatusDot.Style>
                <Style TargetType="controls:StatusDot">
                  <Setter Property="Visibility" Value="{Binding Status, Converter={StaticResource StatusToneToVisibility}}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:StatusDot.Style>
            </controls:StatusDot>
          </Grid>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- "Add project" menu, shared by the split button and the rail button. -->
    <ContextMenu x:Key="AddProjectMenu" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Command="{Binding AddLocalProjectCommand}" Header="Add local folder…" InputGestureText="Ctrl+O">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="FolderAdd20" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding CloneRepositoryCommand}" Header="Clone repository…" InputGestureText="Ctrl+Shift+O"
                Visibility="{Binding CanClone, Converter={StaticResource BoolToVisibility}}">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="CloudArrowDown20" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <Grid x:Name="Rail">
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Width" Value="240" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Sidebar.IsCollapsed}" Value="True">
            <Setter Property="Width" Value="56" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,4,0,0">
      <ContentPresenter Content="{Binding Sidebar.Home}" ContentTemplate="{StaticResource NavItemTemplate}" />
      <ContentPresenter Content="{Binding Sidebar.Activity}" ContentTemplate="{StaticResource NavItemTemplate}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,8">
        <!-- Pinned -->
        <TextBlock Style="{StaticResource ShellSidebarHeaderStyle}" Text="PINNED">
          <TextBlock.Visibility>
            <MultiBinding Converter="{x:Static shell:SidebarVisibility.HeaderConverter}">
              <Binding Path="Sidebar.HasPinned" />
              <Binding Path="Sidebar.IsCollapsed" />
            </MultiBinding>
          </TextBlock.Visibility>
        </TextBlock>
        <Rectangle Margin="14,10" Style="{StaticResource ForgeDividerStyle}">
          <Rectangle.Visibility>
            <MultiBinding Converter="{x:Static shell:SidebarVisibility.RailDividerConverter}">
              <Binding Path="Sidebar.HasPinned" />
              <Binding Path="Sidebar.IsCollapsed" />
            </MultiBinding>
          </Rectangle.Visibility>
        </Rectangle>
        <ItemsControl Focusable="False" ItemTemplate="{StaticResource ProjectItemTemplate}" ItemsSource="{Binding Sidebar.PinnedProjects}" />

        <!-- Recent -->
        <TextBlock Style="{StaticResource ShellSidebarHeaderStyle}" Text="RECENT">
          <TextBlock.Visibility>
            <MultiBinding Converter="{x:Static shell:SidebarVisibility.HeaderConverter}">
              <Binding Path="Sidebar.HasRecent" />
              <Binding Path="Sidebar.IsCollapsed" />
            </MultiBinding>
          </TextBlock.Visibility>
        </TextBlock>
        <Rectangle Margin="14,10" Style="{StaticResource ForgeDividerStyle}">
          <Rectangle.Visibility>
            <MultiBinding Converter="{x:Static shell:SidebarVisibility.RailDividerConverter}">
              <Binding Path="Sidebar.HasRecent" />
              <Binding Path="Sidebar.IsCollapsed" />
            </MultiBinding>
          </Rectangle.Visibility>
        </Rectangle>
        <ItemsControl Focusable="False" ItemTemplate="{StaticResource ProjectItemTemplate}" ItemsSource="{Binding Sidebar.RecentProjects}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: add project, settings, collapse -->
    <Border Grid.Row="2" Padding="4,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <!-- Expanded -->
        <Grid Visibility="{Binding Sidebar.IsCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SplitButton Margin="4,0" HorizontalAlignment="Stretch" Command="{Binding AddLocalProjectCommand}" Content="Add project"
                          Flyout="{StaticResource AddProjectMenu}" Icon="{ui:SymbolIcon Add20}" ToolTip="Add a local folder (Ctrl+O)" />
          <ui:Button Grid.Column="1" Command="{Binding OpenSettingsCommand}" Icon="{ui:SymbolIcon Settings20}"
                     Style="{StaticResource ShellFooterIconButtonStyle}" ToolTip="Settings (Ctrl+,)"
                     Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Grid.Column="2" Command="{Binding ToggleSidebarCommand}" Icon="{ui:SymbolIcon PanelLeftContract20}"
                     Style="{StaticResource ShellFooterIconButtonStyle}" ToolTip="Collapse the sidebar" />
        </Grid>

        <!-- Rail -->
        <StackPanel HorizontalAlignment="Center" Visibility="{Binding Sidebar.IsCollapsed, Converter={StaticResource BoolToVisibility}}">
          <ui:DropDownButton Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" Flyout="{StaticResource AddProjectMenu}"
                             Icon="{ui:SymbolIcon Add20}" ToolTip="Add project" />
          <ui:Button Margin="0,4,0,0" Command="{Binding OpenSettingsCommand}" Icon="{ui:SymbolIcon Settings20}"
                     Style="{StaticResource ShellFooterIconButtonStyle}" ToolTip="Settings (Ctrl+,)"
                     Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Margin="0,4,0,0" Command="{Binding ToggleSidebarCommand}" Icon="{ui:SymbolIcon PanelLeftExpand20}"
                     Style="{StaticResource ShellFooterIconButtonStyle}" ToolTip="Expand the sidebar" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
