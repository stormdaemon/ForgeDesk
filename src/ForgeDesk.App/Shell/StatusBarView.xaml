<UserControl x:Class="ForgeDesk.App.Shell.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Shell;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatusBarViewModel}"
             Focusable="False">
  <Border Height="26" Padding="4,0" SnapsToDevicePixels="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Current project: branch, ahead/behind, changes, automatic fetch -->
      <StackPanel Orientation="Horizontal" Visibility="{Binding Workspace, Converter={StaticResource NullToCollapsed}}">
        <Button Command="{Binding OpenGitChangesCommand}" Style="{StaticResource ShellStatusItemStyle}" ToolTip="Current branch — open the Git tab"
                Visibility="{Binding Workspace.IsGitRepository, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Symbol="BranchFork16" />
            <TextBlock MaxWidth="220" Style="{StaticResource ShellStatusTextStyle}" Text="{Binding Workspace.BranchName}" />
            <TextBlock Margin="8,0,0,0" Style="{StaticResource ShellStatusTextStyle}" Text="{Binding Workspace.Ahead, StringFormat=↑{0}}"
                       ToolTip="Commits to push" Visibility="{Binding Workspace.Ahead, Converter={StaticResource ZeroToCollapsed}}" />
            <TextBlock Margin="6,0,0,0" Style="{StaticResource ShellStatusTextStyle}" Text="{Binding Workspace.Behind, StringFormat=↓{0}}"
                       ToolTip="Commits to pull" Visibility="{Binding Workspace.Behind, Converter={StaticResource ZeroToCollapsed}}" />
          </StackPanel>
        </Button>

        <Button Command="{Binding OpenGitChangesCommand}" Style="{StaticResource ShellStatusItemStyle}" ToolTip="Uncommitted changes — open the Git tab"
                Visibility="{Binding Workspace.ChangedCount, Converter={StaticResource ZeroToCollapsed}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Symbol="Edit16" />
            <TextBlock Style="{StaticResource ShellStatusTextStyle}" Text="{Binding Workspace.ChangesText}" />
          </StackPanel>
        </Button>

        <!-- Background fetch: spinning while it runs, a quiet warning when the remote is unreachable. -->
        <StackPanel Margin="6,0" VerticalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding Workspace.Sync.IsAutoFetching, Converter={StaticResource BoolToVisibility}}">
          <ui:ProgressRing Width="10" Height="10" IsIndeterminate="True" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="Fetching…" />
        </StackPanel>
        <StackPanel Margin="6,0" VerticalAlignment="Center" Background="Transparent" Orientation="Horizontal"
                    ToolTip="{Binding Workspace.Sync.AutoFetchError.Message}"
                    Visibility="{Binding Workspace.Sync.AutoFetchStatus, Converter={StaticResource NullToCollapsed}}">
          <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ForgeWarningBrush}"
                         Symbol="CloudOff16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Workspace.Sync.AutoFetchStatus}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <!-- Running commands -->
        <Button Command="{Binding OpenRunningCommandsCommand}" Style="{StaticResource ShellStatusItemStyle}" ToolTip="{Binding RunningToolTip}"
                Visibility="{Binding HasRunning, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:ProgressRing Width="10" Height="10" Margin="0,0,6,0" IsIndeterminate="True" />
            <TextBlock Style="{StaticResource ShellStatusTextStyle}" Text="{Binding RunningCount, StringFormat={}{0} running}" />
            <TextBlock MaxWidth="200" Margin="4,0,0,0" Style="{StaticResource ShellStatusTextStyle}"
                       Text="{Binding LatestRunLabel, StringFormat=· {0}}" />
          </StackPanel>
        </Button>

        <!-- Background operations (clone, analysis…) -->
        <StackPanel Margin="8,0" VerticalAlignment="Center" Background="Transparent" Orientation="Horizontal"
                    ToolTip="{Binding OperationsToolTip}" Visibility="{Binding HasOperations, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar Width="72" Height="4" VerticalAlignment="Center" Maximum="1"
                       IsIndeterminate="{Binding CurrentOperation.Progress, Converter={StaticResource IsNull}}"
                       Value="{Binding CurrentOperation.Progress, Mode=OneWay, TargetNullValue=0}" />
          <TextBlock MaxWidth="240" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}"
                     Text="{Binding CurrentOperation.Title}" />
          <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding MoreOperationsText}"
                     Visibility="{Binding MoreOperationsText, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- Update available (set by the updater) -->
        <StackPanel Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
          <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ForgeAccentTextBrush}"
                         Symbol="ArrowCircleUp16" />
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ForgeAccentTextBrush}" Style="{StaticResource ForgeCaption}"
                     Text="{Binding UpdateText}" />
        </StackPanel>

        <!-- GitHub account -->
        <Button Command="{Binding OpenGitHubAccountCommand}" Style="{StaticResource ShellStatusItemStyle}"
                ToolTip="{Binding GitHubText, StringFormat=GitHub: {0}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                     Visibility="{Binding GitHubAvatarUrl, Converter={StaticResource NullToCollapsed}}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding GitHubAvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
            <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" Symbol="Person16"
                           Visibility="{Binding GitHubAvatarUrl, Converter={StaticResource NullToVisible}}" />
            <TextBlock Style="{StaticResource ShellStatusTextStyle}" Text="{Binding GitHubText}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
