<UserControl x:Class="ForgeDesk.App.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:shell="clr-namespace:ForgeDesk.App.Shell"
             xmlns:palette="clr-namespace:ForgeDesk.App.Features.Palette"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Shell;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             x:Name="Root"
             Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- ===== Title bar: logo, breadcrumb, search, GitHub account, caption buttons ===== -->
    <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="48" Padding="12,0,0,0" Title="ForgeDesk">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Width="18" Height="18" Source="{StaticResource ForgeLogoMark}" />
      </ui:TitleBar.Icon>

      <ui:TitleBar.Header>
        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource ForgeCaption}" Text="ForgeDesk" />

          <ui:SymbolIcon Margin="8,0,2,0" VerticalAlignment="Center" FontSize="10" Symbol="ChevronRight12"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                         Visibility="{Binding PageTitle, Converter={StaticResource NullToCollapsed}}" />
          <Button Padding="6,2" Command="{Binding GoHomeCommand}" Style="{StaticResource ShellQuietButtonStyle}"
                  ToolTip="Go to the dashboard"
                  Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding PageTitle}" />
          </Button>
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding PageTitle}"
                     Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVisibility}}" />

          <ui:SymbolIcon Margin="2,0,6,0" VerticalAlignment="Center" FontSize="10" Symbol="ChevronRight12"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                         Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock MaxWidth="220" VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="{Binding CurrentWorkspace.Name}"
                     ToolTip="{Binding CurrentWorkspace.Path}"
                     Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:TitleBar.Header>

      <ui:TitleBar.CenterContent>
        <Button x:Name="SearchBox" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                AutomationProperties.Name="Search or run a command"
                Command="{Binding OpenPaletteCommand}" PreviewTextInput="OnSearchBoxTextInput"
                Style="{StaticResource ShellSearchBoxStyle}" ToolTip="Search projects, files and actions (Ctrl+K)">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon VerticalAlignment="Center" FontSize="14" Symbol="Search16" />
            <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}"
                       Text="Search or run a command" />
            <controls:KeyHint Grid.Column="2" Keys="Ctrl+K" />
          </Grid>
        </Button>
      </ui:TitleBar.CenterContent>

      <ui:TitleBar.TrailingContent>
        <Button Margin="0,0,8,0" Command="{Binding StatusBar.OpenGitHubAccountCommand}" Style="{StaticResource ShellQuietButtonStyle}"
                ToolTip="{Binding StatusBar.GitHubText, StringFormat=GitHub: {0}}">
          <StackPanel Orientation="Horizontal">
            <Grid Width="22" Height="22" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Symbol="Person16"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Ellipse Visibility="{Binding StatusBar.GitHubAvatarUrl, Converter={StaticResource NullToCollapsed}}">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding StatusBar.GitHubAvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="{Binding StatusBar.GitHubText}" />
          </StackPanel>
        </Button>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <!-- ===== Sidebar + page ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <shell:SidebarView Grid.Column="0" />

      <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8"
              SnapsToDevicePixels="True">
        <Grid ClipToBounds="True">
          <shell:PageHost Content="{Binding CurrentPage}" />
          <controls:EmptyState Icon="FolderAdd24" Title="No project open"
                               Description="Add a folder from your disk, or clone a repository, to start working on it in ForgeDesk."
                               ActionText="Add local project…" ActionCommand="{Binding AddLocalProjectCommand}"
                               SecondaryActionText="{Binding CloneActionText}" SecondaryActionCommand="{Binding CloneRepositoryCommand}"
                               Visibility="{Binding ShowNoPage, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Status bar ===== -->
    <shell:StatusBarView Grid.Row="2" DataContext="{Binding StatusBar}" />

    <!-- ===== Command palette: a Popup so it renders above hosted HWNDs (terminal) ===== -->
    <Popup x:Name="PalettePopup" Grid.Row="0" Grid.RowSpan="3" AllowsTransparency="True" Focusable="False"
           IsOpen="{Binding Palette.IsOpen, Mode=TwoWay}" Placement="Custom" PlacementTarget="{Binding ElementName=Root}"
           PopupAnimation="Fade" StaysOpen="False">
      <palette:CommandPaletteView DataContext="{Binding Palette}" />
    </Popup>
  </Grid>
</UserControl>
