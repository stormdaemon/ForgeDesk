<ui:FluentWindow x:Class="ForgeDesk.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ForgeDesk"
                 Width="1400"
                 Height="900"
                 MinWidth="960"
                 MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource ForgeUIFont}"
                 FontSize="13"
                 Icon="pack://application:,,,/Assets/ForgeDesk.ico"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The shell view (title bar, sidebar, pages, status bar) comes from the shell view model's DataTemplate. -->
    <ContentPresenter x:Name="ShellHost" Grid.RowSpan="2" Content="{Binding}" />

    <!-- Caption bar used only until a shell view model is set, so the window can always be moved and closed. -->
    <ui:TitleBar x:Name="FallbackTitleBar" Title="ForgeDesk">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="{StaticResource ForgeLogoMark}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Notifications float above the page, clear of the 26 px status bar. -->
    <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.RowSpan="2" MaxWidth="640" Margin="24,0,24,34"
                          VerticalAlignment="Bottom" />
  </Grid>
</ui:FluentWindow>
