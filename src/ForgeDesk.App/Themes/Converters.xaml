<!-- Shared value converters (DESIGN.md). Reference them with StaticResource by these keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ForgeDesk.App.Converters">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="BoolToHidden" UseHidden="True" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
  <conv:NullToVisibilityConverter x:Key="NotNullToVisible" />
  <conv:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
  <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
  <conv:RelativeTimeConverter x:Key="RelativeTime" />
  <conv:DurationConverter x:Key="Duration" />
  <conv:SymbolFromNameConverter x:Key="SymbolFromName" />
  <conv:StatusToBrushConverter x:Key="StatusToBrush" />
  <conv:ToStatusKindConverter x:Key="ToStatusKind" />
  <conv:BytesToTextConverter x:Key="BytesToText" />
  <conv:UpperCaseConverter x:Key="UpperCase" />
</ResourceDictionary>
