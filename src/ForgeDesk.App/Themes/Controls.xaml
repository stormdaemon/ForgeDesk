<!--
  Forge control styles layered on WPF-UI (DESIGN.md: dense rows, 4 px grid, radius 8 for cards and
  4 for controls, accent for selection). Brushes are DynamicResource so both themes work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- ===== Cards ===================================================================== -->

  <!-- A content section: card surface, 8 px corners, 16 px padding. Stack cards with ForgeCardGap. -->
  <Style x:Key="ForgeSectionCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Same surface without inner padding, for cards hosting lists edge to edge. -->
  <Style x:Key="ForgeSectionCardFlushStyle" TargetType="Border" BasedOn="{StaticResource ForgeSectionCardStyle}">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ===== Pills and badges =========================================================== -->

  <Style x:Key="ForgePillStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1,6,2" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Background" Value="{DynamicResource ForgeNeutralSubtleBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Small rounded counter ("3") for tabs and sidebar entries. -->
  <Style x:Key="ForgeCountBadgeStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- ===== Buttons ==================================================================== -->

  <!-- Quiet button for toolbars and headers: transparent until hovered. -->
  <Style x:Key="ForgeToolbarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Square icon-only toolbar button. Always give it a ToolTip that names the shortcut. -->
  <Style x:Key="ForgeIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ForgeToolbarButtonStyle}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ===== Lists ====================================================================== -->

  <!-- Dense (32 px) list row with Fluent hover, and accent pill + subtle fill when selected. -->
  <Style x:Key="ForgeDenseListBoxItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="MinHeight" Value="{DynamicResource ForgeListRowHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="4" />
            <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Fill="{DynamicResource ForgeAccentBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Table row (28 px). -->
  <Style x:Key="ForgeTableRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
    <Setter Property="MinHeight" Value="{DynamicResource ForgeTableRowHeight}" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- Virtualized, recycling list with dense rows. Use for anything that can grow long. -->
  <Style x:Key="ForgeDenseListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ForgeDenseListBoxItemStyle}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
  </Style>

  <!-- ===== Sidebar ==================================================================== -->

  <!-- Left navigation entry (Home, Activity, projects): 36 px, rounded, accent pill when current. -->
  <Style x:Key="ForgeSidebarItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="4" />
            <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Fill="{DynamicResource ForgeAccentBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ForgeSidebarListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ForgeSidebarItemStyle}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
  </Style>

  <!-- ===== Workspace tab strip ======================================================== -->

  <!--
    Horizontal tab strip for the project workspace (Overview · Git · Files …), built on ListBox so
    the selected tab binds to the view model. Selection shows an accent underline.
  -->
  <Style x:Key="ForgeWorkspaceTabItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Margin="2,4" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Rectangle x:Name="Indicator" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="12,0" VerticalAlignment="Bottom"
                       Fill="{DynamicResource ForgeAccentBrush}" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ForgeWorkspaceTabStripStyle" TargetType="ListBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ForgeWorkspaceTabItemStyle}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                          CanContentScroll="False">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Splitters ================================================================== -->

  <!-- Vertical pane splitter: 6 px hit area, 1 px divider, accent while hovered or dragged. -->
  <Style x:Key="ForgeGridSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent">
            <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Line" Property="Width" Value="2" />
              <Setter TargetName="Line" Property="Fill" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Line" Property="Width" Value="2" />
              <Setter TargetName="Line" Property="Fill" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Horizontal pane splitter (between stacked panes). -->
  <Style x:Key="ForgeHorizontalGridSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent">
            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Line" Property="Height" Value="2" />
              <Setter TargetName="Line" Property="Fill" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Line" Property="Height" Value="2" />
              <Setter TargetName="Line" Property="Fill" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Misc ======================================================================= -->

  <!-- Thin horizontal rule between sections. -->
  <Style x:Key="ForgeDividerStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Read-only, selectable monospace text (error details, command lines). -->
  <Style x:Key="ForgeReadOnlyMonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource ForgeMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
  </Style>
</ResourceDictionary>
