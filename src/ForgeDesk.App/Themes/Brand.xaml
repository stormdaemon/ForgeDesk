<!--
  Forge brand resources. The values below are the dark-theme defaults; ThemeService replaces
  every Forge*Color / Forge*Brush for the active theme and accent at startup and whenever the
  theme changes (see Theming/BrandPalette.cs). Always consume them with DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Ember identity (fixed in every theme) -->
  <Color x:Key="ForgeEmberColor">#F2762E</Color>
  <Color x:Key="ForgeEmberLightColor">#FF9A57</Color>
  <Color x:Key="ForgeEmberDarkColor">#C9551A</Color>
  <Color x:Key="ForgeSteelColor">#2B303A</Color>
  <SolidColorBrush x:Key="ForgeEmberBrush" Color="#F2762E" />
  <SolidColorBrush x:Key="ForgeEmberLightBrush" Color="#FF9A57" />
  <SolidColorBrush x:Key="ForgeEmberDarkBrush" Color="#C9551A" />
  <SolidColorBrush x:Key="ForgeSteelBrush" Color="#2B303A" />

  <!-- Accent (ember, or the Windows accent when the user asks for it) -->
  <Color x:Key="ForgeAccentColor">#F2762E</Color>
  <Color x:Key="ForgeAccentTextColor">#FF9A57</Color>
  <Color x:Key="ForgeAccentSubtleColor">#26F2762E</Color>
  <Color x:Key="ForgeRunningColor">#F2762E</Color>
  <SolidColorBrush x:Key="ForgeAccentBrush" Color="#F2762E" />
  <SolidColorBrush x:Key="ForgeAccentTextBrush" Color="#FF9A57" />
  <SolidColorBrush x:Key="ForgeAccentSubtleBrush" Color="#26F2762E" />
  <SolidColorBrush x:Key="ForgeRunningBrush" Color="#F2762E" />

  <!-- Status -->
  <Color x:Key="ForgeSuccessColor">#3FB950</Color>
  <Color x:Key="ForgeSuccessSubtleColor">#263FB950</Color>
  <Color x:Key="ForgeWarningColor">#D29922</Color>
  <Color x:Key="ForgeWarningSubtleColor">#26D29922</Color>
  <Color x:Key="ForgeDangerColor">#F85149</Color>
  <Color x:Key="ForgeDangerSubtleColor">#26F85149</Color>
  <Color x:Key="ForgeInfoColor">#58A6FF</Color>
  <Color x:Key="ForgeInfoSubtleColor">#2658A6FF</Color>
  <Color x:Key="ForgeNeutralColor">#8B949E</Color>
  <Color x:Key="ForgeNeutralSubtleColor">#268B949E</Color>
  <SolidColorBrush x:Key="ForgeSuccessBrush" Color="#3FB950" />
  <SolidColorBrush x:Key="ForgeSuccessSubtleBrush" Color="#263FB950" />
  <SolidColorBrush x:Key="ForgeWarningBrush" Color="#D29922" />
  <SolidColorBrush x:Key="ForgeWarningSubtleBrush" Color="#26D29922" />
  <SolidColorBrush x:Key="ForgeDangerBrush" Color="#F85149" />
  <SolidColorBrush x:Key="ForgeDangerSubtleBrush" Color="#26F85149" />
  <SolidColorBrush x:Key="ForgeInfoBrush" Color="#58A6FF" />
  <SolidColorBrush x:Key="ForgeInfoSubtleBrush" Color="#2658A6FF" />
  <SolidColorBrush x:Key="ForgeNeutralBrush" Color="#8B949E" />
  <SolidColorBrush x:Key="ForgeNeutralSubtleBrush" Color="#268B949E" />

  <!-- Diff -->
  <Color x:Key="ForgeDiffAddedBackgroundColor">#262EA043</Color>
  <Color x:Key="ForgeDiffRemovedBackgroundColor">#26F85149</Color>
  <Color x:Key="ForgeDiffAddedGutterColor">#3FB950</Color>
  <Color x:Key="ForgeDiffRemovedGutterColor">#F85149</Color>
  <Color x:Key="ForgeDiffHunkBackgroundColor">#1A58A6FF</Color>
  <SolidColorBrush x:Key="ForgeDiffAddedBackgroundBrush" Color="#262EA043" />
  <SolidColorBrush x:Key="ForgeDiffRemovedBackgroundBrush" Color="#26F85149" />
  <SolidColorBrush x:Key="ForgeDiffAddedGutterBrush" Color="#3FB950" />
  <SolidColorBrush x:Key="ForgeDiffRemovedGutterBrush" Color="#F85149" />
  <SolidColorBrush x:Key="ForgeDiffHunkBackgroundBrush" Color="#1A58A6FF" />

  <!-- Loading placeholders -->
  <Color x:Key="ForgeSkeletonColor">#14FFFFFF</Color>
  <Color x:Key="ForgeSkeletonShimmerColor">#1AFFFFFF</Color>
  <SolidColorBrush x:Key="ForgeSkeletonBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ForgeSkeletonShimmerBrush" Color="#1AFFFFFF" />

  <!-- Fonts: Segoe UI Variable (Windows 11) with Segoe UI fallback, mono text (paths, hashes, logs)
       and the user-configurable code font -->
  <FontFamily x:Key="ForgeUIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="ForgeDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="ForgeMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="ForgeCodeFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="ForgeCodeFontSize">13</sys:Double>

  <!-- Metrics (4 px grid) -->
  <sys:Double x:Key="ForgeListRowHeight">32</sys:Double>
  <sys:Double x:Key="ForgeTableRowHeight">28</sys:Double>
  <sys:Double x:Key="ForgeStatusBarHeight">26</sys:Double>
  <Thickness x:Key="ForgePagePadding">24</Thickness>
  <Thickness x:Key="ForgeCardPadding">16</Thickness>
  <Thickness x:Key="ForgeCardGap">0,0,0,12</Thickness>
  <CornerRadius x:Key="ForgeCardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ForgeControlCornerRadius">4</CornerRadius>

  <!-- Logo: vector twin of Assets/ForgeDesk.ico (generated by build/generate-icons.py - -xaml) -->
  <DrawingImage x:Key="ForgeLogoMark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="M0,0 H256 V256 H0 Z" Brush="Transparent" />
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="8,8,240,240" RadiusX="52" RadiusY="52" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#454D5C" />
              <GradientStop Offset="1" Color="#1D212A" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 40 128 Q 60 116 92 114 L 212 114 L 212 142 Q 188 146 172 152 Q 160 158 158 172 L 158 180 Q 182 184 196 194 L 200 210 L 72 210 L 76 194 Q 90 184 114 180 L 114 172 Q 112 158 96 150 Q 70 140 40 128 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#FF9A57" />
              <GradientStop Offset="1" Color="#C9551A" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 92 114 L 212 114 L 212 122 L 88 122 Q 70 124 52 128 Q 64 118 92 114 Z" Brush="#E6FFC494" />
        <GeometryDrawing Geometry="M 150 32 Q 154 66 184 70 Q 154 74 150 108 Q 146 74 116 70 Q 146 66 150 32 Z M 196 36 Q 197.5 46.5 208 48 Q 197.5 49.5 196 60 Q 194.5 49.5 184 48 Q 194.5 46.5 196 36 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#FFE2B8" />
              <GradientStop Offset="1" Color="#FF9A57" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FF9A57">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="106,58" RadiusX="5" RadiusY="5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Raster logo for large placements (About page, onboarding) -->
  <BitmapImage x:Key="ForgeLogoImage" UriSource="pack://application:,,,/Assets/ForgeDeskLogo-256.png" />
</ResourceDictionary>
