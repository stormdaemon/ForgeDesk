<UserControl x:Class="ForgeDesk.App.Controls.ProjectAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             VerticalAlignment="Center">
  <Border x:Name="Tile" SnapsToDevicePixels="True">
    <TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
               TextOptions.TextFormattingMode="Ideal" />
  </Border>
</UserControl>
