<UserControl x:Class="ForgeDesk.App.Controls.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="ForgeSearchToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Fluent find bar for AvalonEdit (Ctrl+F, F3 / Shift+F3, Esc). -->
    <Style x:Key="ForgeSearchPanelStyle" TargetType="search:SearchPanel">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="search:SearchPanel">
            <Border Margin="0,8,24,0" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1" CornerRadius="8" Cursor="Arrow">
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PART_searchTextBox" Width="220" VerticalContentAlignment="Center">
                  <TextBox.Text>
                    <Binding Path="SearchPattern" RelativeSource="{RelativeSource TemplatedParent}" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <ExceptionValidationRule />
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
                <ToggleButton Margin="6,0,0,0" Content="Aa" IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{StaticResource ForgeSearchToggleStyle}" ToolTip="Match case" />
                <ToggleButton IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{StaticResource ForgeSearchToggleStyle}" ToolTip="Match whole word">
                  <TextBlock Text="ab" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton Content=".*" IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{StaticResource ForgeSearchToggleStyle}" ToolTip="Use regular expression" />
                <ui:Button Margin="6,0,0,0" Command="{x:Static search:SearchCommands.FindPrevious}" Icon="{ui:SymbolIcon ArrowUp16}"
                           Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Previous match (Shift+F3)" />
                <ui:Button Command="{x:Static search:SearchCommands.FindNext}" Icon="{ui:SymbolIcon ArrowDown16}"
                           Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Next match (F3)" />
                <ui:Button Command="{x:Static search:SearchCommands.CloseSearchPanel}" Icon="{ui:SymbolIcon Dismiss16}"
                           Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Close (Esc)" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <avalonedit:TextEditor x:Name="Editor"
                         Background="Transparent"
                         FontFamily="{DynamicResource ForgeCodeFont}"
                         FontSize="{DynamicResource ForgeCodeFontSize}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                         Padding="4,0,0,0"
                         ShowLineNumbers="True"
                         VerticalScrollBarVisibility="Auto"
                         WordWrap="False" />
</UserControl>
