<UserControl x:Class="ForgeDesk.App.Controls.LoadingState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="False">
  <StackPanel x:Name="Body" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
    <ui:ProgressRing Width="32" Height="32" HorizontalAlignment="Center" IsIndeterminate="True" />
    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource ForgeBodySecondary}"
               Text="{Binding Message, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
               Visibility="{Binding Message, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />
  </StackPanel>
</UserControl>
