<UserControl x:Class="ForgeDesk.App.Controls.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             VerticalAlignment="Center">
  <Grid Width="{Binding Size, ElementName=Root}" Height="{Binding Size, ElementName=Root}">
    <Ellipse x:Name="Halo" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
      <Ellipse.RenderTransform>
        <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
      </Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="Dot" />
  </Grid>
</UserControl>
