<UserControl x:Class="ForgeDesk.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="False">
  <StackPanel MaxWidth="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="56" Height="56" HorizontalAlignment="Center" CornerRadius="28"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
      <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Symbol="{Binding Icon, ElementName=Root}" />
    </Border>

    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource ForgeSubtitle}"
               Text="{Binding Title, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap" />

    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource ForgeBodySecondary}"
               Text="{Binding Description, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
               Visibility="{Binding Description, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
      <ui:Button Appearance="Primary"
                 Command="{Binding ActionCommand, ElementName=Root}"
                 CommandParameter="{Binding ActionCommandParameter, ElementName=Root}"
                 Content="{Binding ActionText, ElementName=Root}"
                 Visibility="{Binding ActionText, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />
      <ui:Button Margin="8,0,0,0" Appearance="Secondary"
                 Command="{Binding SecondaryActionCommand, ElementName=Root}"
                 CommandParameter="{Binding SecondaryActionCommandParameter, ElementName=Root}"
                 Content="{Binding SecondaryActionText, ElementName=Root}"
                 Visibility="{Binding SecondaryActionText, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
