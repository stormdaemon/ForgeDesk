<UserControl x:Class="ForgeDesk.App.Controls.Pill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="False"
             VerticalAlignment="Center">
  <Border x:Name="Surface" Style="{StaticResource ForgePillStyle}">
    <StackPanel Orientation="Horizontal">
      <ui:SymbolIcon x:Name="PillIcon" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed" />
      <TextBlock x:Name="PillText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                 Text="{Binding Text, ElementName=Root}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</UserControl>
