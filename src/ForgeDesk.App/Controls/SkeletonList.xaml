<UserControl x:Class="ForgeDesk.App.Controls.SkeletonList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             IsHitTestVisible="False">
  <Grid x:Name="Body" VerticalAlignment="Top" ClipToBounds="True">
    <StackPanel x:Name="Rows" />

    <!-- The shimmer band is masked by the placeholder bars so only they glint. -->
    <Rectangle x:Name="Shimmer">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
          <LinearGradientBrush.RelativeTransform>
            <TranslateTransform x:Name="ShimmerOffset" X="-1" />
          </LinearGradientBrush.RelativeTransform>
          <GradientStop Offset="0.3" Color="#00FFFFFF" />
          <GradientStop Offset="0.5" Color="{DynamicResource ForgeSkeletonShimmerColor}" />
          <GradientStop Offset="0.7" Color="#00FFFFFF" />
        </LinearGradientBrush>
      </Rectangle.Fill>
      <Rectangle.OpacityMask>
        <VisualBrush AlignmentX="Left" AlignmentY="Top" Stretch="None" Visual="{Binding ElementName=Rows}" />
      </Rectangle.OpacityMask>
    </Rectangle>
  </Grid>
</UserControl>
