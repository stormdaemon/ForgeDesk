<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ForgeDesk.App</RootNamespace>
    <AssemblyName>ForgeDesk</AssemblyName>
    <!-- Program.Main runs Velopack and the single-instance check before WPF starts. -->
    <StartupObject>ForgeDesk.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ForgeDesk.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Version, Product, Company and Copyright flow from Directory.Build.props. -->
    <AssemblyTitle>ForgeDesk</AssemblyTitle>
    <Description>ForgeDesk — a native developer cockpit for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="EasyWindowsTerminalControl" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ForgeDesk.Core\ForgeDesk.Core.csproj" />
    <ProjectReference Include="..\ForgeDesk.Presentation\ForgeDesk.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>
</Project>
