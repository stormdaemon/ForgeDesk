<UserControl x:Class="ForgeDesk.App.Features.Releases.ReleaseWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Releases;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReleaseWizardViewModel}"
             d:DesignHeight="760" d:DesignWidth="1100"
             x:Name="Root"
             AutomationProperties.AutomationId="Releases.Wizard"
             Focusable="False">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Title ===== -->
    <Grid Margin="24,16,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="36" Height="36" Margin="0,0,12,0" Background="{DynamicResource ForgeAccentSubtleBrush}" CornerRadius="8">
        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource ForgeAccentTextBrush}" Symbol="Rocket20" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="New release" />
        <TextBlock Style="{StaticResource ForgeBodySecondary}" Text="{Binding ProjectName}" />
      </StackPanel>
      <ui:Button Grid.Column="2" VerticalAlignment="Top" AutomationProperties.AutomationId="Releases.CloseWizardButton" AutomationProperties.Name="Close the release wizard"
                 Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Close (Esc)" />
    </Grid>

    <!-- ===== Stepper: Version · Notes · Assets · Review ===== -->
    <Grid Grid.Row="1" Margin="24,16,24,0">
      <ItemsControl AutomationProperties.AutomationId="Releases.Stepper" AutomationProperties.Name="Release steps" Focusable="False" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:WizardStepViewModel}">
            <StackPanel Orientation="Horizontal">
              <Rectangle x:Name="Connector" Width="40" Height="1" Margin="12,0" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                         Visibility="{Binding HasConnector, Converter={StaticResource BoolToVisibility}}" />
              <Button AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}"
                      Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                      Cursor="Hand" FocusVisualStyle="{StaticResource ReleasesFocusVisualStyle}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                  </ControlTemplate>
                </Button.Template>
                <StackPanel Background="Transparent" Orientation="Horizontal">
                  <Grid Width="24" Height="24" Margin="0,0,8,0">
                    <Ellipse x:Name="Circle" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                    <TextBlock x:Name="Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NumberText}" />
                    <ui:SymbolIcon x:Name="Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForgeSuccessBrush}"
                                   Symbol="Checkmark16" Visibility="Collapsed" />
                  </Grid>
                  <TextBlock x:Name="Label" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Title}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource ForgeSuccessSubtleBrush}" />
                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ForgeSuccessBrush}" />
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Connector" Property="Fill" Value="{DynamicResource ForgeSuccessBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource ForgeAccentBrush}" />
                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ForgeAccentBrush}" />
                <Setter TargetName="Number" Property="Foreground" Value="White" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Rectangle Margin="0,0,0,-12" VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />
    </Grid>

    <!-- ===== Body ===== -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <controls:LoadingState IsActive="{Binding IsPreparing}" Message="Reading tags and commits…"
                             Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}" />
      <controls:ErrorPanel Margin="24" AutomationProperties.AutomationId="Releases.PrepareError" Error="{Binding Error}" RetryCommand="{Binding RetryPrepareCommand}" />

      <Grid Visibility="{Binding IsPrepared, Converter={StaticResource BoolToVisibility}}">

        <!-- Step 1 · Version -->
        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsVersionStep, Converter={StaticResource BoolToVisibility}}">
          <StackPanel MaxWidth="920" Margin="24,8,24,24" HorizontalAlignment="Left">
            <ui:InfoBar Margin="0,0,0,12" AutomationProperties.AutomationId="Releases.Blockers" IsClosable="False" IsOpen="{Binding HasBlockers}"
                        Message="{Binding BlockersText}" Severity="Error" Title="This release can't be published yet" />
            <ui:InfoBar Margin="0,0,0,12" AutomationProperties.AutomationId="Releases.Warnings" IsClosable="False" IsOpen="{Binding HasWarnings}"
                        Message="{Binding WarningsText}" Severity="Warning" Title="Check before publishing" />

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource ReleasesGroupTitleStyle}" Text="VERSION" />
              <TextBlock Grid.Column="1" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding LatestText}" />
            </Grid>

            <ItemsControl Focusable="False" ItemsSource="{Binding VersionOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:VersionOptionViewModel}">
                  <Button AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}"
                          Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                          Style="{StaticResource ReleaseChoiceCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Label}" />
                        <controls:Pill Grid.Column="1" Kind="Success" Text="Recommended" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}" />
                      </Grid>
                      <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource ForgeMonoFont}" Style="{StaticResource ForgeTitle}" Text="{Binding Version}" />
                      <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding TagName, StringFormat=tag {0}}" />
                      <TextBlock Margin="0,8,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Reason}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom version -->
            <Border Margin="0,0,12,0" Padding="16,12" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UseCustomVersion}" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
                      <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton VerticalAlignment="Center" AutomationProperties.AutomationId="Releases.CustomVersionOption" Command="{Binding ChooseCustomVersionCommand}"
                             Content="Another version" GroupName="ReleaseVersion" IsChecked="{Binding UseCustomVersion, Mode=OneWay}" />
                <ui:TextBox x:Name="CustomVersionBox" Grid.Column="1" MaxWidth="260" Margin="16,0,0,0" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="Releases.CustomVersion" AutomationProperties.Name="Custom version" ClearButtonEnabled="False"
                            FontFamily="{DynamicResource ForgeMonoFont}" GotKeyboardFocus="OnCustomVersionFocused" PlaceholderText="1.4.0 or 2.0.0-beta.1"
                            Text="{Binding CustomVersion, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding VersionError, Converter={StaticResource NullToCollapsed}}">
              <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForgeDangerBrush}" Symbol="ErrorCircle16" />
              <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="Releases.VersionError" Foreground="{DynamicResource ForgeDangerBrush}"
                         Style="{StaticResource ForgeBody}" Text="{Binding VersionError}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding VersionWarning, Converter={StaticResource NullToCollapsed}}">
              <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForgeWarningBrush}" Symbol="Warning16" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ForgeWarningBrush}" Style="{StaticResource ForgeBody}" Text="{Binding VersionWarning}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Details -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource ReleasesGroupTitleStyle}" Text="DETAILS" />
            <Border Margin="0,0,12,0" Style="{StaticResource ForgeSectionCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Title" />
                  <ui:TextBox AutomationProperties.AutomationId="Releases.Title" AutomationProperties.Name="Release title" ClearButtonEnabled="False"
                              PlaceholderText="ForgeDesk 1.2.0" Text="{Binding ReleaseTitle, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Tag the commit at" />
                  <ComboBox AutomationProperties.AutomationId="Releases.Target" AutomationProperties.Name="Commit to tag" ItemsSource="{Binding TargetOptions}"
                            SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ReleaseTargetOption}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Title}" />
                          <TextBlock Margin="8,0,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Description}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                  <ui:ToggleSwitch AutomationProperties.AutomationId="Releases.PrereleaseToggle" AutomationProperties.Name="Pre-release" Content="Pre-release"
                                   IsChecked="{Binding IsPrerelease}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="Marked as not ready for production; never shown as Latest."
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                  <ui:ToggleSwitch AutomationProperties.AutomationId="Releases.DraftToggle" AutomationProperties.Name="Save as draft" Content="Save as draft"
                                   IsChecked="{Binding IsDraft}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="Only collaborators see it until you publish it on GitHub."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Step 2 · Notes -->
        <Grid Margin="24,8,24,16" Visibility="{Binding IsNotesStep, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource ForgeSubtitle}" Text="Release notes" />
              <TextBlock TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
                    <Setter Property="Text" Value="Drafted from the commits since the last release. They follow the version until you edit them." />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding NotesEdited}" Value="True">
                        <Setter Property="Text" Value="Edited: changing the version keeps your text. Rebuild to draft them again from the commits." />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button Margin="0,0,8,0" AutomationProperties.AutomationId="Releases.RebuildNotesButton" Command="{Binding RebuildNotesCommand}" Content="Rebuild from commits"
                         Icon="{ui:SymbolIcon ArrowClockwise16}" ToolTip="Replace the notes with a fresh draft from the commits"
                         Visibility="{Binding NotesEdited, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Margin="0,0,8,0" AutomationProperties.AutomationId="Releases.GenerateNotesButton" Command="{Binding GenerateNotesCommand}"
                         Content="Generate with GitHub" Icon="{ui:SymbolIcon Sparkle16}" IsEnabled="{Binding IsGeneratingNotes, Converter={StaticResource ReleasesInverseBoolean}}"
                         ToolTip="Let GitHub write notes from the pull requests merged since the last release" />
              <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True"
                               Visibility="{Binding IsGeneratingNotes, Converter={StaticResource BoolToVisibility}}" />
              <ToggleButton Padding="10,5" AutomationProperties.AutomationId="Releases.PreviewToggle" IsChecked="{Binding ShowPreview}" ToolTip="Show the rendered notes">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Symbol="Eye16" />
                  <TextBlock VerticalAlignment="Center" Text="Preview" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Grid>
          <ui:TextBox Grid.Row="1" VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="True" AutomationProperties.AutomationId="Releases.NotesEditor"
                      AutomationProperties.Name="Release notes" ClearButtonEnabled="False" FontFamily="{DynamicResource ForgeMonoFont}" FontSize="13"
                      HorizontalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="True" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                      VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPreview, Converter={StaticResource InverseBoolToVisibility}}" />
          <Border Grid.Row="1" Padding="20,16" AutomationProperties.AutomationId="Releases.NotesPreview" Style="{StaticResource ForgeSectionCardStyle}"
                  Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
            <github:MarkdownViewer EmptyText="No release notes." IsScrollable="True" LinkCommand="{Binding OpenLinkCommand}" Markdown="{Binding Notes}" />
          </Border>
        </Grid>

        <!-- Step 3 · Assets -->
        <Grid Margin="24,8,24,16" Visibility="{Binding IsAssetsStep, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource ForgeSubtitle}" Text="Files to attach" />
              <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="Installers, archives or binaries people can download from the release. Tick the ones to upload."
                         TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="Releases.AddFilesButton" Command="{Binding AddFilesCommand}"
                       Content="Add files…" Icon="{ui:SymbolIcon Attach16}" />
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource ForgeSectionCardFlushStyle}">
            <Grid>
              <ListBox AutomationProperties.AutomationId="Releases.AssetList" AutomationProperties.Name="Files to attach" ItemsSource="{Binding Assets}"
                       PreviewKeyDown="OnAssetListKeyDown" SelectionMode="Single" Style="{StaticResource ForgeDenseListBoxStyle}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
                    <Setter Property="MinHeight" Value="44" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ReleaseAssetFileViewModel}">
                    <Grid Background="Transparent" ToolTip="{Binding Path}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Command="{Binding PlacementTarget.Tag.RemoveAssetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                    Header="Remove from the release" InputGestureText="Del">
                            <MenuItem.Icon>
                              <ui:SymbolIcon Symbol="Delete16" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <Grid.Tag>
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                      </Grid.Tag>
                      <CheckBox MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Attach {0}}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ForgeMono}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Directory}" />
                      </StackPanel>
                      <controls:Pill Grid.Column="2" Margin="12,0" Kind="Info" Text="Suggested" ToolTip="Found in a build output folder"
                                     Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding SizeText}" />
                      <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}"
                                 Visibility="{Binding Modified, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource RelativeTime}">
                            <Binding Path="Modified" />
                            <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <ui:Button Grid.Column="5" Margin="8,0,0,0" AutomationProperties.Name="Remove from the release"
                                 Command="{Binding DataContext.RemoveAssetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                 Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource ReleasesIconButtonStyle}" ToolTip="Remove from the release (Del)" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:EmptyState Icon="Attach16" Title="No files to attach" Description="ForgeDesk found no recent build output. Add files, or publish the release without any."
                                   ActionText="Add files…" ActionCommand="{Binding AddFilesCommand}"
                                   Visibility="{Binding HasAssets, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="Releases.AssetsError" Foreground="{DynamicResource ForgeDangerBrush}"
                       Style="{StaticResource ForgeBody}" Text="{Binding AssetsError}" TextWrapping="Wrap"
                       Visibility="{Binding AssetsError, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="Releases.AssetsSummary" Style="{StaticResource ForgeBodySecondary}"
                       Text="{Binding AssetsSummary}" />
          </Grid>
        </Grid>

        <!-- Step 4 · Review -->
        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}">
          <StackPanel MaxWidth="920" Margin="24,8,24,24" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource ForgeSubtitle}" Text="Review" />
            <Border Margin="0,0,0,12" AutomationProperties.AutomationId="Releases.ReviewSummary" Style="{StaticResource ForgeSectionCardStyle}">
              <StackPanel>
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ReleasesFieldLabelStyle}" Text="Version" />
                  <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Version}" />
                  <Border Style="{StaticResource ReleaseTagPillStyle}">
                    <TextBlock Text="{Binding TagName}" />
                  </Border>
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ReleasesFieldLabelStyle}" Text="Title" />
                  <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding ReleaseTitle}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ReleasesFieldLabelStyle}" Text="Tagged commit" />
                  <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding ReviewTarget}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ReleasesFieldLabelStyle}" Text="Visibility" />
                  <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding ReviewKind}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ReleasesFieldLabelStyle}" Text="Files" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding AssetsSummary}" />
                    <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding ReviewAssets}" TextTrimming="None" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <ui:InfoBar Margin="0,0,0,12" IsClosable="False" IsOpen="{Binding HasWarnings}" Message="{Binding WarningsText}" Severity="Warning"
                        Title="Check before publishing" />
            <TextBlock Style="{StaticResource ReleasesGroupTitleStyle}" Text="NOTES" />
            <Border Padding="20,16" Style="{StaticResource ForgeSectionCardStyle}">
              <github:MarkdownViewer EmptyText="No release notes." LinkCommand="{Binding OpenLinkCommand}" Markdown="{Binding Notes}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Publishing: timeline, then result -->
        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsPublishStep, Converter={StaticResource BoolToVisibility}}">
          <StackPanel MaxWidth="760" Margin="24,8,24,24" HorizontalAlignment="Left">
            <!-- Success -->
            <Border Margin="0,0,0,16" AutomationProperties.AutomationId="Releases.SuccessCard" Style="{StaticResource ForgeSectionCardStyle}"
                    Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource ForgeSuccessSubtleBrush}" CornerRadius="24">
                  <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource ForgeSuccessBrush}" Symbol="CheckmarkCircle24" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding SuccessTitle}" TextTrimming="None" TextWrapping="Wrap" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding SuccessDescription}" TextWrapping="Wrap" />
                  <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" AutomationProperties.AutomationId="Releases.ViewOnGitHubButton" Command="{Binding ViewOnGitHubCommand}"
                               Content="View on GitHub" Icon="{ui:SymbolIcon Open16}" />
                    <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Releases.CopyLinkButton" Command="{Binding CopyLinkCommand}" Content="Copy link"
                               Icon="{ui:SymbolIcon Link16}" />
                    <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Releases.DoneButton" Command="{Binding CloseCommand}" Content="Done" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Failure -->
            <Border Margin="0,0,0,16" AutomationProperties.AutomationId="Releases.FailureCard" Style="{StaticResource ForgeSectionCardStyle}"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource ForgeDangerSubtleBrush}" CornerRadius="24">
                  <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource ForgeDangerBrush}" Symbol="DismissCircle24" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource ForgeTitle}" Text="The release didn't complete" />
                  <TextBlock Margin="0,4,0,0" AutomationProperties.AutomationId="Releases.FailureMessage" Style="{StaticResource ForgeBody}" Text="{Binding FailureMessage}"
                             TextTrimming="None" TextWrapping="Wrap" />
                  <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" AutomationProperties.AutomationId="Releases.RetryButton" Command="{Binding RetryCommand}" Content="Retry"
                               Icon="{ui:SymbolIcon ArrowClockwise16}" ToolTip="Run the same release again: finished steps are reused" />
                    <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Releases.EditReleaseButton" Command="{Binding EditReleaseCommand}" Content="Edit release"
                               Icon="{ui:SymbolIcon Edit16}" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding CloseCommand}" Content="Close" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource ReleasesGroupTitleStyle}" Text="PROGRESS" />
            <Border Padding="8" Style="{StaticResource ForgeSectionCardStyle}">
              <ItemsControl AutomationProperties.AutomationId="Releases.Timeline" AutomationProperties.Name="Release steps" Focusable="False" ItemsSource="{Binding Timeline}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ReleaseTimelineStepViewModel}">
                    <Grid Margin="8,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                        <ui:SymbolIcon x:Name="StateIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"
                                       Foreground="{Binding StateTone, Converter={StaticResource ReleasesToneToBrush}}"
                                       Symbol="{Binding StateIcon, Converter={StaticResource SymbolFromName}}" />
                        <ui:ProgressRing x:Name="Spinner" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" />
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StepTitle" Style="{StaticResource ForgeBody}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Detail}" TextTrimming="None" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding StateText}" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter TargetName="StateIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                        <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ===== Footer ===== -->
    <Border Grid.Row="3" Padding="24,12" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button AutomationProperties.AutomationId="Releases.CancelButton" Command="{Binding CancelCommand}" Content="{Binding CancelText}"
                   ToolTip="Close the wizard (Esc); while publishing, stop after the current step">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPublishStep}" Value="True" />
                    <Condition Binding="{Binding IsExecuting}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibility}}">
          <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="Publishing… keep ForgeDesk open until it's done." />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsFormStep, Converter={StaticResource BoolToVisibility}}">
          <ui:Button Margin="0,0,8,0" AutomationProperties.AutomationId="Releases.BackButton" Command="{Binding BackCommand}" Content="Back" Icon="{ui:SymbolIcon ArrowLeft16}"
                     Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVisibility}}" />
          <ui:Button MinWidth="120" Appearance="Primary" AutomationProperties.AutomationId="Releases.NextButton" Command="{Binding NextCommand}" Content="{Binding NextText}"
                     IsDefault="False" ToolTip="{Binding NextHint}" ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
