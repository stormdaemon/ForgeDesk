<UserControl x:Class="ForgeDesk.App.Features.Activity.ActivitySectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:activity="clr-namespace:ForgeDesk.App.Features.Activity"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Activity;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ActivitySectionViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700"
             AutomationProperties.AutomationId="Activity.Section"
             Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,20,24,12">
      <TextBlock AutomationProperties.AutomationId="Activity.Title" Style="{StaticResource ForgeTitle}" Text="Activity" />
      <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeBodySecondary}"
                 Text="What happened in this project through ForgeDesk: commits, syncs, runs, releases, tasks and GitHub actions." TextWrapping="Wrap" />
    </StackPanel>

    <activity:ActivityTimelineView Grid.Row="1" DataContext="{Binding Timeline}" />
  </Grid>
</UserControl>
