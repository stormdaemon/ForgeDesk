<!--
  Activity feature: the project Activity tab and the global Activity page, both showing the shared
  timeline view. Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Activity"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Activity;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Overview/OverviewStyles.xaml" />
    <ResourceDictionary Source="/ForgeDesk;component/Features/Activity/ActivityStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:ActivitySectionViewModel}">
    <views:ActivitySectionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GlobalActivityViewModel}">
    <views:GlobalActivityView />
  </DataTemplate>
</ResourceDictionary>
