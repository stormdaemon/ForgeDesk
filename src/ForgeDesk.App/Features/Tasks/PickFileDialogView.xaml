<UserControl x:Class="ForgeDesk.App.Features.Tasks.PickFileDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Tasks;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PickFileDialogViewModel}"
             d:DesignWidth="560" d:DesignHeight="560"
             AutomationProperties.AutomationId="Tasks.PickFileDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding TaskKey, StringFormat=Find a file of the project to link to {0}.}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Margin="0,12,0,8">
          <ui:TextBox x:Name="SearchBox" AutomationProperties.AutomationId="Tasks.PickFileSearch" AutomationProperties.Name="Search files" ClearButtonEnabled="True"
                      Icon="{ui:SymbolIcon Search16}" PlaceholderText="Type part of a file name or path" PreviewKeyDown="OnSearchKeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Summary}" />
        </StackPanel>
        <Grid Grid.Row="3">
          <ListBox x:Name="FileList" AutomationProperties.AutomationId="Tasks.PickFileList" AutomationProperties.Name="Files" ItemsSource="{Binding Files}"
                   MouseDoubleClick="OnFileDoubleClick" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" Style="{StaticResource ForgeDenseListBoxStyle}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FileChoice}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding RelativePath}">
                  <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Document16" />
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBody}" Text="{Binding Name}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding Folder}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ui:ProgressRing Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Margin="0,8,0,0" VerticalAlignment="Top" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeBody}" Text="{Binding LoadError}"
                     TextWrapping="Wrap" Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}"
                   Text="{Binding ValidationMessage}" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="Tasks.PickFileConfirm"
                   Command="{Binding ConfirmCommand}" Content="Link file" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
