<!--
  Tasks feature: the Tasks tab of the project workspace (TasksSectionViewModel), the task details
  pane and the Tasks dialogs (link a commit, link a file, uncommitted changes). Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tasks="clr-namespace:ForgeDesk.App.Features.Tasks"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Tasks;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Tasks/TasksStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:TasksSectionViewModel}">
    <tasks:TasksSectionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TaskDetailViewModel}">
    <tasks:TaskDetailView />
  </DataTemplate>

  <!-- Dialogs (hosted by the shared DialogWindow) -->
  <DataTemplate DataType="{x:Type vm:PickCommitDialogViewModel}">
    <tasks:PickCommitDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:PickFileDialogViewModel}">
    <tasks:PickFileDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DirtyTreeDialogViewModel}">
    <tasks:DirtyTreeDialogView />
  </DataTemplate>
</ResourceDictionary>
