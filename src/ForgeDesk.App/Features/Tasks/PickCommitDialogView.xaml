<UserControl x:Class="ForgeDesk.App.Features.Tasks.PickCommitDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Tasks;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PickCommitDialogViewModel}"
             d:DesignWidth="560" d:DesignHeight="560"
             AutomationProperties.AutomationId="Tasks.PickCommitDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Explanation}" TextWrapping="Wrap" />
        <ui:TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,12,0,8" AutomationProperties.AutomationId="Tasks.PickCommitSearch"
                    AutomationProperties.Name="Filter commits" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}"
                    PlaceholderText="Filter by message, author or SHA" PreviewKeyDown="OnSearchKeyDown"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <ListBox x:Name="CommitList" Grid.Row="3" AutomationProperties.AutomationId="Tasks.PickCommitList" AutomationProperties.Name="Commits"
                 ItemsSource="{Binding Commits}" MouseDoubleClick="OnCommitDoubleClick" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                 Style="{StaticResource ForgeDenseListBoxStyle}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CommitChoice}">
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Width="64" VerticalAlignment="Top" Foreground="{DynamicResource ForgeInfoBrush}" Style="{StaticResource ForgeMono}" Text="{Binding ShortSha}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Subject}" />
                  <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeCaptionSecondary}">
                    <Run Text="{Binding Author, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run>
                      <Run.Text>
                        <MultiBinding Converter="{StaticResource RelativeTime}" Mode="OneWay">
                          <Binding Path="When" />
                          <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                        </MultiBinding>
                      </Run.Text>
                    </Run>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}"
                   Text="{Binding ValidationMessage}" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="Tasks.PickCommitConfirm"
                   Command="{Binding ConfirmCommand}" Content="Link commit" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
