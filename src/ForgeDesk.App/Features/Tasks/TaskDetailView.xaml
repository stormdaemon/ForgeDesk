<UserControl x:Class="ForgeDesk.App.Features.Tasks.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:tasks="clr-namespace:ForgeDesk.App.Features.Tasks"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Tasks;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TaskDetailViewModel}"
             d:DesignHeight="900" d:DesignWidth="420"
             x:Name="Root"
             AutomationProperties.AutomationId="Tasks.Detail"
             Focusable="False">
  <UserControl.InputBindings>
    <KeyBinding Command="{Binding CloseCommand}" Key="Escape" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <ContextMenu x:Key="LinkMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Command="{Binding LinkCurrentBranchCommand}" Header="{Binding LinkCurrentBranchText}">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="BranchFork16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding LinkCommitCommand}" Header="Link commit…" IsEnabled="{Binding IsGitRepository}">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Record16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding LinkFileCommand}" Header="Link file…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Document16" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Command="{Binding LinkIssueCommand}" Header="Link issue…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Bug16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding LinkPullRequestCommand}" Header="Link pull request…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="BranchRequest16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding LinkUrlCommand}" Header="Link web page…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Link16" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="MoreMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Command="{Binding CopyKeyCommand}" Header="Copy key and title">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Copy16" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Command="{Binding DeleteCommand}" Header="Delete task…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Delete16" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <Border Padding="20,12,12,12" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding Key}" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <ui:ProgressRing Width="12" Height="12" Margin="0,0,6,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock AutomationProperties.AutomationId="Tasks.SaveState" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding SaveState}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:DropDownButton AutomationProperties.AutomationId="Tasks.MoreButton" AutomationProperties.Name="More actions" Flyout="{StaticResource MoreMenu}"
                             Icon="{ui:SymbolIcon MoreHorizontal16}" ToolTip="More actions" />
          <ui:Button Margin="4,0,0,0" AutomationProperties.AutomationId="Tasks.CloseDetailButton" AutomationProperties.Name="Close the details"
                     Command="{Binding CloseCommand}" Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Close (Esc)" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="20,16,20,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Title -->
        <TextBox AutomationProperties.AutomationId="Tasks.TitleBox" AutomationProperties.Name="Title" Style="{StaticResource TasksTitleBoxStyle}"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding TitleError}"
                   Visibility="{Binding TitleError, Converter={StaticResource NullToCollapsed}}" />

        <!-- Actions -->
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
          <ui:Button Appearance="Primary" AutomationProperties.AutomationId="Tasks.StartWorkingButton" Command="{Binding StartWorkingCommand}"
                     Content="Start working" Icon="{ui:SymbolIcon BranchFork16}"
                     ToolTip="Create or switch to this task's branch, link it and move the task to In progress" />
          <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Tasks.CompleteButton" Command="{Binding CompleteCommand}" Content="Complete"
                     Icon="{ui:SymbolIcon CheckmarkCircle16}" ToolTip="Move the task to Done" />
        </StackPanel>

        <!-- Properties -->
        <Border Margin="0,16,0,0" Style="{StaticResource ForgeSectionCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource TasksFieldLabelStyle}" Text="Status" />
            <ComboBox Grid.Column="1" AutomationProperties.AutomationId="Tasks.StatusBox" AutomationProperties.Name="Status" DisplayMemberPath="Name"
                      ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding Status, Mode=TwoWay}" SelectedValuePath="Status" />

            <TextBlock Grid.Row="2" Style="{StaticResource TasksFieldLabelStyle}" Text="Priority" />
            <ComboBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="Tasks.PriorityBox" AutomationProperties.Name="Priority"
                      ItemsSource="{Binding PriorityOptions}" SelectedValue="{Binding Priority, Mode=TwoWay}" SelectedValuePath="Priority">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TaskPriorityOption}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding Tone, Converter={StaticResource TasksToneBrush}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="4" Style="{StaticResource TasksFieldLabelStyle}" Text="Due" />
            <Grid Grid.Row="4" Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <DatePicker AutomationProperties.AutomationId="Tasks.DueDatePicker" AutomationProperties.Name="Due date"
                          SelectedDate="{Binding DueDate, Mode=TwoWay}" />
              <ui:Button Grid.Column="1" Margin="4,0,0,0" AutomationProperties.Name="Remove the due date" Command="{Binding ClearDueDateCommand}"
                         Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Remove the due date"
                         Visibility="{Binding DueDate, Converter={StaticResource NullToCollapsed}}" />
            </Grid>

            <TextBlock Grid.Row="6" Margin="0,6,0,0" VerticalAlignment="Top" Style="{StaticResource TasksFieldLabelStyle}" Text="Labels" />
            <StackPanel Grid.Row="6" Grid.Column="1">
              <ItemsControl Focusable="False" ItemsSource="{Binding Labels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Height="24" Margin="0,0,6,6" Padding="8,0,2,0" Background="{DynamicResource ForgeInfoSubtleBrush}" CornerRadius="12">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForgeInfoBrush}" Text="{Binding}" />
                        <ui:Button Width="20" Height="20" MinWidth="20" MinHeight="20" Margin="2,0,0,0" AutomationProperties.Name="Remove label"
                                   Command="{Binding DataContext.RemoveLabelCommand, ElementName=Root}" CommandParameter="{Binding}" FontSize="10"
                                   Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Remove this label" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:TextBox AutomationProperties.AutomationId="Tasks.NewLabelBox" AutomationProperties.Name="Add a label" ClearButtonEnabled="False"
                          Icon="{ui:SymbolIcon Tag16}" PlaceholderText="Add a label, then Enter" Text="{Binding NewLabelText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding AddLabelCommand}" />
                </ui:TextBox.InputBindings>
              </ui:TextBox>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Description -->
        <Grid Margin="0,20,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TasksSectionTitleStyle}" Text="Description" />
          <ToggleButton Grid.Column="1" AutomationProperties.AutomationId="Tasks.PreviewToggle" IsChecked="{Binding IsPreview, Mode=TwoWay}"
                        ToolTip="Show the description rendered as Markdown">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Eye16" />
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="Preview" />
            </StackPanel>
          </ToggleButton>
        </Grid>
        <TextBox MinHeight="120" MaxHeight="420" Padding="10,8" VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="True"
                 AutomationProperties.AutomationId="Tasks.DescriptionBox" AutomationProperties.Name="Description" SpellCheck.IsEnabled="True"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding IsPreview, Converter={StaticResource InverseBoolToVisibility}}" />
        <Border MinHeight="60" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <RichTextBox AutomationProperties.AutomationId="Tasks.DescriptionPreview" Style="{StaticResource TasksMarkdownPreviewStyle}"
                         tasks:MarkdownView.Markdown="{Binding PreviewMarkdown}" />
            <TextBlock Style="{StaticResource ForgeBodySecondary}" Text="No description yet. Turn off Preview to write one (Markdown works)."
                       TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
        </Border>
        <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="Markdown supported · saved automatically" />

        <!-- Links -->
        <Grid Margin="0,20,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource TasksSectionTitleStyle}" Text="Links" />
          <ui:DropDownButton Grid.Column="1" AutomationProperties.AutomationId="Tasks.AddLinkButton" Content="Link" Flyout="{StaticResource LinkMenu}"
                             Icon="{ui:SymbolIcon Link16}" ToolTip="Link a branch, commit, file, issue, pull request or web page" />
        </Grid>
        <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Secondary"
                   AutomationProperties.AutomationId="Tasks.LinkCurrentBranchButton" Command="{Binding LinkCurrentBranchCommand}"
                   Content="{Binding LinkCurrentBranchText}" Icon="{ui:SymbolIcon BranchFork16}"
                   Visibility="{Binding CanLinkCurrentBranch, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl AutomationProperties.AutomationId="Tasks.Links" Focusable="False" ItemsSource="{Binding Links}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TaskLinkViewModel}">
              <Grid Margin="0,0,0,4" Background="Transparent" AutomationProperties.AutomationId="{Binding AutomationId}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding PlacementTarget.Tag.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" Header="Open" IsEnabled="{Binding CanOpen}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Open16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" Header="Copy">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Copy16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding PlacementTarget.Tag.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" Header="Remove link">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Dismiss16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Grid.ContextMenu>
                <Grid.Tag>
                  <Binding Path="DataContext" ElementName="Root" />
                </Grid.Tag>

                <Border Width="28" Height="28" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                  <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                  <Button Command="{Binding DataContext.OpenLinkCommand, ElementName=Root}" CommandParameter="{Binding}" Content="{Binding Text}"
                          IsEnabled="{Binding CanOpen}" Style="{StaticResource TasksLinkButtonStyle}" ToolTip="{Binding ToolTip}"
                          ToolTipService.ShowOnDisabled="True" />
                  <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Detail}" />
                </StackPanel>
                <ui:Button Grid.Column="2" AutomationProperties.Name="Remove link" Command="{Binding DataContext.RemoveLinkCommand, ElementName=Root}"
                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss16}" Style="{StaticResource TasksSmallIconButtonStyle}" ToolTip="Remove this link" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="Nothing linked yet: connect the branch, commits, files or issues this task is about."
                   TextWrapping="Wrap" Visibility="{Binding HasLinks, Converter={StaticResource InverseBoolToVisibility}}" />

        <!-- History -->
        <TextBlock Margin="0,24,0,10" Style="{StaticResource TasksSectionTitleStyle}" Text="History" />
        <ui:ProgressRing Width="16" Height="16" HorizontalAlignment="Left" IsIndeterminate="True"
                         Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl AutomationProperties.AutomationId="Tasks.History" Focusable="False" ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TaskEventViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="1" Margin="0,22,0,0" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Border Width="20" Height="20" VerticalAlignment="Top" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
                  <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,1,0,12">
                  <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Summary}" TextTrimming="None" TextWrapping="Wrap" />
                  <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeCaptionSecondary}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource RelativeTime}">
                        <Binding Path="At" />
                        <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Timestamps -->
        <TextBlock Margin="0,8,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding CreatedText}" />
        <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding UpdatedText}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
