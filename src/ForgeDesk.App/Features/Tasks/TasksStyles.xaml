<!--
  Styles of the Tasks tab: board columns, cards (priority bar, labels, link counts, due date,
  current-branch highlight), the list view's header and rows, and the details pane.
  Merged by TasksTemplates.xaml. Brushes are DynamicResource so both themes work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell"
                    xmlns:tasks="clr-namespace:ForgeDesk.App.Features.Tasks">

  <shell:StatusToneToKindConverter x:Key="TasksToneToKind" />
  <shell:InverseBooleanConverter x:Key="TasksInverseBoolean" />
  <shell:StatusToneToBrushConverter x:Key="TasksToneBrush" />
  <tasks:TaskSortGlyphConverter x:Key="TasksSortGlyph" />

  <!-- ===== Board ======================================================================== -->

  <!-- Surface of a column. -->
  <Style x:Key="TasksColumnStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Colored glyph of a column header. -->
  <Style x:Key="TasksColumnGlyphStyle" TargetType="Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource ForgeNeutralBrush}" />
    <Setter Property="Fill" Value="Transparent" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Todo">
        <Setter Property="Stroke" Value="{DynamicResource ForgeInfoBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="InProgress">
        <Setter Property="Stroke" Value="{DynamicResource ForgeAccentBrush}" />
        <Setter Property="Fill" Value="{DynamicResource ForgeAccentSubtleBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Review">
        <Setter Property="Stroke" Value="{DynamicResource ForgeWarningBrush}" />
        <Setter Property="Fill" Value="{DynamicResource ForgeWarningSubtleBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Done">
        <Setter Property="Stroke" Value="{DynamicResource ForgeSuccessBrush}" />
        <Setter Property="Fill" Value="{DynamicResource ForgeSuccessBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Card container: no list chrome (the card draws its own), keyboard focus ring kept. -->
  <Style x:Key="TasksCardContainerStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A card: surface, hover, open (accent) and current-branch (accent outline) states. -->
  <Style x:Key="TasksCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding IsOnCurrentBranch}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsOpen}" Value="True">
        <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Priority bar on the left edge of a card. -->
  <Style x:Key="TasksPriorityBarStyle" TargetType="Border">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Margin" Value="0,8,0,8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Priority}" Value="Urgent">
        <Setter Property="Background" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Priority}" Value="High">
        <Setter Property="Background" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Priority}" Value="Medium">
        <Setter Property="Background" Value="{DynamicResource ForgeInfoBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Priority}" Value="Low">
        <Setter Property="Background" Value="{DynamicResource ForgeNeutralBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Priority glyph (flag) of a card or row. -->
  <Style x:Key="TasksPriorityIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Symbol" Value="Flag16" />
    <Setter Property="Filled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeNeutralBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Priority}" Value="Urgent">
        <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Priority}" Value="High">
        <Setter Property="Foreground" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Priority}" Value="Medium">
        <Setter Property="Foreground" Value="{DynamicResource ForgeInfoBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasPriority}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Label chip. -->
  <Style x:Key="TasksLabelChipStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,0,6,1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="0,4,4,0" />
    <Setter Property="Background" Value="{DynamicResource ForgeInfoSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeInfoBrush}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>

  <!-- A link count on a card footer ("⑂ 1"). -->
  <Style x:Key="TasksFooterIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="TasksFooterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Due date: red when overdue. -->
  <Style x:Key="TasksDueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsOverdue}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="TasksDueIconStyle" TargetType="ui:SymbolIcon" BasedOn="{StaticResource TasksFooterIconStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsOverdue}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Board / List segmented toggle. -->
  <Style x:Key="TasksSegmentButtonStyle" TargetType="RadioButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== List view ==================================================================== -->

  <!-- Sortable column header. -->
  <Style x:Key="TasksHeaderButtonStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Padding="6,0" Background="Transparent" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Details pane ================================================================= -->

  <!-- Label of a property row ("Status", "Priority"). -->
  <Style x:Key="TasksFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Section title in the details pane ("Description", "Links"). -->
  <Style x:Key="TasksSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeBodyStrong}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Editable title: looks like a heading until focused. -->
  <Style x:Key="TasksTitleBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Clickable link text in the details pane. -->
  <Style x:Key="TasksLinkButtonStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeInfoBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Text" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter TargetName="Text" Property="TextDecorations" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small square icon button (remove label, remove link). -->
  <Style x:Key="TasksSmallIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ForgeIconButtonStyle}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Read-only Markdown preview. -->
  <Style x:Key="TasksMarkdownPreviewStyle" TargetType="RichTextBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsDocumentEnabled" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ForgeAccentBrush}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RichTextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
