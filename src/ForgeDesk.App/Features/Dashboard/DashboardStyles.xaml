<!--
  Styles of the dashboard: filter chips, project cards and rows, layout toggle, hero actions.
  Merged by DashboardTemplates.xaml. Brushes are DynamicResource so light and dark themes both work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell"
                    xmlns:dashboard="clr-namespace:ForgeDesk.App.Features.Dashboard">

  <shell:StatusToneToKindConverter x:Key="DashboardStatusToneToKind" />
  <shell:StatusToneToVisibilityConverter x:Key="DashboardStatusToneToVisibility" />
  <dashboard:MiddleEllipsisConverter x:Key="DashboardMiddleEllipsis" />

  <!-- Rounded keyboard focus ring. -->
  <Style x:Key="DashboardFocusVisualStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True" StrokeThickness="2"
                     Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Filter chips ============================================================== -->

  <Style x:Key="DashboardChipListStyle" TargetType="ListBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashboardChipItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisualStyle}" />
    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Layout toggle (grid | list) ================================================ -->

  <Style x:Key="DashboardLayoutToggleStyle" TargetType="RadioButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Surface" Background="Transparent" CornerRadius="3" Margin="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashboardSegmentGroupStyle" TargetType="Border">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ===== Projects ================================================================== -->

  <!-- Card container (grid layout): 340 × 232, 12 px gaps. -->
  <Style x:Key="DashboardCardItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Width" Value="340" />
    <Setter Property="Height" Value="232" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisualStyle}" />
    <Setter Property="AutomationProperties.AutomationId" Value="Dashboard.ProjectCard" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Card" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsFolderMissing}" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForgeWarningBrush}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Row container (list layout): dense row with the accent pill when selected. -->
  <Style x:Key="DashboardRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="AutomationProperties.AutomationId" Value="Dashboard.ProjectRow" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
  </Style>

  <!-- Group header ("Work  4") shown when sorting by name or recency. -->
  <DataTemplate x:Key="DashboardGroupHeaderTemplate">
    <StackPanel Margin="4,8,0,10" Orientation="Horizontal">
      <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Folder16" />
      <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeSubtitle}" Text="{Binding Name}" />
      <Border Margin="8,0,0,0" Style="{StaticResource ForgeCountBadgeStyle}">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ItemCount}" />
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- An attention reason on a card: dot + message, opens the right tab. -->
  <Style x:Key="DashboardAttentionButtonStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Padding="4,2" Background="Transparent" CornerRadius="4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small icon in the metadata lines of cards and rows. -->
  <Style x:Key="DashboardMetaIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- ===== Welcome hero ================================================================ -->

  <Style x:Key="DashboardHeroActionStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="264" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Round tinted tile behind the icon of a hero action. -->
  <Style x:Key="DashboardHeroIconTileStyle" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
  </Style>
</ResourceDictionary>
