<!--
  Dashboard feature: the home page (projects as cards or rows, welcome hero). Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Dashboard"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Dashboard;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Dashboard/DashboardStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <views:DashboardView />
  </DataTemplate>
</ResourceDictionary>
