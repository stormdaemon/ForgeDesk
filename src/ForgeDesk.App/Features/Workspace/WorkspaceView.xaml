<UserControl x:Class="ForgeDesk.App.Features.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:workspace="clr-namespace:ForgeDesk.App.Features.Workspace"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Workspace;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectWorkspaceViewModel}"
             x:Name="Root"
             Focusable="False">
  <UserControl.Resources>
    <!-- A tab: icon, label, and a counter or a status dot. -->
    <DataTemplate x:Key="TabTemplate" DataType="{x:Type vm:WorkspaceTabViewModel}">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                       Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
        <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   Text="{Binding Title}" />
        <Border Style="{StaticResource WorkspaceTabBadgeStyle}" Visibility="{Binding HasBadgeText, Converter={StaticResource BoolToVisibility}}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding BadgeText}" />
        </Border>
        <controls:StatusDot Margin="8,0,0,0" Status="{Binding BadgeKind, Converter={StaticResource StatusToneToKind}}"
                            Visibility="{Binding HasBadgeDot, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <ContextMenu x:Key="OpenInMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Command="{Binding OpenFolderCommand}" Header="File Explorer">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="FolderOpen16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding OpenInEditorCommand}" Header="{Binding EditorName}"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Code16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding OpenTerminalCommand}" Header="Terminal">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="WindowConsole20" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding OpenGitHubCommand}" Header="GitHub" Visibility="{Binding HasGitHub, Converter={StaticResource BoolToVisibility}}">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Globe16" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Command="{Binding CopyPathCommand}" Header="Copy path">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Copy16" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Header: identity, branch, sync, open in ===== -->
    <Grid Grid.Row="0" Margin="24,18,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <controls:ProjectAvatar VerticalAlignment="Center" Color="{Binding AvatarColor}" ProjectName="{Binding Name}" Size="40" />

      <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeTitle}" Text="{Binding Name}" />
          <ui:Button Width="28" Height="28" Margin="6,0,0,0" Command="{Binding OpenGitHubCommand}" Icon="{ui:SymbolIcon Globe16}"
                     Style="{StaticResource ForgeIconButtonStyle}" ToolTip="{Binding GitHub.FullName, StringFormat=Open {0} on GitHub}"
                     Visibility="{Binding HasGitHub, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Button Margin="0,2,0,0" Command="{Binding OpenFolderCommand}" Content="{Binding Path}" Style="{StaticResource WorkspacePathLinkStyle}"
                ToolTip="Open in File Explorer" />
      </StackPanel>

      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <!-- Branch -->
        <workspace:BranchSelector DataContext="{Binding Branches}"
                                  Visibility="{Binding DataContext.IsGitRepository, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

        <!-- Fetch | Pull | Push -->
        <Border Margin="8,0,0,0" Style="{StaticResource WorkspaceSegmentGroupStyle}" DataContext="{Binding Sync}"
                Visibility="{Binding DataContext.IsGitRepository, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding FetchCommand}" Style="{StaticResource WorkspaceSegmentButtonStyle}" ToolTip="Fetch from the remote">
              <StackPanel Orientation="Horizontal">
                <!-- Spins for explicit and automatic fetches alike. -->
                <Grid Width="16" VerticalAlignment="Center">
                  <Grid>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFetching}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsAutoFetching}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <ui:SymbolIcon FontSize="16" Symbol="ArrowSync16" />
                  </Grid>
                  <Grid>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFetching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsAutoFetching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
                  </Grid>
                </Grid>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Fetch" />
              </StackPanel>
            </Button>

            <Rectangle Style="{StaticResource WorkspaceSegmentDividerStyle}" />

            <Button Command="{Binding PullCommand}" Style="{StaticResource WorkspaceSegmentButtonStyle}" ToolTip="{Binding PullToolTip}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" VerticalAlignment="Center">
                  <ui:SymbolIcon FontSize="16" Symbol="ArrowDown16" Visibility="{Binding IsPulling, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Visibility="{Binding IsPulling, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Pull" />
                <Border Style="{StaticResource WorkspaceSyncCountStyle}" Visibility="{Binding Behind, Converter={StaticResource ZeroToCollapsed}}">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Behind}" />
                </Border>
              </StackPanel>
            </Button>

            <Rectangle Style="{StaticResource WorkspaceSegmentDividerStyle}" />

            <Button Command="{Binding PushCommand}" Style="{StaticResource WorkspaceSegmentButtonStyle}" ToolTip="{Binding PushToolTip}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" VerticalAlignment="Center">
                  <ui:SymbolIcon FontSize="16" Symbol="ArrowUp16" Visibility="{Binding IsPushing, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Visibility="{Binding IsPushing, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Push" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsPublish}" Value="True">
                          <Setter Property="Text" Value="Publish" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource WorkspaceSyncCountStyle}" Visibility="{Binding Ahead, Converter={StaticResource ZeroToCollapsed}}">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Ahead}" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Open in… -->
        <ui:DropDownButton Height="32" Margin="8,0,0,0" Content="Open in" Flyout="{StaticResource OpenInMenu}" Icon="{ui:SymbolIcon Open16}"
                           ToolTip="Open the project folder in another app" />
      </StackPanel>
    </Grid>

    <!-- ===== Banners ===== -->
    <StackPanel Grid.Row="1" Margin="24,0,20,0">
      <ui:InfoBar Margin="0,0,0,10" IsClosable="False" IsOpen="{Binding IsFolderMissing}" Severity="Warning" Title="Folder not found"
                  Message="{Binding MissingFolderMessage}">
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
          <ui:Button Appearance="Primary" Command="{Binding LocateFolderCommand}" Content="Locate folder…" Icon="{ui:SymbolIcon FolderSearch16}" />
          <ui:Button Margin="8,0,0,0" Command="{Binding RemoveProjectCommand}" Content="Remove from ForgeDesk" />
        </StackPanel>
      </ui:InfoBar>

      <ui:InfoBar Margin="0,0,0,10" IsClosable="False" IsOpen="{Binding HasGitError}" Message="{Binding GitError.Message}" Severity="Error"
                  Title="{Binding GitError.Title}">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Margin="0,0,0,8" Style="{StaticResource ForgeBodySecondary}" Text="{Binding GitError.Hint}" TextWrapping="Wrap"
                     Visibility="{Binding GitError.Hint, Converter={StaticResource NullToCollapsed}}" />
          <ui:Button HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="Retry" Icon="{ui:SymbolIcon ArrowClockwise16}" />
        </StackPanel>
      </ui:InfoBar>
    </StackPanel>

    <!-- ===== Tab strip + quick commands ===== -->
    <Grid Grid.Row="2" Margin="12,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Rectangle Grid.ColumnSpan="2" VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />

      <ListBox AutomationProperties.Name="Project sections" ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}"
               ItemTemplate="{StaticResource TabTemplate}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
               Style="{StaticResource ForgeWorkspaceTabStripStyle}"
               Visibility="{Binding HasAvailableSections, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl Grid.Column="1" Margin="12,0,0,6" VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding QuickCommands}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:QuickCommandViewModel}">
            <ui:Button Height="28" Margin="6,0,0,0" Padding="10,0" Appearance="Secondary"
                       Command="{Binding DataContext.RunQuickCommandCommand, ElementName=Root}" CommandParameter="{Binding}"
                       Icon="{Binding Icon, Converter={x:Static workspace:SymbolIconFactory.Converter}}"
                       IsEnabled="{Binding IsStarting, Converter={StaticResource InverseBoolean}}" ToolTip="{Binding ToolTip}">
              <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Label}" />
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- ===== Sections: one live view per opened tab, only the current one visible ===== -->
    <Grid Grid.Row="3">
      <ItemsControl Focusable="False" ItemsSource="{Binding OpenedTabs}"
                    Visibility="{Binding SectionError, Converter={StaticResource NullToVisible}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:WorkspaceTabViewModel}">
            <ContentPresenter Content="{Binding ViewModel}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <controls:ErrorPanel Margin="24" Error="{Binding SectionError}" RetryCommand="{Binding RetrySectionCommand}" />
    </Grid>
  </Grid>
</UserControl>
