<UserControl x:Class="ForgeDesk.App.Features.GitHub.GitHubSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitHubSectionViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000"
             AutomationProperties.AutomationId="GitHub.Section"
             Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Sub-navigation and repository ===== -->
    <Grid Grid.Row="0" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="24,12,16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox HorizontalAlignment="Left" AutomationProperties.AutomationId="GitHub.SubNavigation" AutomationProperties.Name="GitHub views"
                 ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Style="{StaticResource GitHubSegmentedListStyle}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource GitHubSegmentItemStyle}">
              <Setter Property="ToolTip" Value="{Binding ToolTip}" />
              <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GitHubSubViewTab}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                               Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
                <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ui:Button Grid.Column="2" AutomationProperties.AutomationId="GitHub.OpenRepositoryButton" Command="{Binding OpenRepositoryOnGitHubCommand}"
                   Content="{Binding RepositoryName}" Icon="{ui:SymbolIcon Open16}" Style="{StaticResource ForgeToolbarButtonStyle}"
                   ToolTip="Open the repository on GitHub" />
      </Grid>
      <Rectangle VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />
    </Grid>

    <!-- ===== Views: one live view per opened entry, only the current one visible ===== -->
    <ItemsControl Grid.Row="1" Focusable="False" ItemsSource="{Binding OpenedTabs}"
                  Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:GitHubSubViewTab}">
          <ContentPresenter Content="{Binding ViewModel}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== Preconditions ===== -->
    <controls:EmptyState Grid.Row="1" AutomationProperties.AutomationId="GitHub.NotLinkedState" Icon="LinkSquare24"
                         Title="This project isn't linked to a GitHub repository" Description="{Binding NotLinkedDescription}"
                         ActionText="Re-detect" ActionCommand="{Binding RedetectCommand}"
                         Visibility="{Binding IsNotLinked, Converter={StaticResource BoolToVisibility}}" />

    <controls:EmptyState Grid.Row="1" AutomationProperties.AutomationId="GitHub.SignedOutState" Icon="PersonCircle24" Title="Sign in to GitHub"
                         Description="{Binding SignedOutDescription}" ActionText="Sign in to GitHub" ActionCommand="{Binding SignInCommand}"
                         SecondaryActionText="Open on GitHub" SecondaryActionCommand="{Binding OpenRepositoryOnGitHubCommand}"
                         Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}" />

    <controls:EmptyState Grid.Row="1" AutomationProperties.AutomationId="GitHub.DisabledState" Icon="PlugDisconnected24" Title="GitHub features are off"
                         Description="{Binding DisabledDescription}" ActionText="Turn GitHub features on" ActionCommand="{Binding EnableGitHubCommand}"
                         Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
