<UserControl x:Class="ForgeDesk.App.Features.GitHub.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IssuesViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             x:Name="Root"
             AutomationProperties.AutomationId="GitHub.IssuesView"
             Focusable="False">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- An issue: state, title and labels, then number, author and update time; comments on the right. -->
    <DataTemplate x:Key="IssueRowTemplate" DataType="{x:Type vm:IssueRowViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding OpenOnGitHubCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Open on GitHub" InputGestureText="Enter">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Open16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CreateTaskCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Create task from issue">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="TaskListSquareAdd20" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy link">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Link16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <ui:SymbolIcon Grid.RowSpan="2" Margin="0,2,12,0" VerticalAlignment="Top" FontSize="18" Foreground="{Binding StateTone, Converter={StaticResource GitHubToneToBrush}}"
                       Symbol="{Binding StateIcon, Converter={StaticResource SymbolFromName}}" ToolTip="{Binding StateText}" />

        <Grid Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Title}" />
          <ItemsControl Grid.Column="1" Margin="8,0,0,0" Focusable="False" ItemTemplate="{StaticResource GitHubLabelTemplate}" ItemsPanel="{StaticResource GitHubLabelsPanel}"
                        ItemsSource="{Binding Labels}" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding NumberText}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Author, StringFormat=opened by {0}}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RelativeTime}" StringFormat="updated {0}">
                <Binding Path="UpdatedAt" />
                <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.RowSpan="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="Comments"
                    Visibility="{Binding Comments, Converter={StaticResource ZeroToCollapsed}}">
          <ui:SymbolIcon Margin="0,0,3,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Comment16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Comments}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- An entry of the thread: the description or a comment, as a card with rendered Markdown. -->
    <DataTemplate x:Key="ThreadEntryTemplate" DataType="{x:Type vm:IssueCommentViewModel}">
      <Border Margin="20,0,20,12" Padding="0" Style="{StaticResource ForgeSectionCardStyle}">
        <StackPanel>
          <Border Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
            <StackPanel Orientation="Horizontal">
              <controls:ProjectAvatar Margin="0,0,8,0" VerticalAlignment="Center" ProjectName="{Binding Author}" Size="20" />
              <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Author}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Action}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource RelativeTime}">
                    <Binding Path="CreatedAt" />
                    <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Border>
          <github:MarkdownViewer Margin="12,10,12,12" BaseUrl="{Binding HtmlUrl}" EmptyText="No description provided."
                                 LinkCommand="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType={x:Type github:IssuesView}}}"
                                 Markdown="{Binding Body}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Toolbar ===== -->
    <Grid Margin="24,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListBox AutomationProperties.AutomationId="GitHub.IssueFilter" AutomationProperties.Name="Issue state" ItemsSource="{Binding FilterOptions}"
               SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Style="{StaticResource GitHubFilterListStyle}" />
      <ui:TextBox Grid.Column="1" MaxWidth="320" Margin="12,0,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="GitHub.IssueSearch"
                  AutomationProperties.Name="Search issues" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}" PlaceholderText="Search by title, author, label or #"
                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button Appearance="Primary" AutomationProperties.AutomationId="GitHub.NewIssueButton" Command="{Binding NewIssueCommand}" Content="New issue…"
                   Icon="{ui:SymbolIcon Add16}" IsEnabled="{Binding IsCreating, Converter={StaticResource GitHubInverseBoolean}}" ToolTip="Report a bug or suggest an idea" />
      </StackPanel>
    </Grid>

    <!-- ===== List · detail ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="List" Margin="8,0,8,4" AutomationProperties.AutomationId="GitHub.IssueList" AutomationProperties.Name="Issues"
                 ItemContainerStyle="{StaticResource GitHubTwoLineRowStyle}" ItemTemplate="{StaticResource IssueRowTemplate}" ItemsSource="{Binding Items}"
                 MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single"
                 Style="{StaticResource ForgeDenseListBoxStyle}" />
        <TextBlock Grid.Row="1" Margin="24,0,24,8" Style="{StaticResource ForgeCaptionSecondary}" Text="Showing the 100 most recent. Search on GitHub for older ones."
                   Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />

        <controls:SkeletonList Grid.RowSpan="2" IsActive="{Binding IsLoading}" RowCount="8" RowHeight="52" ShowIcons="True"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorPanel Grid.RowSpan="2" Margin="24" AutomationProperties.AutomationId="GitHub.IssuesError" Error="{Binding Error}" RetryCommand="{Binding ReloadCommand}" />
        <controls:EmptyState Grid.RowSpan="2" AutomationProperties.AutomationId="GitHub.NoIssuesState" Icon="Record20" Title="{Binding EmptyTitle}"
                             Description="{Binding EmptyDescription}" ActionText="New issue…" ActionCommand="{Binding NewIssueCommand}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        <controls:EmptyState Grid.RowSpan="2" Icon="Search24" Title="No issue matches" Description="Check the spelling, or clear the search to see every issue."
                             ActionText="Clear search" ActionCommand="{Binding ClearSearchCommand}"
                             Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <GridSplitter Grid.Column="1" Style="{StaticResource ForgeGridSplitterStyle}" />

      <!-- ===== Detail ===== -->
      <Border Grid.Column="2" AutomationProperties.AutomationId="GitHub.IssueDetail" Style="{StaticResource GitHubDetailPaneStyle}">
        <Grid>
          <controls:EmptyState Icon="Record20" Title="Select an issue" Description="Its description and conversation appear here, with a box to reply."
                               Visibility="{Binding IsDetailOpen, Converter={StaticResource InverseBoolToVisibility}}" />

          <Grid DataContext="{Binding Detail}" Visibility="{Binding DataContext.IsDetailOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="20,16,12,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:Pill VerticalAlignment="Center" Kind="{Binding StateTone, Converter={StaticResource GitHubToneToKind}}" Text="{Binding StateText}" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding NumberText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <ui:Button AutomationProperties.AutomationId="GitHub.OpenIssueButton" AutomationProperties.Name="Open on GitHub"
                             Command="{Binding DataContext.OpenOnGitHubCommand, ElementName=Root}" Icon="{ui:SymbolIcon Open16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Open on GitHub (Enter)" />
                  <ui:Button AutomationProperties.AutomationId="GitHub.CopyIssueLinkButton" AutomationProperties.Name="Copy link"
                             Command="{Binding DataContext.CopyLinkCommand, ElementName=Root}" Icon="{ui:SymbolIcon Link16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Copy link" />
                  <ui:Button AutomationProperties.AutomationId="GitHub.CloseIssueDetailButton" AutomationProperties.Name="Close details"
                             Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}" Icon="{ui:SymbolIcon Dismiss16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Close (Esc)" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,10,0,0" Style="{StaticResource ForgeTitle}" Text="{Binding Title}" TextTrimming="None" TextWrapping="Wrap" />

              <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Author}" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RelativeTime}" StringFormat="opened this issue {0}">
                      <Binding Path="CreatedAt" />
                      <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding AssigneesText, StringFormat=· {0}}" />
              </WrapPanel>

              <ItemsControl Margin="0,8,0,0" Focusable="False" ItemTemplate="{StaticResource GitHubLabelTemplate}" ItemsPanel="{StaticResource GitHubWrapLabelsPanel}"
                            ItemsSource="{Binding Labels}" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}" />

              <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <ui:Button AutomationProperties.AutomationId="GitHub.CreateTaskButton" Command="{Binding DataContext.CreateTaskCommand, ElementName=Root}"
                           Content="Create task" Icon="{ui:SymbolIcon TaskListSquareAdd20}" IsEnabled="{Binding IsCreatingTask, Converter={StaticResource GitHubInverseBoolean}}"
                           ToolTip="Add a task to this project's board, linked to the issue" />
                <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="GitHub.ToggleIssueStateButton" Command="{Binding DataContext.ToggleStateCommand, ElementName=Root}"
                           Content="{Binding ToggleStateText}" IsEnabled="{Binding IsChangingState, Converter={StaticResource GitHubInverseBoolean}}">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Icon" Value="{ui:SymbolIcon CheckmarkCircle16}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="False">
                          <Setter Property="Icon" Value="{ui:SymbolIcon ArrowCounterclockwise16}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
                <ui:ProgressRing Width="16" Height="16" Margin="10,0,0,0" IsIndeterminate="True">
                  <ui:ProgressRing.Style>
                    <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreatingTask}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChangingState}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:ProgressRing.Style>
                </ui:ProgressRing>
              </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Row="1" Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                         Visibility="{Binding IsLoadingComments, Converter={StaticResource BoolToVisibility}}" />
            <Grid Grid.Row="1" Margin="20,4,20,8">
              <TextBlock Style="{StaticResource GitHubGroupTitleStyle}" Text="{Binding CommentsText, Converter={StaticResource UpperCase}}" />
            </Grid>
            <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />

            <!-- Thread (description + comments), virtualized -->
            <Grid Grid.Row="2">
              <ItemsControl Padding="0,12,0,0" AutomationProperties.AutomationId="GitHub.IssueThread" AutomationProperties.Name="Conversation"
                            ItemTemplate="{StaticResource ThreadEntryTemplate}" ItemsSource="{Binding Thread}" Style="{StaticResource GitHubVirtualizedItemsStyle}" />
              <controls:ErrorPanel Margin="20" VerticalAlignment="Bottom" Error="{Binding CommentsError}"
                                   RetryCommand="{Binding DataContext.RetryCommentsCommand, ElementName=Root}" />
            </Grid>

            <!-- Reply -->
            <Border Grid.Row="3" Padding="20,12,20,16" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBox x:Name="CommentBox" MinHeight="64" MaxHeight="200" VerticalContentAlignment="Top" AcceptsReturn="True"
                            AutomationProperties.AutomationId="GitHub.CommentBox" AutomationProperties.Name="Comment" ClearButtonEnabled="False"
                            IsEnabled="{Binding IsPostingComment, Converter={StaticResource GitHubInverseBoolean}}" PlaceholderText="Leave a comment (Markdown supported)"
                            PreviewKeyDown="OnCommentKeyDown" SpellCheck.IsEnabled="True" Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:KeyHint VerticalAlignment="Center" Keys="Ctrl+Enter" ToolTip="Send the comment" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True"
                                     Visibility="{Binding IsPostingComment, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Primary" AutomationProperties.AutomationId="GitHub.AddCommentButton" Command="{Binding DataContext.AddCommentCommand, ElementName=Root}"
                               Content="Comment" Icon="{ui:SymbolIcon Send16}" IsEnabled="{Binding IsPostingComment, Converter={StaticResource GitHubInverseBoolean}}"
                               ToolTip="Post the comment (Ctrl+Enter)" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
