<UserControl x:Class="ForgeDesk.App.Features.GitHub.PullRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PullRequestsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             x:Name="Root"
             AutomationProperties.AutomationId="GitHub.PullRequestsView"
             Focusable="False">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A pull request: author, title and labels, then number, branches, author and update time; state, checks and comments on the right. -->
    <DataTemplate x:Key="PullRequestRowTemplate" DataType="{x:Type vm:PullRequestRowViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding OpenOnGitHubCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Open on GitHub" InputGestureText="Enter">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Open16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CheckoutBranchCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Check out branch">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="BranchFork16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy link">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Link16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <controls:ProjectAvatar Grid.RowSpan="2" Margin="0,2,12,0" VerticalAlignment="Top" ProjectName="{Binding Author}" Size="28" ToolTip="{Binding Author}" />

        <Grid Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Title}" />
          <ItemsControl Grid.Column="1" Margin="8,0,0,0" Focusable="False" ItemTemplate="{StaticResource GitHubLabelTemplate}" ItemsPanel="{StaticResource GitHubLabelsPanel}"
                        ItemsSource="{Binding Labels}" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding NumberText}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding HeadBranch}" />
          <ui:SymbolIcon Margin="4,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowRight16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding BaseBranch}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Author, StringFormat=by {0}}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RelativeTime}">
                <Binding Path="UpdatedAt" />
                <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.RowSpan="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <controls:CiBadge Margin="0,0,10,0" ShowLabel="False" State="{Binding Checks}" Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Margin="0,0,10,0" Orientation="Horizontal" ToolTip="Comments" Visibility="{Binding Comments, Converter={StaticResource ZeroToCollapsed}}">
            <ui:SymbolIcon Margin="0,0,3,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Comment16" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Comments}" />
          </StackPanel>
          <controls:Pill Kind="{Binding StateTone, Converter={StaticResource GitHubToneToKind}}" Text="{Binding StateText}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Toolbar ===== -->
    <Grid Margin="24,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListBox AutomationProperties.AutomationId="GitHub.PullRequestFilter" AutomationProperties.Name="Pull request state" ItemsSource="{Binding FilterOptions}"
               SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Style="{StaticResource GitHubFilterListStyle}" />
      <ui:TextBox Grid.Column="1" MaxWidth="320" Margin="12,0,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="GitHub.PullRequestSearch"
                  AutomationProperties.Name="Search pull requests" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}"
                  PlaceholderText="Search by title, author, branch or #" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button Appearance="Primary" AutomationProperties.AutomationId="GitHub.NewPullRequestButton" Command="{Binding NewPullRequestCommand}"
                   Content="New pull request…" Icon="{ui:SymbolIcon Add16}" IsEnabled="{Binding IsCreating, Converter={StaticResource GitHubInverseBoolean}}"
                   ToolTip="Propose the changes of a branch" />
      </StackPanel>
    </Grid>

    <!-- ===== List · detail ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="List" Margin="8,0,8,4" AutomationProperties.AutomationId="GitHub.PullRequestList" AutomationProperties.Name="Pull requests"
                 ItemContainerStyle="{StaticResource GitHubTwoLineRowStyle}" ItemTemplate="{StaticResource PullRequestRowTemplate}" ItemsSource="{Binding Items}"
                 MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single"
                 Style="{StaticResource ForgeDenseListBoxStyle}" />
        <TextBlock Grid.Row="1" Margin="24,0,24,8" Style="{StaticResource ForgeCaptionSecondary}" Text="Showing the 100 most recent. Search on GitHub for older ones."
                   Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />

        <controls:SkeletonList Grid.RowSpan="2" IsActive="{Binding IsLoading}" RowCount="8" RowHeight="52" ShowIcons="True"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorPanel Grid.RowSpan="2" Margin="24" AutomationProperties.AutomationId="GitHub.PullRequestsError" Error="{Binding Error}"
                             RetryCommand="{Binding ReloadCommand}" />
        <controls:EmptyState Grid.RowSpan="2" AutomationProperties.AutomationId="GitHub.NoPullRequestsState" Icon="BranchRequest20" Title="{Binding EmptyTitle}"
                             Description="{Binding EmptyDescription}" ActionText="New pull request…" ActionCommand="{Binding NewPullRequestCommand}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        <controls:EmptyState Grid.RowSpan="2" Icon="Search24" Title="No pull request matches" Description="Check the spelling, or clear the search to see every pull request."
                             ActionText="Clear search" ActionCommand="{Binding ClearSearchCommand}"
                             Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <GridSplitter Grid.Column="1" Style="{StaticResource ForgeGridSplitterStyle}" />

      <!-- ===== Detail ===== -->
      <Border Grid.Column="2" AutomationProperties.AutomationId="GitHub.PullRequestDetail" Style="{StaticResource GitHubDetailPaneStyle}">
        <Grid>
          <controls:EmptyState Icon="BranchRequest20" Title="Select a pull request" Description="Its description, branches, checks and reviewers appear here."
                               Visibility="{Binding IsDetailOpen, Converter={StaticResource InverseBoolToVisibility}}" />

          <Grid DataContext="{Binding Detail}" Visibility="{Binding DataContext.IsDetailOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="20,16,12,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:Pill VerticalAlignment="Center" Kind="{Binding StateTone, Converter={StaticResource GitHubToneToKind}}" Text="{Binding StateText}" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding NumberText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <ui:Button AutomationProperties.AutomationId="GitHub.OpenPullRequestButton" AutomationProperties.Name="Open on GitHub"
                             Command="{Binding DataContext.OpenOnGitHubCommand, ElementName=Root}" Icon="{ui:SymbolIcon Open16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Open on GitHub (Enter)" />
                  <ui:Button AutomationProperties.AutomationId="GitHub.CopyPullRequestLinkButton" AutomationProperties.Name="Copy link"
                             Command="{Binding DataContext.CopyLinkCommand, ElementName=Root}" Icon="{ui:SymbolIcon Link16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Copy link" />
                  <ui:Button AutomationProperties.AutomationId="GitHub.ClosePullRequestDetailButton" AutomationProperties.Name="Close details"
                             Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}" Icon="{ui:SymbolIcon Dismiss16}"
                             Style="{StaticResource GitHubSmallIconButtonStyle}" ToolTip="Close (Esc)" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,10,0,0" Style="{StaticResource ForgeTitle}" Text="{Binding Title}" TextTrimming="None" TextWrapping="Wrap" />

              <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                <controls:ProjectAvatar Margin="0,0,6,0" VerticalAlignment="Center" ProjectName="{Binding Author}" Size="20" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Author}" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="wants to merge" />
                <Border Margin="0,0,6,0" Style="{StaticResource GitHubBranchPillStyle}">
                  <TextBlock Text="{Binding HeadBranch}" />
                </Border>
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="into" />
                <Border Style="{StaticResource GitHubBranchPillStyle}">
                  <TextBlock Text="{Binding BaseBranch}" />
                </Border>
              </WrapPanel>

              <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <ui:Button AutomationProperties.AutomationId="GitHub.CheckoutBranchButton" Command="{Binding DataContext.CheckoutBranchCommand, ElementName=Root}"
                           Content="Check out branch" Icon="{ui:SymbolIcon BranchFork16}"
                           IsEnabled="{Binding DataContext.IsCheckingOut, ElementName=Root, Converter={StaticResource GitHubInverseBoolean}}"
                           ToolTip="Fetch, then switch to this pull request's branch" />
                <ui:ProgressRing Width="16" Height="16" Margin="10,0,0,0" IsIndeterminate="True"
                                 Visibility="{Binding DataContext.IsCheckingOut, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Row="1" Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                         Visibility="{Binding DataContext.IsDetailLoading, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />

            <ScrollViewer Grid.Row="2" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="20,16,20,20">
                <controls:ErrorPanel Margin="0,0,0,12" Error="{Binding DataContext.DetailError, ElementName=Root}"
                                     RetryCommand="{Binding DataContext.RetryDetailCommand, ElementName=Root}" />

                <!-- Facts -->
                <Border Margin="0,0,0,16" Style="{StaticResource ForgeSectionCardStyle}">
                  <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Changes" />
                      <TextBlock Foreground="{DynamicResource ForgeSuccessBrush}" Style="{StaticResource ForgeMono}" Text="{Binding AdditionsText}" />
                      <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeMono}" Text="{Binding DeletionsText}" />
                      <TextBlock Margin="6,0,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding FilesText, StringFormat=· {0}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Mergeable" />
                      <controls:StatusDot Margin="0,0,6,0" VerticalAlignment="Center" Status="{Binding MergeableTone, Converter={StaticResource GitHubToneToKind}}" />
                      <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding MergeableText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal" Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Checks" />
                      <controls:CiBadge State="{Binding Checks}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Reviewers" />
                      <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding ReviewersText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Labels" />
                      <ItemsControl Focusable="False" ItemTemplate="{StaticResource GitHubLabelTemplate}" ItemsPanel="{StaticResource GitHubWrapLabelsPanel}"
                                    ItemsSource="{Binding Labels}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource GitHubFieldLabelStyle}" Text="Updated" />
                      <TextBlock Style="{StaticResource ForgeBody}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource RelativeTime}">
                            <Binding Path="UpdatedAt" />
                            <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Description -->
                <TextBlock Margin="0,0,0,8" Style="{StaticResource GitHubGroupTitleStyle}" Text="DESCRIPTION" />
                <github:MarkdownViewer AutomationProperties.AutomationId="GitHub.PullRequestBody" BaseUrl="{Binding HtmlUrl}" EmptyText="No description provided."
                                       LinkCommand="{Binding DataContext.OpenLinkCommand, ElementName=Root}" Markdown="{Binding Body}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
