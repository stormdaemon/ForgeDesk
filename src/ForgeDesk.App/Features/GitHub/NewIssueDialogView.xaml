<UserControl x:Class="ForgeDesk.App.Features.GitHub.NewIssueDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewIssueDialogViewModel}"
             d:DesignWidth="640"
             AutomationProperties.AutomationId="GitHub.NewIssueDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
          <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Globe16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding RepositoryName}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,6" Style="{StaticResource ForgeCaption}" Text="Title" />
        <ui:TextBox x:Name="TitleBox" AutomationProperties.AutomationId="GitHub.NewIssueTitle" AutomationProperties.Name="Issue title" ClearButtonEnabled="False"
                    PlaceholderText="Short summary of the bug or idea" Text="{Binding IssueTitle, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />

        <Grid Margin="0,12,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="Description (Markdown)" />
          <CheckBox Grid.Column="1" MinWidth="0" Padding="6,0,0,0" AutomationProperties.AutomationId="GitHub.NewIssuePreviewToggle" Content="Preview"
                    IsChecked="{Binding ShowPreview}" />
        </Grid>
        <Grid Height="220">
          <ui:TextBox VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="True" AutomationProperties.AutomationId="GitHub.NewIssueBody"
                      AutomationProperties.Name="Issue description" ClearButtonEnabled="False" PlaceholderText="Steps to reproduce, what you expected, what happened…"
                      SpellCheck.IsEnabled="True" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowPreview, Converter={StaticResource InverseBoolToVisibility}}" />
          <Border Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
            <github:MarkdownViewer EmptyText="Nothing to preview yet." IsScrollable="True" Markdown="{Binding Body}" />
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="GitHub.NewIssueConfirmButton"
                   Command="{Binding ConfirmCommand}" Content="Create issue" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
