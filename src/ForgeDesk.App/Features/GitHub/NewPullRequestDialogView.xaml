<UserControl x:Class="ForgeDesk.App.Features.GitHub.NewPullRequestDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewPullRequestDialogViewModel}"
             d:DesignWidth="640"
             AutomationProperties.AutomationId="GitHub.NewPullRequestDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
          <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Globe16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding RepositoryName}" />
        </StackPanel>

        <!-- Branches -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Branch with your changes" />
            <ComboBox AutomationProperties.AutomationId="GitHub.NewPullRequestHead" AutomationProperties.Name="Branch with your changes" FontFamily="{DynamicResource ForgeMonoFont}"
                      IsEditable="True" ItemsSource="{Binding HeadBranches}" Text="{Binding Head, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="1" Margin="12,22,12,0" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Symbol="ArrowRight16" />
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Merge into" />
            <ComboBox AutomationProperties.AutomationId="GitHub.NewPullRequestBase" AutomationProperties.Name="Branch to merge into" FontFamily="{DynamicResource ForgeMonoFont}"
                      IsEditable="True" ItemsSource="{Binding BaseBranches}" Text="{Binding Base, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Summary}" />

        <TextBlock Margin="0,16,0,6" Style="{StaticResource ForgeCaption}" Text="Title" />
        <ui:TextBox x:Name="TitleBox" AutomationProperties.AutomationId="GitHub.NewPullRequestTitle" AutomationProperties.Name="Pull request title" ClearButtonEnabled="False"
                    PlaceholderText="What does this change do?" Text="{Binding PullRequestTitle, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />

        <Grid Margin="0,12,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="Description (Markdown)" />
          <CheckBox Grid.Column="1" MinWidth="0" Padding="6,0,0,0" AutomationProperties.AutomationId="GitHub.NewPullRequestPreviewToggle" Content="Preview"
                    IsChecked="{Binding ShowPreview}" />
        </Grid>
        <Grid Height="180">
          <ui:TextBox VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="True" AutomationProperties.AutomationId="GitHub.NewPullRequestBody"
                      AutomationProperties.Name="Pull request description" ClearButtonEnabled="False" PlaceholderText="Why this change, how to test it, what to look at…"
                      SpellCheck.IsEnabled="True" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowPreview, Converter={StaticResource InverseBoolToVisibility}}" />
          <Border Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                  Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
            <github:MarkdownViewer EmptyText="Nothing to preview yet." IsScrollable="True" Markdown="{Binding Body}" />
          </Border>
        </Grid>

        <CheckBox Margin="0,12,0,0" AutomationProperties.AutomationId="GitHub.NewPullRequestDraft" IsChecked="{Binding IsDraft}">
          <StackPanel>
            <TextBlock Style="{StaticResource ForgeBody}" Text="Create as draft" />
            <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="Reviewers aren't asked yet; mark it ready on GitHub when it is." TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="GitHub.NewPullRequestConfirmButton"
                   Command="{Binding ConfirmCommand}" Content="Create pull request" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
