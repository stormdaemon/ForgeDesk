<UserControl x:Class="ForgeDesk.App.Features.GitHub.GitHubOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:github="clr-namespace:ForgeDesk.App.Features.GitHub"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.GitHub;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitHubOverviewViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000"
             x:Name="Root"
             AutomationProperties.AutomationId="GitHub.OverviewView"
             Focusable="False">
  <UserControl.Resources>
    <!-- Latest run of a workflow in a CI card: click opens it in Actions. -->
    <DataTemplate x:Key="CiRunTemplate" DataType="{x:Type vm:WorkflowRunRowViewModel}">
      <Button Margin="-8,0,-8,2" AutomationProperties.Name="{Binding Name}" Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType={x:Type github:GitHubOverviewView}}}"
              CommandParameter="{Binding}" Style="{StaticResource GitHubCardButtonStyle}" ToolTip="{Binding ToolTip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="2*" MinWidth="120" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="88" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="{Binding StateTone, Converter={StaticResource GitHubToneToBrush}}"
                         Symbol="{Binding StateIcon, Converter={StaticResource SymbolFromName}}" />
          <TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Name}" />
          <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding CommitMessage}" />
          <TextBlock Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding ShortSha}" />
          <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding DurationText}" ToolTip="Duration" />
          <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RelativeTime}">
                <Binding Path="CreatedAt" />
                <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- CI health of one branch: big state, headline, then the latest run of each workflow. -->
    <DataTemplate x:Key="CiCardTemplate" DataType="{x:Type vm:CiCardViewModel}">
      <Border Margin="0,0,0,12" Style="{StaticResource ForgeSectionCardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top" Background="{Binding State, Converter={StaticResource StatusToBrush}, ConverterParameter=Subtle}"
                    CornerRadius="22">
              <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:CiBadge ShowLabel="False" State="{Binding State}" />
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource GitHubGroupTitleStyle}" Text="{Binding Title, Converter={StaticResource UpperCase}}" />
                <Border Margin="8,0,0,0" Style="{StaticResource GitHubBranchPillStyle}" Visibility="{Binding Branch, Converter={StaticResource NullToCollapsed}}">
                  <TextBlock Text="{Binding Branch}" />
                </Border>
              </StackPanel>
              <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeSubtitle}" Text="{Binding Headline}" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRuns, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Margin="0,0,0,8" Style="{StaticResource ForgeDividerStyle}" />
            <ItemsControl Focusable="False" ItemTemplate="{StaticResource CiRunTemplate}" ItemsSource="{Binding Runs}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibility}}">
      <StackPanel MaxWidth="1100" Margin="24,16,24,24">

        <!-- ===== Repository ===== -->
        <Border Margin="0,0,0,12" AutomationProperties.AutomationId="GitHub.RepositoryCard" Style="{StaticResource ForgeSectionCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" Margin="0,0,12,0" Background="{DynamicResource ForgeAccentSubtleBrush}" CornerRadius="8">
                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource ForgeAccentTextBrush}"
                               Symbol="Globe24" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button AutomationProperties.AutomationId="GitHub.RepositoryLink" AutomationProperties.Name="Open the repository on GitHub"
                        Command="{Binding OpenRepositoryCommand}" Style="{StaticResource GitHubLinkButtonStyle}" ToolTip="{Binding Repository.HtmlUrl}">
                  <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForgeInfoBrush}" Text="{Binding Repository.FullName}" />
                </Button>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                  <controls:Pill Margin="0,0,6,0" Kind="Neutral" Text="{Binding VisibilityText}" />
                  <controls:Pill Margin="0,0,6,0" Kind="Info" Text="Fork" Visibility="{Binding Repository.IsFork, Converter={StaticResource BoolToVisibility}}" />
                  <controls:Pill Margin="0,0,6,0" Kind="Warning" Text="Archived" Visibility="{Binding Repository.IsArchived, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Repository.Language}"
                             Visibility="{Binding Repository.Language, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
              </StackPanel>
              <ui:Button Grid.Column="2" VerticalAlignment="Top" AutomationProperties.AutomationId="GitHub.OpenOnGitHubButton" Command="{Binding OpenRepositoryCommand}"
                         Content="Open on GitHub" Icon="{ui:SymbolIcon Open16}" />
            </Grid>

            <TextBlock Margin="0,12,0,0" Text="{Binding Description}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ForgeBody}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasDescription}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                      <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Rectangle Margin="0,16,0,12" Style="{StaticResource ForgeDividerStyle}" />

            <WrapPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,24,4" Orientation="Horizontal" ToolTip="Default branch">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="BranchFork16" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeMono}" Text="{Binding Repository.DefaultBranch}" />
              </StackPanel>
              <StackPanel Margin="0,0,24,4" Orientation="Horizontal" ToolTip="Stars">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Star16" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBody}" Text="{Binding Repository.Stars, StringFormat={}{0:N0} stars}" />
              </StackPanel>
              <StackPanel Margin="0,0,24,4" Orientation="Horizontal" ToolTip="Forks">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="BranchFork16" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBody}" Text="{Binding Repository.Forks, StringFormat={}{0:N0} forks}" />
              </StackPanel>
              <StackPanel Margin="0,0,24,4" Orientation="Horizontal" ToolTip="Open issues and pull requests, as counted by GitHub">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Record16" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBody}" Text="{Binding Repository.OpenIssues, StringFormat={}{0:N0} open issues}" />
              </StackPanel>
              <StackPanel Margin="0,0,24,4" Orientation="Horizontal" ToolTip="Last push" Visibility="{Binding Repository.PushedAt, Converter={StaticResource NullToCollapsed}}">
                <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowUpload16" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBody}">
                  <Run Text="Pushed" />
                  <Run>
                    <Run.Text>
                      <MultiBinding Converter="{StaticResource RelativeTime}" Mode="OneWay">
                        <Binding Path="Repository.PushedAt" />
                        <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
                      </MultiBinding>
                    </Run.Text>
                  </Run>
                </TextBlock>
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ===== Counts ===== -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource ForgeSectionCardFlushStyle}">
            <Button Padding="16" AutomationProperties.AutomationId="GitHub.OpenPullRequestsCard" AutomationProperties.Name="Open pull requests"
                    Command="{Binding ShowPullRequestsCommand}" Style="{StaticResource GitHubCardButtonStyle}" ToolTip="Show the pull requests">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource ForgeDisplay}" Text="{Binding OpenPullRequestsText}" />
                  <TextBlock Style="{StaticResource ForgeBodySecondary}" Text="Open pull requests" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Top" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="BranchRequest20" />
              </Grid>
            </Button>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource ForgeSectionCardFlushStyle}">
            <Button Padding="16" AutomationProperties.AutomationId="GitHub.OpenIssuesCard" AutomationProperties.Name="Open issues"
                    Command="{Binding ShowIssuesCommand}" Style="{StaticResource GitHubCardButtonStyle}" ToolTip="Show the issues">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource ForgeDisplay}" Text="{Binding OpenIssuesText}" />
                  <TextBlock Style="{StaticResource ForgeBodySecondary}" Text="Open issues" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Top" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Record20" />
              </Grid>
            </Button>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource ForgeSectionCardFlushStyle}">
            <Button Padding="16" AutomationProperties.AutomationId="GitHub.ActionsCard" AutomationProperties.Name="Workflow runs"
                    Command="{Binding ShowActionsCommand}" Style="{StaticResource GitHubCardButtonStyle}" ToolTip="Show the GitHub Actions runs">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <controls:CiBadge Margin="0,9,0,8" HorizontalAlignment="Left" State="{Binding CurrentBranchCi.State, FallbackValue=Unknown}" />
                  <TextBlock Style="{StaticResource ForgeBodySecondary}" Text="Workflow runs" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Top" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Flow20" />
              </Grid>
            </Button>
          </Border>
        </Grid>

        <!-- ===== CI health ===== -->
        <TextBlock Margin="0,4,0,8" Style="{StaticResource ForgeSubtitle}" Text="CI health" />
        <ContentPresenter AutomationProperties.AutomationId="GitHub.CurrentBranchCi" Content="{Binding CurrentBranchCi}"
                          ContentTemplate="{StaticResource CiCardTemplate}" />
        <ContentPresenter AutomationProperties.AutomationId="GitHub.DefaultBranchCi" Content="{Binding DefaultBranchCi}"
                          ContentTemplate="{StaticResource CiCardTemplate}" Visibility="{Binding DefaultBranchCi, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding RateLimitText, Converter={StaticResource NullToCollapsed}}">
          <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Symbol="Timer16">
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRateLimitLow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ForgeWarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
          <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="GitHub.RateLimit" Style="{StaticResource ForgeCaptionSecondary}"
                     Text="{Binding RateLimitText}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <controls:LoadingState IsActive="{Binding IsLoading}" Message="Loading the repository…"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <controls:ErrorPanel Margin="24" AutomationProperties.AutomationId="GitHub.OverviewError" Error="{Binding Error}" RetryCommand="{Binding ReloadCommand}" />
  </Grid>
</UserControl>
