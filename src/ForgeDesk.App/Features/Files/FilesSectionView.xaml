<UserControl x:Class="ForgeDesk.App.Features.Files.FilesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Files;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilesSectionViewModel}"
             d:DesignHeight="720" d:DesignWidth="1200"
             x:Name="Root"
             AutomationProperties.AutomationId="Files.View"
             Focusable="False">
  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding OpenSearchCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A tree row: indent, chevron (or spinner), icon, name (+ folder in flat lists), git letter or folder dot. -->
    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:FileTreeNodeViewModel}">
      <Grid Background="Transparent" ToolTip="{Binding ToolTip}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
        <Grid.InputBindings>
          <MouseBinding Command="{Binding DataContext.ActivateNodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                        MouseAction="LeftDoubleClick" />
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem AutomationProperties.AutomationId="Files.OpenInEditorMenuItem" Command="{Binding OpenInEditorCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open in editor">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Code16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding OpenWithDefaultAppCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Open with default app">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Open16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding RevealInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Reveal in File Explorer">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="FolderOpen16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy path">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy relative path" />
            <Separator />
            <MenuItem AutomationProperties.AutomationId="Files.ShowChangesMenuItem" Command="{Binding ShowChangesCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Show changes in Git"
                      Visibility="{Binding IsGitRepository, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="BranchFork16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="Files.OpenTerminalHereMenuItem" Command="{Binding OpenTerminalHereCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open terminal here">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="WindowConsole20" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="Files.SearchInFolderMenuItem" Command="{Binding SearchInFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Search in folder…">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="DocumentSearch16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <!-- Indentation -->
        <Border Grid.Column="0" Width="{Binding Indent}" />

        <!-- Chevron (folders of the tree) or spinner while listing -->
        <Grid Grid.Column="1" Width="20" Margin="0,0,2,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlat}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Button AutomationProperties.Name="Expand or collapse" Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  CommandParameter="{Binding}" Style="{StaticResource FilesChevronButtonStyle}">
            <Button.Visibility>
              <MultiBinding Converter="{StaticResource FilesChevronVisibility}">
                <Binding Path="HasChevron" />
                <Binding Path="IsLoading" />
              </MultiBinding>
            </Button.Visibility>
            <ui:SymbolIcon FontSize="12">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="ChevronRight12" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter Property="Symbol" Value="ChevronDown12" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
          </Button>
          <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ui:SymbolIcon Grid.Column="2" Style="{StaticResource FilesRowIconStyle}" Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />

        <DockPanel Grid.Column="3" VerticalAlignment="Center" LastChildFill="True">
          <ui:SymbolIcon Margin="0,0,6,0" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource ForgeDangerBrush}"
                         Symbol="ErrorCircle16" ToolTip="{Binding LoadError}" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource FilesNameTextStyle}" Text="{Binding Name}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Directory}"
                     Visibility="{Binding HasDirectory, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Grid Grid.Column="4">
          <TextBlock Style="{StaticResource FilesGitLetterStyle}" Text="{Binding GitLetter}" Visibility="{Binding HasGitState, Converter={StaticResource BoolToVisibility}}" />
          <Ellipse Style="{StaticResource FilesFolderDotStyle}" Visibility="{Binding ContainsChanges, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="260" MaxWidth="720" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- ===== Left pane: tree or search ===== -->
    <Grid Grid.Column="0" AutomationProperties.AutomationId="Files.LeftPane">
      <!-- Tree mode -->
      <Grid Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title and tools -->
        <Grid Grid.Row="0" Margin="24,16,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FilesPaneTitleStyle}" Text="Explorer" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ToggleButton AutomationProperties.AutomationId="Files.OnlyChangedToggle" AutomationProperties.Name="Only changed files"
                          IsChecked="{Binding OnlyChangedFiles}" Style="{StaticResource FilesToggleIconStyle}"
                          Visibility="{Binding IsGitRepository, Converter={StaticResource BoolToVisibility}}">
              <ToggleButton.ToolTip>
                <ToolTip>
                  <StackPanel>
                    <TextBlock Style="{StaticResource ForgeBodyStrong}" Text="Only changed files" />
                    <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding ChangedFilesText}" />
                  </StackPanel>
                </ToolTip>
              </ToggleButton.ToolTip>
              <ui:SymbolIcon FontSize="16" Symbol="BranchFork16" />
            </ToggleButton>
            <ToggleButton AutomationProperties.AutomationId="Files.ShowHiddenToggle" AutomationProperties.Name="Show hidden files"
                          IsChecked="{Binding ShowHiddenFiles}" Style="{StaticResource FilesToggleIconStyle}" ToolTip="Show hidden files">
              <ui:SymbolIcon FontSize="16" Symbol="Eye16" />
            </ToggleButton>
            <ui:Button AutomationProperties.AutomationId="Files.SearchButton" AutomationProperties.Name="Search in files" Command="{Binding OpenSearchCommand}"
                       Icon="{ui:SymbolIcon DocumentSearch16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Search in files (Ctrl+Shift+F)" />
            <ui:Button AutomationProperties.AutomationId="Files.CollapseAllButton" AutomationProperties.Name="Collapse all folders" Command="{Binding CollapseAllCommand}"
                       Icon="{ui:SymbolIcon ArrowMinimize16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Collapse all folders" />
            <ui:Button AutomationProperties.AutomationId="Files.RefreshButton" AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}"
                       Icon="{ui:SymbolIcon ArrowClockwise16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Refresh (F5)" />
          </StackPanel>
        </Grid>

        <!-- Go to file -->
        <Grid Grid.Row="1" Margin="16,0,12,8">
          <ui:TextBox x:Name="GoToBox" AutomationProperties.AutomationId="Files.GoToFileBox" AutomationProperties.Name="Go to file"
                      ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}" PlaceholderText="Go to file…" PreviewKeyDown="OnGoToKeyDown"
                      Text="{Binding GoToText, UpdateSourceTrigger=PropertyChanged}" />
          <ui:ProgressRing Width="14" Height="14" Margin="0,0,36,0" HorizontalAlignment="Right" IsIndeterminate="True"
                           Visibility="{Binding IsGoToSearching, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Rows and their states -->
        <Grid Grid.Row="2">
          <controls:SkeletonList Margin="16,4,12,0" IsActive="{Binding IsLoadingTree}" RowCount="14" RowHeight="28" ShowIcons="True"
                                 Visibility="{Binding IsLoadingTree, Converter={StaticResource BoolToVisibility}}" />

          <controls:ErrorPanel Margin="16,4,12,0" Error="{Binding Error}" RetryCommand="{Binding RefreshCommand}" />

          <controls:EmptyState AutomationProperties.AutomationId="Files.TreeEmptyState" ActionCommand="{Binding EmptyActionCommand}" ActionText="{Binding EmptyActionText}"
                               Description="{Binding EmptyDescription}" Icon="{Binding EmptyIcon, Converter={StaticResource SymbolFromName}}" Title="{Binding EmptyTitle}"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

          <ListBox x:Name="Tree" Margin="12,0,4,8" AutomationProperties.AutomationId="Files.Tree" AutomationProperties.Name="Project files"
                   ItemContainerStyle="{StaticResource FilesTreeRowStyle}" ItemTemplate="{StaticResource FileRowTemplate}" ItemsSource="{Binding Rows}"
                   PreviewKeyDown="OnTreeKeyDown" SelectedItem="{Binding SelectedNode}" SelectionMode="Single" Style="{StaticResource ForgeDenseListBoxStyle}"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                   Visibility="{Binding ShowRows, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Grid>

      <!-- Search mode -->
      <ContentControl AutomationProperties.AutomationId="Files.SearchPanel" Content="{Binding Search}" Focusable="False"
                      Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <GridSplitter Grid.Column="1" Style="{StaticResource ForgeGridSplitterStyle}" />

    <!-- ===== Right pane: preview ===== -->
    <ContentControl Grid.Column="2" AutomationProperties.AutomationId="Files.Viewer" Content="{Binding Viewer}" Focusable="False" />
  </Grid>
</UserControl>
