<UserControl x:Class="ForgeDesk.App.Features.Files.FileViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:files="clr-namespace:ForgeDesk.App.Features.Files"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Files;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileViewerViewModel}"
             d:DesignHeight="720" d:DesignWidth="860"
             x:Name="Root"
             AutomationProperties.AutomationId="Files.Preview"
             Focusable="False">
  <UserControl.Resources>
    <!-- "More" menu of the header. -->
    <ContextMenu x:Key="MoreMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Command="{Binding OpenWithDefaultAppCommand}" Header="Open with default app">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Open16" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Command="{Binding CopyRelativePathCommand}" Header="Copy relative path">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Copy16" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Wrap long lines" IsCheckable="True" IsChecked="{Binding WordWrap}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Header: breadcrumb, name, facts, actions ===== -->
    <Grid Grid.Row="0" Margin="20,12,24,8" Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Breadcrumb -->
      <ItemsControl Grid.Row="0" AutomationProperties.AutomationId="Files.Breadcrumb" Focusable="False" ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
            <StackPanel Orientation="Horizontal">
              <Button AutomationProperties.Name="{Binding Name}"
                      Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=files:FilesSectionView}}"
                      CommandParameter="{Binding}" Content="{Binding Name}" Style="{StaticResource FilesBreadcrumbButtonStyle}"
                      ToolTip="Show in the tree" />
              <ui:SymbolIcon Margin="2,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Symbol="ChevronRight12" Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Name, git state and actions -->
      <Grid Grid.Row="1" Margin="4,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock AutomationProperties.AutomationId="Files.FileName" Style="{StaticResource ForgeTitle}" Text="{Binding Name}" />
          <controls:Pill Margin="12,2,0,0" Kind="{Binding GitTone, Converter={StaticResource FilesToneToKind}}" Text="{Binding GitStateText}"
                         Visibility="{Binding HasGitState, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
          <ui:Button AutomationProperties.AutomationId="Files.OpenInEditorButton" Command="{Binding OpenInEditorCommand}" Content="Open in editor"
                     Icon="{ui:SymbolIcon Code16}" ToolTip="Open in your code editor (at the highlighted line)" />
          <ui:Button Margin="4,0,0,0" AutomationProperties.AutomationId="Files.RevealButton" AutomationProperties.Name="Reveal in File Explorer"
                     Command="{Binding RevealCommand}" Icon="{ui:SymbolIcon FolderOpen16}" Style="{StaticResource ForgeIconButtonStyle}"
                     ToolTip="Reveal in File Explorer" />
          <ui:Button AutomationProperties.AutomationId="Files.CopyPathButton" AutomationProperties.Name="Copy path" Command="{Binding CopyPathCommand}"
                     Icon="{ui:SymbolIcon Copy16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Copy full path" />
          <ui:Button x:Name="MoreButton" AutomationProperties.AutomationId="Files.MoreButton" AutomationProperties.Name="More actions" Click="OnMoreClick"
                     Icon="{ui:SymbolIcon MoreHorizontal16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="More actions" />
        </StackPanel>
      </Grid>

      <!-- Facts -->
      <WrapPanel Grid.Row="2" Margin="4,8,0,0" Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource FilesMetaChipStyle}" Visibility="{Binding SizeText, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding SizeText}" />
        </Border>
        <Border Style="{StaticResource FilesMetaChipStyle}" Visibility="{Binding LineCountText, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding LineCountText}" />
        </Border>
        <Border Style="{StaticResource FilesMetaChipStyle}" ToolTip="Encoding" Visibility="{Binding EncodingText, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding EncodingText}" />
        </Border>
        <Border Style="{StaticResource FilesMetaChipStyle}" ToolTip="Line endings" Visibility="{Binding LineEndingsText, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding LineEndingsText}" />
        </Border>
        <Border Style="{StaticResource FilesMetaChipStyle}" ToolTip="{Binding ModifiedToolTip}" Visibility="{Binding ModifiedText, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding ModifiedText}" />
        </Border>
        <Border Style="{StaticResource FilesMetaChipStyle}" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Source, ElementName=Preview, Converter={StaticResource FilesImageDimensions}, FallbackValue='Image'}" />
        </Border>
      </WrapPanel>
    </Grid>

    <!-- ===== Truncation notice ===== -->
    <ui:InfoBar Grid.Row="1" Margin="24,0,24,12" AutomationProperties.AutomationId="Files.TruncatedBanner" IsClosable="False"
                IsOpen="{Binding IsTruncated, Mode=OneWay}" Message="{Binding TruncatedMessage}" Severity="Informational" Title="Large file"
                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
        <ui:Button Command="{Binding OpenInEditorCommand}" Content="Open in editor" Icon="{ui:SymbolIcon Code16}" />
        <ui:Button Margin="8,0,0,0" Command="{Binding OpenWithDefaultAppCommand}" Content="Open with default app" Icon="{ui:SymbolIcon Open16}" />
      </StackPanel>
    </ui:InfoBar>

    <!-- ===== Content ===== -->
    <Border Grid.Row="2" Margin="24,0,24,24" Style="{StaticResource ForgeSectionCardFlushStyle}" ClipToBounds="True">
      <Grid>
        <!-- Nothing selected -->
        <controls:EmptyState AutomationProperties.AutomationId="Files.NoSelectionState"
                             ActionCommand="{Binding DataContext.OpenSearchCommand, RelativeSource={RelativeSource AncestorType=files:FilesSectionView}}"
                             ActionText="Search in files"
                             Description="Pick a file in the tree to preview it, or press Ctrl+P to go to any file of the project."
                             Icon="DocumentSearch24" Title="Select a file"
                             Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibility}}" />

        <!-- Loading (cancellable) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
          <controls:LoadingState IsActive="{Binding IsLoading}" Message="Opening file…" />
          <ui:Button Margin="0,8,0,0" HorizontalAlignment="Center" AutomationProperties.AutomationId="Files.CancelLoadButton" Command="{Binding CancelLoadCommand}"
                     Content="Cancel" />
        </StackPanel>

        <!-- Read errors (locked, access denied, missing) -->
        <controls:ErrorPanel Margin="16" Error="{Binding Error}" RetryCommand="{Binding RetryCommand}" />

        <!-- Text -->
        <controls:CodeView AutomationProperties.AutomationId="Files.CodeView" FilePath="{Binding RelativePath}" ScrollToLine="{Binding ScrollToLine}"
                           Text="{Binding Text}" WordWrap="{Binding WordWrap}">
          <controls:CodeView.Style>
            <Style TargetType="controls:CodeView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsText}" Value="True" />
                    <Condition Binding="{Binding ShowContent}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </controls:CodeView.Style>
        </controls:CodeView>

        <!-- Image -->
        <Grid AutomationProperties.AutomationId="Files.ImagePreview">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsImage}" Value="True" />
                    <Condition Binding="{Binding ShowContent}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource FilesCheckerboardBrush}" CornerRadius="8,8,0,0" />
          <ScrollViewer Grid.Row="0" Focusable="False">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsImageFit}" Value="True">
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <Image x:Name="Preview" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding ImagePath, Converter={StaticResource FilesImageSource}}">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Stretch" Value="None" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImageFit}" Value="True">
                      <Setter Property="Stretch" Value="Uniform" />
                      <Setter Property="StretchDirection" Value="DownOnly" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
          </ScrollViewer>
          <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}"
                     Text="This image could not be decoded. Open it with its default app to view it."
                     Visibility="{Binding Source, ElementName=Preview, Converter={StaticResource NullToVisible}}" />

          <!-- Zoom bar -->
          <Border Grid.Row="1" Padding="12,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="Zoom" />
              <ToggleButton AutomationProperties.AutomationId="Files.ZoomToggle" AutomationProperties.Name="Fit to pane" IsChecked="{Binding IsImageFit}"
                            Style="{StaticResource FilesToggleIconStyle}" ToolTip="Fit to pane / actual size (100%)">
                <ui:SymbolIcon FontSize="16" Symbol="ZoomFit16" />
              </ToggleButton>
              <TextBlock MinWidth="36" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="{Binding ZoomText}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Binary -->
        <controls:EmptyState AutomationProperties.AutomationId="Files.BinaryState" ActionCommand="{Binding OpenWithDefaultAppCommand}" ActionText="Open with default app"
                             Description="ForgeDesk does not preview this kind of file. Open it with the app Windows associates with it."
                             Icon="DocumentDismiss24" SecondaryActionCommand="{Binding RevealCommand}" SecondaryActionText="Reveal in File Explorer"
                             Title="Binary file">
          <controls:EmptyState.Style>
            <Style TargetType="controls:EmptyState">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBinary}" Value="True" />
                    <Condition Binding="{Binding ShowContent}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </controls:EmptyState.Style>
        </controls:EmptyState>

        <!-- Folder -->
        <controls:EmptyState AutomationProperties.AutomationId="Files.FolderState"
                             ActionCommand="{Binding DataContext.OpenTerminalHereCommand, RelativeSource={RelativeSource AncestorType=files:FilesSectionView}}"
                             ActionText="Open terminal here" Description="{Binding FolderSummary}" Icon="FolderOpen24"
                             SecondaryActionCommand="{Binding DataContext.SearchInFolderCommand, RelativeSource={RelativeSource AncestorType=files:FilesSectionView}}"
                             SecondaryActionText="Search in folder" Title="{Binding Name}">
          <controls:EmptyState.Style>
            <Style TargetType="controls:EmptyState">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFolder}" Value="True" />
                    <Condition Binding="{Binding ShowContent}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </controls:EmptyState.Style>
        </controls:EmptyState>
      </Grid>
    </Border>
  </Grid>
</UserControl>
