<!--
  Overview feature: the default tab of a project (the project at a glance). Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Overview"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Overview;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Overview/OverviewStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
    <views:OverviewView />
  </DataTemplate>
</ResourceDictionary>
