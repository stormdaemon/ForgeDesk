<UserControl x:Class="ForgeDesk.App.Features.Settings.UpdatesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UpdatesSettingsViewModel}"
             d:DesignWidth="800"
             Focusable="False">
  <StackPanel>
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="ForgeDesk" />
    <Border AutomationProperties.AutomationId="Settings.UpdateCard" Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource ForgeLogoImage}" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock AutomationProperties.AutomationId="Settings.CurrentVersion" Style="{StaticResource ForgeSubtitle}"
                       Text="{Binding Updates.CurrentVersion, StringFormat=ForgeDesk {0}}" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
              <controls:StatusDot Margin="0,0,8,0" VerticalAlignment="Center"
                                  Status="{Binding Updates.StatusTone, Converter={StaticResource SettingsStatusToneToKind}}" />
              <TextBlock AutomationProperties.AutomationId="Settings.UpdateStatus" Style="{StaticResource SettingsDescriptionStyle}" Margin="0"
                         Text="{Binding Updates.StatusText}" />
            </StackPanel>
            <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Updates.LastCheckedText}"
                       Visibility="{Binding Updates.LastCheckedText, Converter={StaticResource NullToCollapsed}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
            <ui:Button AutomationProperties.AutomationId="Settings.CheckUpdatesButton" Command="{Binding CheckForUpdatesCommand}"
                       IsEnabled="{Binding Updates.IsSupported}"
                       Visibility="{Binding Updates.HasUpdate, Converter={StaticResource InverseBoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16">
                  <ui:SymbolIcon FontSize="16" Symbol="ArrowSync16" Visibility="{Binding Updates.IsChecking, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                   Visibility="{Binding Updates.IsChecking, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Margin="8,0,0,0" Text="Check for updates" />
              </StackPanel>
            </ui:Button>
            <ui:Button Appearance="Primary" AutomationProperties.AutomationId="Settings.InstallUpdateButton" Command="{Binding InstallUpdateCommand}"
                       Icon="{ui:SymbolIcon ArrowDownload16}" IsEnabled="{Binding Updates.IsDownloading, Converter={StaticResource SettingsInverseBoolean}}"
                       Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Download and restart" />
            </ui:Button>
          </StackPanel>
        </Grid>

        <!-- Download progress -->
        <StackPanel Margin="54,12,0,0" Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar Height="4" Maximum="1" Minimum="0" Value="{Binding Updates.DownloadProgress, Mode=OneWay}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}"
                     Text="ForgeDesk restarts by itself once the update is downloaded. Running commands will be stopped." />
        </StackPanel>

        <!-- Release notes -->
        <Border Margin="54,12,0,0" Padding="12,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6"
                Visibility="{Binding Updates.HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Style="{StaticResource ForgeBodyStrong}" Text="What's new" />
            <TextBlock Margin="0,6,0,0" MaxHeight="220" Style="{StaticResource ForgeBody}" Text="{Binding Updates.ReleaseNotes}" TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowSync20}" IsEnabled="{Binding Updates.IsSupported}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Check for updates automatically" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                     Text="Shortly after ForgeDesk starts. You choose when to restart; nothing installs without you." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch AutomationProperties.AutomationId="Settings.AutoUpdateToggle" AutomationProperties.Name="Check for updates automatically"
                       IsChecked="{Binding CheckAutomatically, Mode=TwoWay}" OffContent="Off" OnContent="On" />
    </ui:CardControl>
  </StackPanel>
</UserControl>
