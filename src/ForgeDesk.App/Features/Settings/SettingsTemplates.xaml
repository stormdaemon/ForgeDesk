<!--
  Settings feature: the Settings page, one view per section, and the GitHub sign-in view shared with
  onboarding. Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Settings"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Settings/SettingsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <views:SettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
    <views:GeneralSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}">
    <views:AppearanceSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GitSettingsViewModel}">
    <views:GitSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GitHubSettingsViewModel}">
    <views:GitHubSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TerminalSettingsViewModel}">
    <views:TerminalSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CommandsSettingsViewModel}">
    <views:CommandsSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EditorSettingsViewModel}">
    <views:EditorSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:UpdatesSettingsViewModel}">
    <views:UpdatesSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DataSettingsViewModel}">
    <views:DataSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AboutSettingsViewModel}">
    <views:AboutSettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GitHubSignInViewModel}">
    <views:GitHubSignInView />
  </DataTemplate>
</ResourceDictionary>
