<UserControl x:Class="ForgeDesk.App.Features.Settings.DataSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DataSettingsViewModel}"
             d:DesignWidth="800"
             x:Name="Root"
             Focusable="False">
  <StackPanel>
    <ui:InfoBar Margin="0,8,0,0" AutomationProperties.AutomationId="Settings.ResetPendingBar" IsClosable="False" IsOpen="{Binding IsResetPending}"
                Severity="Warning" Title="ForgeDesk will be reset the next time it starts"
                Message="Its projects list, tasks, history and settings will be deleted. Project folders are not touched.">
      <ui:Button Margin="0,8,0,0" AutomationProperties.AutomationId="Settings.CancelResetButton" Command="{Binding CancelResetCommand}" Content="Cancel reset" />
    </ui:InfoBar>

    <!-- ===== Locations ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Locations" />
    <ui:CardControl Icon="{ui:SymbolIcon Database24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Data folder" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Projects list, tasks, activity, run history and settings." />
          <TextBox Margin="0,6,0,0" AutomationProperties.AutomationId="Settings.DataFolderPath" Style="{StaticResource SettingsPathTextStyle}"
                   Text="{Binding DataFolder, Mode=OneWay}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button AutomationProperties.AutomationId="Settings.OpenDataFolderButton" Command="{Binding OpenDataFolderCommand}" Content="Open"
                 Icon="{ui:SymbolIcon FolderOpen16}" />
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon DocumentText24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Application logs" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Kept for 7 days. Attach them when you report a problem." />
          <TextBox Margin="0,6,0,0" AutomationProperties.AutomationId="Settings.LogsFolderPath" Style="{StaticResource SettingsPathTextStyle}"
                   Text="{Binding LogsFolder, Mode=OneWay}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button AutomationProperties.AutomationId="Settings.OpenLogsFolderButton" Command="{Binding OpenLogsFolderCommand}" Content="Open"
                 Icon="{ui:SymbolIcon FolderOpen16}" />
    </ui:CardControl>

    <!-- ===== Backups ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Backups" />
    <Border AutomationProperties.AutomationId="Settings.BackupsCard" Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Database backups" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                       Text="ForgeDesk backs up its database every day and keeps the five newest. A damaged database is restored from them automatically." />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
            <ui:Button AutomationProperties.AutomationId="Settings.OpenBackupsButton" Command="{Binding OpenBackupsFolderCommand}" Content="Show folder" />
            <ui:Button Margin="8,0,0,0" Appearance="Primary" AutomationProperties.AutomationId="Settings.BackUpNowButton" Command="{Binding BackUpNowCommand}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16">
                  <ui:SymbolIcon FontSize="16" Symbol="DatabaseArrowDown20" Visibility="{Binding IsBackingUp, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Margin="8,0,0,0" Text="Back up now" />
              </StackPanel>
            </ui:Button>
          </StackPanel>
        </Grid>

        <TextBlock Margin="0,12,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="No backup yet."
                   Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl Margin="0,12,0,0" AutomationProperties.AutomationId="Settings.BackupList" Focusable="False" ItemsSource="{Binding Backups}"
                      Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:BackupItem}">
              <Grid Height="32">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Database20" />
                <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeMono}" Text="{Binding FileName}" />
                <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}">
                  <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" />
                  <Run Text="·" />
                  <Run Text="{Binding SizeText, Mode=OneWay}" />
                </TextBlock>
                <ui:Button Grid.Column="3" AutomationProperties.Name="Show this backup in Explorer"
                           Command="{Binding DataContext.RevealBackupCommand, ElementName=Root}" CommandParameter="{Binding}"
                           Icon="{ui:SymbolIcon FolderOpen16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Show in Explorer" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Clean up ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Clean up" />
    <ui:CardControl Icon="{ui:SymbolIcon History24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Clear activity history" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Forgets the journal of every project. Projects, tasks and git history stay." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button AutomationProperties.AutomationId="Settings.ClearActivityButton" Command="{Binding ClearActivityCommand}">
        <StackPanel Orientation="Horizontal">
          <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                           Visibility="{Binding IsClearingActivity, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="Clear activity…" />
        </StackPanel>
      </ui:Button>
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon ArrowReset20}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Reset ForgeDesk" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                     Text="Deletes ForgeDesk's own data (projects list, tasks, history, settings) and signs you out. Your project files are never touched." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button AutomationProperties.AutomationId="Settings.ResetButton" Command="{Binding ResetCommand}">
        <TextBlock Foreground="{DynamicResource ForgeDangerBrush}" Text="Reset ForgeDesk…" />
      </ui:Button>
    </ui:CardControl>
  </StackPanel>
</UserControl>
