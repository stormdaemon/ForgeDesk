<!--
  Styles of the Settings page and of the shared GitHub sign-in view (also used by onboarding):
  setting cards, group headings, links, validation text. Merged by SettingsTemplates.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell">

  <shell:StatusToneToKindConverter x:Key="SettingsStatusToneToKind" />
  <shell:InverseBooleanConverter x:Key="SettingsInverseBoolean" />

  <Style x:Key="SettingsFocusVisualStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" StrokeThickness="2"
                     Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Heading above a group of cards ("Appearance", "Identity"). -->
  <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeBodyStrong}">
    <Setter Property="Margin" Value="0,20,0,8" />
  </Style>

  <!-- First line and explanation of a setting. -->
  <Style x:Key="SettingsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeBody}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style x:Key="SettingsValidationStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaption}">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
  </Style>

  <!-- A setting row: Windows 11 settings card (icon, header, control on the right). -->
  <Style x:Key="SettingsCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- A card that is not a single row (lists, forms): same surface, laid out freely. -->
  <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource ForgeSectionCardStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Text button styled as a link (opens a page or a folder). -->
  <Style x:Key="SettingsLinkButtonStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="0,2">
            <TextBlock x:Name="Label" FontSize="13" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Path shown in a card: selectable monospace text without a text box look. -->
  <Style x:Key="SettingsPathTextStyle" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource ForgeMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Theme radio card (System / Dark / Light) with a small preview. -->
  <Style x:Key="SettingsThemeCardStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Width" Value="168" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Card" Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
              <Setter TargetName="Card" Property="BorderThickness" Value="2" />
              <Setter TargetName="Card" Property="Padding" Value="7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Option list (pull strategy): selectable rows with a radio mark. -->
  <Style x:Key="SettingsOptionItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                <Ellipse x:Name="Mark" Width="8" Height="8" Fill="{DynamicResource ForgeAccentBrush}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsPlainListStyle" TargetType="ListBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Circular account avatar: initials under the (asynchronously loaded) GitHub picture. -->
  <Style x:Key="SettingsAvatarInitialsStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
  </Style>
</ResourceDictionary>
