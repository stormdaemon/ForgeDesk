<UserControl x:Class="ForgeDesk.App.Features.Settings.TerminalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TerminalSettingsViewModel}"
             d:DesignWidth="800"
             Focusable="False">
  <StackPanel>
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Integrated terminal" />
    <ui:CardControl AutomationProperties.AutomationId="Settings.DefaultShellCard" Icon="{ui:SymbolIcon WindowConsole20}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Default shell" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Opened by new terminals in the Terminal tab of a project." />
          <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeWarningBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding ShellWarning}"
                     TextWrapping="Wrap" Visibility="{Binding ShellWarning, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <Grid>
        <ui:ProgressRing Width="18" Height="18" HorizontalAlignment="Right" IsIndeterminate="True"
                         Visibility="{Binding IsLoadingShells, Converter={StaticResource BoolToVisibility}}" />
        <ComboBox MinWidth="260" AutomationProperties.AutomationId="Settings.DefaultShellSelector" AutomationProperties.Name="Default shell"
                  ItemsSource="{Binding Shells}" SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                  Visibility="{Binding IsLoadingShells, Converter={StaticResource InverseBoolToVisibility}}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ShellOption}">
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}, ConverterParameter=WindowConsole20}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon TextFontSize24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Font size" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Between 8 and 32." />
          <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding TerminalFontSizeError}"
                     Visibility="{Binding HasTerminalFontSizeError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:NumberBox Width="140" AutomationProperties.AutomationId="Settings.TerminalFontSizeBox" AutomationProperties.Name="Terminal font size"
                    ClearButtonEnabled="False" LargeChange="2" MaxDecimalPlaces="1" Maximum="32" Minimum="8" SmallChange="1"
                    Value="{Binding TerminalFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </ui:CardControl>
  </StackPanel>
</UserControl>
