<UserControl x:Class="ForgeDesk.App.Features.Settings.GitSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitSettingsViewModel}"
             d:DesignWidth="800"
             Focusable="False">
  <StackPanel>
    <!-- ===== Git program ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Git program" />
    <Border AutomationProperties.AutomationId="Settings.GitProgramCard" Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="24" VerticalAlignment="Top">
            <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisibility}}" />
            <controls:StatusDot Size="10" Status="{Binding GitStatusTone, Converter={StaticResource SettingsStatusToneToKind}}"
                                Visibility="{Binding IsDetecting, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,12,0">
            <TextBlock AutomationProperties.AutomationId="Settings.GitStatus" Style="{StaticResource ForgeBodyStrong}" Text="{Binding GitStatusText}" />
            <TextBox Margin="0,4,0,0" AutomationProperties.AutomationId="Settings.GitPath" Style="{StaticResource SettingsPathTextStyle}"
                     Text="{Binding GitPath, Mode=OneWay}" Visibility="{Binding IsGitFound, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsDescriptionStyle}"
                       Visibility="{Binding HasCustomGitPath, Converter={StaticResource BoolToVisibility}}"
                       Text="Chosen in ForgeDesk. Reset to use the Git installed on this computer." />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsDescriptionStyle}"
                       Visibility="{Binding HasCustomGitPath, Converter={StaticResource InverseBoolToVisibility}}"
                       Text="Found automatically (PATH, then the usual Git for Windows folders)." />
            <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding GitPathError}"
                       Visibility="{Binding HasGitPathError, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
            <ui:Button AutomationProperties.AutomationId="Settings.ResetGitPathButton" Command="{Binding ResetGitPathCommand}" Content="Reset"
                       Visibility="{Binding HasCustomGitPath, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Settings.BrowseGitButton" Command="{Binding BrowseGitCommand}" Content="Browse…"
                       Icon="{ui:SymbolIcon FolderOpen16}" ToolTip="Choose git.exe" />
            <ui:Button Margin="8,0,0,0" AutomationProperties.AutomationId="Settings.DetectGitButton" AutomationProperties.Name="Detect Git again"
                       Command="{Binding DetectCommand}" Icon="{ui:SymbolIcon ArrowClockwise16}" Style="{StaticResource ForgeIconButtonStyle}"
                       ToolTip="Detect again (F5)" />
          </StackPanel>
        </Grid>
        <Border Margin="36,12,0,0" Padding="12,10" Background="{DynamicResource ForgeWarningSubtleBrush}" CornerRadius="6"
                Visibility="{Binding IsGitFound, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel>
            <TextBlock Style="{StaticResource ForgeBody}" TextWrapping="Wrap"
                       Text="ForgeDesk needs Git for status, commits, branches and sync. Install Git for Windows, then detect again — or choose git.exe if it's installed somewhere unusual." />
            <ui:Button Margin="0,10,0,0" Appearance="Primary" AutomationProperties.AutomationId="Settings.DownloadGitButton" Command="{Binding DownloadGitCommand}"
                       Content="Download Git for Windows" Icon="{ui:SymbolIcon ArrowDownload16}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ===== Identity ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Commit identity" />
    <Border AutomationProperties.AutomationId="Settings.GitIdentityCard" Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0"
                   Text="The name and email written on your commits, saved in your global Git configuration (git config --global)." />
        <Grid Margin="0,12,0,0" IsEnabled="{Binding IsIdentityLoaded}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Name" />
            <ui:TextBox AutomationProperties.AutomationId="Settings.GitNameBox" AutomationProperties.Name="Commit author name" ClearButtonEnabled="False"
                        PlaceholderText="Ada Lovelace" Text="{Binding AuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding AuthorNameError}"
                       Visibility="{Binding HasAuthorNameError, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Email" />
            <ui:TextBox AutomationProperties.AutomationId="Settings.GitEmailBox" AutomationProperties.Name="Commit author email" ClearButtonEnabled="False"
                        PlaceholderText="ada@example.com" Text="{Binding AuthorEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding AuthorEmailError}"
                       Visibility="{Binding HasAuthorEmailError, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding IdentityStatus, Converter={StaticResource NullToCollapsed}}">
          <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource ForgeSuccessBrush}" Symbol="CheckmarkCircle16" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding IdentityStatus}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== Pull ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Pulling" />
    <Border Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="When pulling and both sides have new commits" />
        <ListBox Margin="-12,8,-12,0" AutomationProperties.AutomationId="Settings.PullStrategy" AutomationProperties.Name="Pull strategy"
                 ItemContainerStyle="{StaticResource SettingsOptionItemStyle}" ItemsSource="{Binding PullStrategies}"
                 SelectedItem="{Binding SelectedPullStrategy, Mode=TwoWay}" Style="{StaticResource SettingsPlainListStyle}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PullStrategyOption}">
              <StackPanel>
                <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Description}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- ===== Fetch and credentials ===== -->
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Remotes" />
    <ui:CardControl Icon="{ui:SymbolIcon ArrowSync20}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Fetch automatically" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Keeps ahead/behind counts current for the open project. Nothing is merged." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch AutomationProperties.AutomationId="Settings.AutoFetchToggle" AutomationProperties.Name="Fetch automatically"
                       IsChecked="{Binding AutoFetch, Mode=TwoWay}" OffContent="Off" OnContent="On" />
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon Timer20}" IsEnabled="{Binding AutoFetch}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Fetch every (minutes)" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Between 1 and 120 minutes." />
          <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding AutoFetchIntervalError}"
                     Visibility="{Binding HasAutoFetchIntervalError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:NumberBox Width="140" AutomationProperties.AutomationId="Settings.AutoFetchIntervalBox" AutomationProperties.Name="Fetch interval in minutes"
                    ClearButtonEnabled="False" LargeChange="10" MaxDecimalPlaces="0" Maximum="120" Minimum="1" SmallChange="1"
                    Value="{Binding AutoFetchInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon Key20}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Use my GitHub sign-in for git operations" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                     Text="Push, pull and fetch to github.com with the account signed in to ForgeDesk, without extra prompts." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch AutomationProperties.AutomationId="Settings.UseGitHubForGitToggle" AutomationProperties.Name="Use my GitHub sign-in for git operations"
                       IsChecked="{Binding UseGitHubSignInForGit, Mode=TwoWay}" OffContent="Off" OnContent="On" />
    </ui:CardControl>
  </StackPanel>
</UserControl>
