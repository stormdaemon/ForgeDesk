<UserControl x:Class="ForgeDesk.App.Features.Settings.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppearanceSettingsViewModel}"
             d:DesignWidth="800"
             Focusable="False">
  <UserControl.Resources>
    <!-- A miniature window in the colors of a theme (the previews show the themes, not the current one). -->
    <DataTemplate x:Key="ThemePreviewTemplate" DataType="{x:Type vm:ThemeOption}">
      <StackPanel>
        <Border Height="84" ClipToBounds="True" CornerRadius="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Dark half (whole width for Dark, left half for System) -->
            <Border x:Name="DarkPane" Grid.ColumnSpan="2" Background="#1F2228" CornerRadius="6">
              <StackPanel Margin="10,10,0,0">
                <Border Width="54" Height="8" HorizontalAlignment="Left" Background="#F2762E" CornerRadius="2" />
                <Border Width="96" Height="6" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#3A3F4A" CornerRadius="2" />
                <Border Width="72" Height="6" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#3A3F4A" CornerRadius="2" />
                <Border Width="84" Height="6" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#3A3F4A" CornerRadius="2" />
              </StackPanel>
            </Border>

            <!-- Light half (whole width for Light, right half for System) -->
            <Border x:Name="LightPane" Grid.Column="1" Background="#F3F3F3" CornerRadius="0,6,6,0" Visibility="Collapsed">
              <StackPanel Margin="10,10,0,0">
                <Border Width="54" Height="8" HorizontalAlignment="Left" Background="#F2762E" CornerRadius="2" />
                <Border Width="96" Height="6" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#D6D6D6" CornerRadius="2" />
                <Border Width="72" Height="6" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#D6D6D6" CornerRadius="2" />
                <Border Width="84" Height="6" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#D6D6D6" CornerRadius="2" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <TextBlock Margin="2,10,0,0" Style="{StaticResource ForgeBodyStrong}" Text="{Binding Title}" />
        <TextBlock Margin="2,2,0,2" Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Description}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter TargetName="DarkPane" Property="Grid.ColumnSpan" Value="1" />
          <Setter TargetName="DarkPane" Property="CornerRadius" Value="6,0,0,6" />
          <Setter TargetName="LightPane" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLight}" Value="True">
          <Setter TargetName="DarkPane" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="LightPane" Property="Visibility" Value="Visible" />
          <Setter TargetName="LightPane" Property="Grid.Column" Value="0" />
          <Setter TargetName="LightPane" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="LightPane" Property="CornerRadius" Value="6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Theme" />
    <Border Style="{StaticResource SettingsPanelStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Choose how ForgeDesk looks" />
        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="System follows the light or dark mode chosen in Windows settings." />
        <ListBox Margin="0,14,0,0" AutomationProperties.AutomationId="Settings.ThemeOptions" AutomationProperties.Name="Theme"
                 ItemContainerStyle="{StaticResource SettingsThemeCardStyle}" ItemTemplate="{StaticResource ThemePreviewTemplate}"
                 ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Style="{StaticResource SettingsPlainListStyle}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </StackPanel>
    </Border>
    <ui:CardControl Icon="{ui:SymbolIcon Color24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Use my Windows accent color" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Replaces ForgeDesk's ember accent in buttons, selection and focus." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch AutomationProperties.AutomationId="Settings.WindowsAccentToggle" AutomationProperties.Name="Use my Windows accent color"
                       IsChecked="{Binding UseWindowsAccent, Mode=TwoWay}" OffContent="Off" OnContent="On" />
    </ui:CardControl>

    <TextBlock Style="{StaticResource SettingsGroupHeaderStyle}" Text="Fonts" />
    <ui:CardControl Icon="{ui:SymbolIcon TextFont24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Code font" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Used for files, diffs and logs. List fallbacks separated by commas." />
          <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding CodeFontError}"
                     Visibility="{Binding HasCodeFontError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:TextBox Width="280" AutomationProperties.AutomationId="Settings.CodeFontBox" AutomationProperties.Name="Code font" ClearButtonEnabled="False"
                  FontFamily="{DynamicResource ForgeMonoFont}" Text="{Binding CodeFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon TextFontSize24}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Code font size" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Between 8 and 32." />
          <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding CodeFontSizeError}"
                     Visibility="{Binding HasCodeFontSizeError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:NumberBox Width="140" AutomationProperties.AutomationId="Settings.CodeFontSizeBox" AutomationProperties.Name="Code font size"
                    ClearButtonEnabled="False" LargeChange="2" MaxDecimalPlaces="1" Maximum="32" Minimum="8" SmallChange="1"
                    Value="{Binding CodeFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon WindowConsole20}" Style="{StaticResource SettingsCardStyle}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Terminal font size" />
          <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="The integrated terminal uses its own size. Between 8 and 32." />
          <TextBlock Style="{StaticResource SettingsValidationStyle}" Text="{Binding TerminalFontSizeError}"
                     Visibility="{Binding HasTerminalFontSizeError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:NumberBox Width="140" AutomationProperties.AutomationId="Settings.AppearanceTerminalFontSizeBox" AutomationProperties.Name="Terminal font size"
                    ClearButtonEnabled="False" LargeChange="2" MaxDecimalPlaces="1" Maximum="32" Minimum="8" SmallChange="1"
                    Value="{Binding TerminalFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </ui:CardControl>
  </StackPanel>
</UserControl>
