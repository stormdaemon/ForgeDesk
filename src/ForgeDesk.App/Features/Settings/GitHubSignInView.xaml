<UserControl x:Class="ForgeDesk.App.Features.Settings.GitHubSignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Settings;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitHubSignInViewModel}"
             d:DesignWidth="720"
             AutomationProperties.AutomationId="GitHubSignIn.Root"
             Focusable="False">
  <StackPanel>
    <!-- ===== Signed in: the account ===== -->
    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
      <Border AutomationProperties.AutomationId="GitHubSignIn.AccountCard" Style="{StaticResource SettingsPanelStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Avatar: initials, covered by the picture once it downloads. -->
          <Grid Width="48" Height="48" VerticalAlignment="Center">
            <Border Style="{StaticResource SettingsAvatarInitialsStyle}">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                         Foreground="{DynamicResource ForgeAccentTextBrush}" Text="{Binding Initials}" />
            </Border>
            <Ellipse Visibility="{Binding AvatarUrl, Converter={StaticResource NullToCollapsed}}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
          </Grid>

          <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
            <TextBlock AutomationProperties.AutomationId="GitHubSignIn.DisplayName" Style="{StaticResource ForgeSubtitle}" Text="{Binding DisplayName}" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Login, StringFormat=@{0}}" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource ForgeSuccessBrush}" Symbol="CheckmarkCircle16" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding MethodText}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeCaptionSecondary}" TextWrapping="Wrap"
                       Visibility="{Binding HasScopes, Converter={StaticResource BoolToVisibility}}">
              <Run Text="Scopes:" />
              <Run FontFamily="{DynamicResource ForgeMonoFont}" Text="{Binding ScopesText, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <ui:Button Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="GitHubSignIn.ProfileButton"
                     Command="{Binding OpenProfileCommand}" Content="View profile" Icon="{ui:SymbolIcon Open16}" />
        </Grid>
      </Border>

      <ui:InfoBar Margin="0,4,0,0" IsClosable="False" IsOpen="{Binding HasWarning}" Message="{Binding Warning}" Severity="Warning"
                  Title="Some permissions are missing" />
      <ui:InfoBar Margin="0,4,0,0" IsClosable="False" IsOpen="{Binding IsUnverified}" Severity="Informational" Title="Not verified yet"
                  Message="ForgeDesk couldn't reach GitHub at startup. Your session is checked again as soon as GitHub is reachable." />
    </StackPanel>

    <!-- ===== Signed out: three ways to sign in ===== -->
    <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
      <!-- Browser (Git Credential Manager) -->
      <ui:CardControl AutomationProperties.AutomationId="GitHubSignIn.BrowserCard" Icon="{ui:SymbolIcon Globe24}" Style="{StaticResource SettingsCardStyle}">
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Sign in with your browser" />
              <Border Margin="8,0,0,0" Padding="6,1,6,2" Background="{DynamicResource ForgeAccentSubtleBrush}" CornerRadius="4">
                <TextBlock FontSize="11" Foreground="{DynamicResource ForgeAccentTextBrush}" Text="Recommended" />
              </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                       Text="Git Credential Manager opens a GitHub sign-in window in your browser. The same sign-in then works for git push and pull." />
          </StackPanel>
        </ui:CardControl.Header>
        <Grid>
          <ui:Button Appearance="Primary" AutomationProperties.AutomationId="GitHubSignIn.BrowserButton" Command="{Binding SignInWithBrowserCommand}"
                     Content="Sign in" Visibility="{Binding IsSigningInWithBrowser, Converter={StaticResource InverseBoolToVisibility}}" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsSigningInWithBrowser, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
            <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="Waiting for the browser…" />
            <ui:Button AutomationProperties.AutomationId="GitHubSignIn.CancelButton" Command="{Binding CancelSignInCommand}" Content="Cancel" />
          </StackPanel>
        </Grid>
      </ui:CardControl>

      <!-- GitHub CLI -->
      <ui:CardControl AutomationProperties.AutomationId="GitHubSignIn.CliCard" Icon="{ui:SymbolIcon WindowConsole20}" Style="{StaticResource SettingsCardStyle}"
                      Visibility="{Binding IsGitHubCliAvailable, Converter={StaticResource BoolToVisibility}}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Use GitHub CLI" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Reuse the account you signed in with in the gh command-line tool." />
          </StackPanel>
        </ui:CardControl.Header>
        <Grid>
          <ui:Button AutomationProperties.AutomationId="GitHubSignIn.CliButton" Command="{Binding SignInWithCliCommand}" Content="Use GitHub CLI"
                     Visibility="{Binding IsSigningInWithCli, Converter={StaticResource InverseBoolToVisibility}}" />
          <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Visibility="{Binding IsSigningInWithCli, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </ui:CardControl>

      <!-- Personal access token -->
      <ui:CardExpander Margin="0,0,0,4" AutomationProperties.AutomationId="GitHubSignIn.TokenCard" ContentPadding="16" Icon="{ui:SymbolIcon Key20}"
                       IsExpanded="{Binding IsTokenFormOpen, Mode=TwoWay}">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="Paste a personal access token" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                       Text="For full control over permissions. ForgeDesk needs the repo, workflow and read:org scopes." />
          </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:PasswordBox AutomationProperties.AutomationId="GitHubSignIn.TokenBox" AutomationProperties.Name="Personal access token"
                            FontFamily="{DynamicResource ForgeMonoFont}" Icon="{ui:SymbolIcon Key16}"
                            Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ghp_… or github_pat_…">
              <ui:PasswordBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SignInWithTokenCommand}" />
              </ui:PasswordBox.InputBindings>
            </ui:PasswordBox>
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" AutomationProperties.AutomationId="GitHubSignIn.TokenButton"
                       Command="{Binding SignInWithTokenCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsSigningInWithToken, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Sign in" />
              </StackPanel>
            </ui:Button>
          </Grid>
          <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
            <Button AutomationProperties.AutomationId="GitHubSignIn.CreateTokenLink" Command="{Binding CreateTokenCommand}"
                    Content="Create a token on GitHub" Style="{StaticResource SettingsLinkButtonStyle}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}"
                       Text="opens github.com with the right scopes selected" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource SettingsDescriptionStyle}"
                     Text="The token is kept in Windows Credential Manager, never in ForgeDesk's files." />
        </StackPanel>
      </ui:CardExpander>

      <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding IsGitHubCliAvailable, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="Using the GitHub CLI? Sign in with gh auth login, then come back here." />
        <Button Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding InstallGitHubCliCommand}" Content="Get GitHub CLI"
                Style="{StaticResource SettingsLinkButtonStyle}" />
      </StackPanel>
    </StackPanel>

    <!-- Sign-in failure -->
    <ui:InfoBar Margin="0,8,0,0" AutomationProperties.AutomationId="GitHubSignIn.Error" IsClosable="False" IsOpen="{Binding HasError}"
                Message="{Binding Error.Message}" Severity="Error" Title="{Binding Error.Title}">
      <TextBlock Margin="0,4,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Error.Hint}" TextWrapping="Wrap"
                 Visibility="{Binding Error.Hint, Converter={StaticResource NullToCollapsed}}" />
    </ui:InfoBar>
  </StackPanel>
</UserControl>
