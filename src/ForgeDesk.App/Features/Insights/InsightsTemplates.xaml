<!--
  Insights feature: the project health report tab. Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Insights"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Insights;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Overview/OverviewStyles.xaml" />
    <ResourceDictionary Source="/ForgeDesk;component/Features/Insights/InsightsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:InsightsViewModel}">
    <views:InsightsView />
  </DataTemplate>
</ResourceDictionary>
