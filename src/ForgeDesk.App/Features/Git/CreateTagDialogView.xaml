<UserControl x:Class="ForgeDesk.App.Features.Git.CreateTagDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreateTagDialogViewModel}"
             d:DesignWidth="480"
             AutomationProperties.AutomationId="Git.CreateTagDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
          <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Tag16" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding TargetDescription, StringFormat=On {0}}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,6" Style="{StaticResource ForgeCaption}" Text="Name" />
        <ui:TextBox x:Name="NameBox" AutomationProperties.AutomationId="Git.TagName" AutomationProperties.Name="Tag name" ClearButtonEnabled="False"
                    FontFamily="{DynamicResource ForgeMonoFont}" PlaceholderText="v1.2.0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />

        <TextBlock Margin="0,12,0,6" Style="{StaticResource ForgeCaption}" Text="Message (optional)" />
        <ui:TextBox MinHeight="72" MaxHeight="160" VerticalContentAlignment="Top" AcceptsReturn="True" AutomationProperties.AutomationId="Git.TagMessage"
                    AutomationProperties.Name="Tag message" ClearButtonEnabled="False" PlaceholderText="Release notes or why this commit matters"
                    Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding KindHint}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="Git.CreateTagConfirmButton"
                   Command="{Binding ConfirmCommand}" Content="Create tag" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
