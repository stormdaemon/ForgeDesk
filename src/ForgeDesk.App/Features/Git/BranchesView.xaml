<UserControl x:Class="ForgeDesk.App.Features.Git.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BranchesViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             x:Name="Root"
             AutomationProperties.AutomationId="Git.BranchesView"
             Focusable="False">
  <UserControl.Resources>
    <ContextMenu x:Key="MoreMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem AutomationProperties.AutomationId="Git.DeleteMergedMenuItem" Command="{Binding DeleteMergedCommand}" Header="Delete merged branches…">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="Delete16" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Command="{Binding ReloadCommand}" Header="Refresh" InputGestureText="F5">
        <MenuItem.Icon>
          <ui:SymbolIcon Symbol="ArrowClockwise16" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>

    <DataTemplate DataType="{x:Type vm:BranchGroupHeader}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource GitGroupTitleStyle}" Text="{Binding Title, Converter={StaticResource UpperCase}}" />
        <TextBlock Margin="8,0,0,4" Style="{StaticResource GitGroupTitleStyle}" Text="{Binding Count}" />
      </StackPanel>
    </DataTemplate>

    <!-- A branch: marker, name and last commit, state pills, date. -->
    <DataTemplate DataType="{x:Type vm:BranchRowViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding SwitchCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{Binding PlacementTarget.DataContext.SwitchText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Enter"
                      Visibility="{Binding PlacementTarget.DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="ArrowSwap16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding NewBranchCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="New branch from here…">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="BranchFork16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding MergeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="{Binding MergeTargetText}"
                      Visibility="{Binding PlacementTarget.DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Merge16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding PublishCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Publish branch"
                      Visibility="{Binding PlacementTarget.DataContext.NeedsPublish, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="CloudArrowUp16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Rename…" InputGestureText="F2"
                      Visibility="{Binding PlacementTarget.DataContext.IsLocal, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Rename16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Delete…" InputGestureText="Del"
                      Visibility="{Binding PlacementTarget.DataContext.IsOtherLocal, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Delete16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding ViewHistoryCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="View history">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="History16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyNameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy name">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <Grid VerticalAlignment="Center">
          <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource ForgeAccentTextBrush}" Symbol="Checkmark16"
                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
          <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Cloud16"
                         Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="8,4,12,4" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource ForgeMono}">
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <DockPanel Margin="0,2,0,0" LastChildFill="True" Visibility="{Binding TipSubject, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Margin="8,0,0,0" DockPanel.Dock="Right" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding TipAuthor}"
                       Visibility="{Binding TipAuthor, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding TipSubject}" />
          </DockPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
          <controls:Pill Margin="0,0,4,0" Kind="Info" Text="{Binding AheadText}" ToolTip="Commits to push"
                         Visibility="{Binding HasAhead, Converter={StaticResource BoolToVisibility}}" />
          <controls:Pill Margin="0,0,4,0" Kind="Warning" Text="{Binding BehindText}" ToolTip="Commits to pull"
                         Visibility="{Binding HasBehind, Converter={StaticResource BoolToVisibility}}" />
          <controls:Pill Margin="0,0,4,0" Kind="Warning" Icon="Warning16" Text="gone" ToolTip="Its upstream branch was deleted on the remote"
                         Visibility="{Binding IsGone, Converter={StaticResource BoolToVisibility}}" />
          <controls:Pill Margin="0,0,4,0" Kind="Success" Text="merged" ToolTip="Fully merged into the default branch"
                         Visibility="{Binding IsMerged, Converter={StaticResource BoolToVisibility}}" />
          <controls:Pill Margin="0,0,4,0" Kind="Neutral" Text="default" ToolTip="The repository's default branch"
                         Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
          <controls:Pill Margin="0,0,4,0" Kind="Neutral" Text="local only" ToolTip="Not published to the remote yet"
                         Visibility="{Binding NeedsPublish, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TextBlock Grid.Column="3" MinWidth="72" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" TextAlignment="Right"
                   Visibility="{Binding TipDate, Converter={StaticResource NullToCollapsed}}">
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource RelativeTime}">
              <Binding Path="TipDate" />
              <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="380" MinWidth="300" MaxWidth="560" />
    </Grid.ColumnDefinitions>

    <!-- ===== Branch list ===== -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="24,12,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox MaxWidth="320" HorizontalAlignment="Left" AutomationProperties.AutomationId="Git.BranchFilter" AutomationProperties.Name="Filter branches"
                    ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}" PlaceholderText="Filter branches"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
          <ui:TextBox.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}" />
          </ui:TextBox.InputBindings>
        </ui:TextBox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
          <ui:ProgressRing Width="16" Height="16" Margin="0,0,12,0" IsIndeterminate="True"
                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button AutomationProperties.AutomationId="Git.NewBranchButton" Command="{Binding NewBranchFromHeadCommand}" Content="New branch…"
                     Icon="{ui:SymbolIcon BranchFork16}" ToolTip="Create a branch from the current commit and switch to it" />
          <ui:Button x:Name="MoreButton" Margin="4,0,0,0" AutomationProperties.AutomationId="Git.BranchesMoreButton" AutomationProperties.Name="More actions"
                     Click="OnMoreClick" Icon="{ui:SymbolIcon MoreHorizontal16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="More actions" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <ListBox x:Name="BranchList" Margin="8,0,0,4" AutomationProperties.AutomationId="Git.BranchList" AutomationProperties.Name="Branches"
                 ItemContainerStyle="{StaticResource GitTallRowStyle}" ItemsSource="{Binding Rows}" MouseDoubleClick="OnBranchDoubleClick"
                 PreviewKeyDown="OnBranchListKeyDown" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" SelectionMode="Single"
                 Style="{StaticResource ForgeDenseListBoxStyle}" />
        <controls:SkeletonList IsActive="{Binding IsLoading}" RowCount="8" RowHeight="44"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorPanel Margin="24" Error="{Binding Error}" RetryCommand="{Binding ReloadCommand}" />
        <controls:EmptyState Icon="Search24" Title="No branch matches this filter" Description="Check the spelling, or clear the filter to see every branch."
                             ActionText="Clear filter" ActionCommand="{Binding ClearFilterCommand}"
                             Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
        <controls:EmptyState AutomationProperties.AutomationId="Git.NoBranchesState" Icon="BranchFork24" Title="No branches yet"
                             Description="{Binding NoBranchesDescription}"
                             Visibility="{Binding HasNoBranches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" Style="{StaticResource ForgeGridSplitterStyle}" />

    <!-- ===== Selected branch ===== -->
    <ScrollViewer Grid.Column="2" AutomationProperties.AutomationId="Git.BranchDetails" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Margin="16,12,24,24" DataContext="{Binding SelectedBranch}">
        <Border Style="{StaticResource ForgeSectionCardStyle}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Symbol="BranchFork20" />
              <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ForgeMonoFont}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" />
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
              <controls:Pill Margin="0,0,4,4" Kind="Running" Text="current branch" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
              <controls:Pill Margin="0,0,4,4" Kind="Neutral" Text="default" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
              <controls:Pill Margin="0,0,4,4" Kind="Success" Text="merged" Visibility="{Binding IsMerged, Converter={StaticResource BoolToVisibility}}" />
              <controls:Pill Margin="0,0,4,4" Kind="Warning" Icon="Warning16" Text="upstream gone" Visibility="{Binding IsGone, Converter={StaticResource BoolToVisibility}}" />
              <controls:Pill Margin="0,0,4,4" Kind="Neutral" Icon="Cloud16" Text="remote" Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding UpstreamText}" TextWrapping="Wrap" />

            <Rectangle Margin="0,14,0,12" Style="{StaticResource ForgeDividerStyle}" />
            <TextBlock Style="{StaticResource GitGroupTitleStyle}" Text="LAST COMMIT" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource ForgeBody}" Text="{Binding TipSubject, TargetNullValue=—}" TextWrapping="Wrap" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
              <TextBlock Style="{StaticResource ForgeMonoSecondary}" Text="{Binding TipShortSha}" />
              <TextBlock Margin="8,0,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding TipAuthor}" />
              <TextBlock Margin="8,0,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding TipDate, Converter={StaticResource RelativeTime}}"
                         Visibility="{Binding TipDate, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Margin="0,12,0,0">
          <ui:Button Appearance="Primary" AutomationProperties.AutomationId="Git.SwitchBranchButton"
                     Command="{Binding DataContext.SwitchCommand, ElementName=Root}" CommandParameter="{Binding}" Content="{Binding SwitchText}"
                     Icon="{ui:SymbolIcon ArrowSwap16}" Style="{StaticResource GitCardActionButtonStyle}"
                     Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button AutomationProperties.AutomationId="Git.MergeBranchButton" Command="{Binding DataContext.MergeCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="{Binding DataContext.MergeTargetText, ElementName=Root}" Icon="{ui:SymbolIcon Merge16}"
                     Style="{StaticResource GitCardActionButtonStyle}" ToolTip="Merge this branch into the current branch"
                     Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button AutomationProperties.AutomationId="Git.PublishBranchButton" Command="{Binding DataContext.PublishCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="Publish branch" Icon="{ui:SymbolIcon CloudArrowUp16}" Style="{StaticResource GitCardActionButtonStyle}"
                     ToolTip="Push the branch and track it on the remote" Visibility="{Binding NeedsPublish, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button AutomationProperties.AutomationId="Git.NewBranchFromButton" Command="{Binding DataContext.NewBranchCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="New branch from here…" Icon="{ui:SymbolIcon BranchFork16}"
                     Style="{StaticResource GitCardActionButtonStyle}" />
          <ui:Button AutomationProperties.AutomationId="Git.BranchHistoryButton" Command="{Binding DataContext.ViewHistoryCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="View history" Icon="{ui:SymbolIcon History16}" Style="{StaticResource GitCardActionButtonStyle}" />
          <ui:Button AutomationProperties.AutomationId="Git.RenameBranchButton" Command="{Binding DataContext.RenameCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="Rename… (F2)" Icon="{ui:SymbolIcon Rename16}" Style="{StaticResource GitCardActionButtonStyle}"
                     Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Appearance="Danger" AutomationProperties.AutomationId="Git.DeleteBranchButton" Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                     CommandParameter="{Binding}" Content="Delete branch…" Icon="{ui:SymbolIcon Delete16}" Style="{StaticResource GitCardActionButtonStyle}"
                     Visibility="{Binding IsOtherLocal, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
