<UserControl x:Class="ForgeDesk.App.Features.Git.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:git="clr-namespace:ForgeDesk.App.Features.Git"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             x:Name="Root"
             AutomationProperties.AutomationId="Git.HistoryView"
             Focusable="False"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <DataTemplate x:Key="RefPillTemplate" DataType="{x:Type vm:RefPill}">
      <Border Style="{StaticResource GitRefPillStyle}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon x:Name="TagIcon" Margin="0,0,3,0" VerticalAlignment="Center" FontSize="11" Symbol="Tag16" Visibility="Collapsed" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Tag">
          <Setter TargetName="TagIcon" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A commit: graph cell, refs + subject, author, relative date, short SHA. -->
    <DataTemplate x:Key="CommitRowTemplate" DataType="{x:Type vm:CommitRowViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding CopyShaCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy SHA">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyMessageCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy message" />
            <Separator />
            <MenuItem Command="{Binding CreateBranchFromCommitCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Create branch from here…">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="BranchFork16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CreateTagAtCommitCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Create tag here…">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Tag16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator Visibility="{Binding CanOpenOnGitHub, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Command="{Binding OpenOnGitHubCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Open on GitHub" Visibility="{Binding CanOpenOnGitHub, Converter={StaticResource BoolToVisibility}}">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Globe16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <git:CommitGraphCell Width="{Binding DataContext.GraphWidth, ElementName=Root}" HorizontalAlignment="Left" IsHead="{Binding IsHead}"
                             LaneWidth="12" Row="{Binding Graph}" />

        <DockPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center" LastChildFill="True">
          <ItemsControl DockPanel.Dock="Left" Focusable="False" ItemTemplate="{StaticResource RefPillTemplate}" ItemsSource="{Binding Refs}"
                        Visibility="{Binding HasRefs, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Style="{StaticResource ForgeBody}" Text="{Binding Subject}" ToolTip="{Binding Subject}" />
        </DockPanel>

        <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding AuthorToolTip}">
          <controls:ProjectAvatar ProjectName="{Binding AuthorName}" Size="18" />
          <TextBlock MaxWidth="136" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding AuthorName}" />
        </StackPanel>

        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" ToolTip="{Binding FullDate}">
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource RelativeTime}">
              <Binding Path="Date" />
              <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>

        <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding ShortSha}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Toolbar: search, filters, all branches, refresh ===== -->
    <Grid Grid.Row="0" Margin="24,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ui:TextBox x:Name="SearchBox" Width="300" AutomationProperties.AutomationId="Git.HistorySearch" AutomationProperties.Name="Search commits"
                  ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}" PlaceholderText="Search messages or authors (Ctrl+F)"
                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>

      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Border AutomationProperties.AutomationId="Git.PathFilterChip" Style="{StaticResource GitFilterChipStyle}" ToolTip="{Binding PathFilter}"
                Visibility="{Binding HasPathFilter, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Symbol="Document16" />
            <TextBlock MaxWidth="260" VerticalAlignment="Center" FontSize="12" Text="{Binding PathFilter}" TextTrimming="CharacterEllipsis" />
            <ui:Button AutomationProperties.AutomationId="Git.ClearPathFilterButton" AutomationProperties.Name="Show the whole history"
                       Command="{Binding ClearPathFilterCommand}" Icon="{ui:SymbolIcon Dismiss12}" Style="{StaticResource GitChipCloseButtonStyle}"
                       ToolTip="Show the whole history" />
          </StackPanel>
        </Border>
        <Border AutomationProperties.AutomationId="Git.BranchFilterChip" Style="{StaticResource GitFilterChipStyle}"
                Visibility="{Binding HasRevisionFilter, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14" Symbol="BranchFork16" />
            <TextBlock MaxWidth="220" VerticalAlignment="Center" FontSize="12" Text="{Binding RevisionFilter}" TextTrimming="CharacterEllipsis" />
            <ui:Button AutomationProperties.AutomationId="Git.ClearBranchFilterButton" AutomationProperties.Name="Back to the current branch"
                       Command="{Binding ClearRevisionFilterCommand}" Icon="{ui:SymbolIcon Dismiss12}" Style="{StaticResource GitChipCloseButtonStyle}"
                       ToolTip="Back to the current branch" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <ui:ToggleSwitch Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Git.AllBranchesToggle"
                       Content="All branches" IsChecked="{Binding AllBranches}"
                       IsEnabled="{Binding HasRevisionFilter, Converter={StaticResource GitInverseBoolean}}"
                       ToolTip="{Binding AllBranchesToolTip}" ToolTipService.ShowOnDisabled="True" />

      <ui:Button Grid.Column="3" AutomationProperties.AutomationId="Git.HistoryRefreshButton" AutomationProperties.Name="Refresh"
                 Command="{Binding ReloadCommand}" Icon="{ui:SymbolIcon ArrowClockwise16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Refresh (F5)" />
    </Grid>

    <!-- ===== Commits above, details below ===== -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="360" MinHeight="180" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <ListBox x:Name="CommitList" AutomationProperties.AutomationId="Git.HistoryList" AutomationProperties.Name="Commits"
                 ItemContainerStyle="{StaticResource GitCommitRowStyle}" ItemTemplate="{StaticResource CommitRowTemplate}" ItemsSource="{Binding Commits}"
                 ScrollViewer.ScrollChanged="OnCommitListScrolled" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                 SelectionChanged="OnCommitSelectionChanged" SelectionMode="Single" Style="{StaticResource ForgeDenseListBoxStyle}" />

        <!-- Thin progress line while reloading a list that is already shown. -->
        <Grid VerticalAlignment="Top" IsHitTestVisible="False">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Hidden" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBusy}" Value="True" />
                    <Condition Binding="{Binding IsLoading}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <ProgressBar Height="2" MinHeight="2" IsIndeterminate="True" />
        </Grid>

        <Border Margin="0,0,0,12" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1" CornerRadius="14" Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaption}" Text="Loading more commits…" />
          </StackPanel>
        </Border>

        <controls:SkeletonList IsActive="{Binding IsLoading}" RowCount="12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <controls:ErrorPanel Margin="24" Error="{Binding Error}" RetryCommand="{Binding ReloadCommand}" />

        <controls:EmptyState AutomationProperties.AutomationId="Git.HistoryEmpty" Icon="History24" Title="{Binding EmptyTitle}"
                             Description="{Binding EmptyDescription}" ActionText="{Binding EmptyActionText}" ActionCommand="{Binding ClearFiltersCommand}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <GridSplitter Grid.Row="1" Style="{StaticResource ForgeHorizontalGridSplitterStyle}" />

      <Grid Grid.Row="2" AutomationProperties.AutomationId="Git.CommitDetails">
        <ContentControl Content="{Binding Details}" Focusable="False" IsTabStop="False" />
        <controls:EmptyState Icon="History24" Title="Select a commit" Description="Its message, files and changes appear here."
                             Visibility="{Binding ShowDetailsHint, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
