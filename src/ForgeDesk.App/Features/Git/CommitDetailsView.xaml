<UserControl x:Class="ForgeDesk.App.Features.Git.CommitDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommitDetailsViewModel}"
             d:DesignHeight="360" d:DesignWidth="1000"
             Focusable="False">
  <UserControl.Resources>
    <!-- A changed file: state glyph, name and folder, +/- bars. -->
    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:CommitFileViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding OpenFileInEditorCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open file">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Code16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ViewFileHistoryCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="View history of file">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="History16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding CopyFilePathCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy relative path">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <Border Style="{StaticResource GitStateBadgeStyle}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding StateLetter}" />
        </Border>
        <DockPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource ForgeBody}" Text="{Binding DisplayName}" />
          <TextBlock Margin="8,0,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Directory}" />
        </DockPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding ChangesText}" />
          <StackPanel Width="40" VerticalAlignment="Center" Orientation="Horizontal"
                      Visibility="{Binding IsBinary, Converter={StaticResource InverseBoolToVisibility}}">
            <Rectangle Width="{Binding AdditionsBarWidth}" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource ForgeSuccessBrush}" />
            <Rectangle Width="{Binding DeletionsBarWidth}" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource ForgeDangerBrush}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" MinWidth="280" MaxWidth="720" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <!-- ===== Message, people, parents, files ===== -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="24,12,12,8" Visibility="{Binding IsStash, Converter={StaticResource InverseBoolToVisibility}}">
        <ItemsControl Margin="0,0,0,6" Focusable="False" ItemsSource="{Binding Refs}" Visibility="{Binding HasRefs, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RefPill}">
              <Border Margin="0,0,4,4" Style="{StaticResource GitRefPillStyle}">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox AutomationProperties.AutomationId="Git.CommitSubject" FontSize="15" FontWeight="SemiBold" Style="{StaticResource GitSelectableTextStyle}"
                 Text="{Binding Subject, Mode=OneWay}" />
        <TextBox MaxHeight="96" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource GitSelectableTextStyle}"
                 Text="{Binding Body, Mode=OneWay}" VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:ProjectAvatar VerticalAlignment="Top" ProjectName="{Binding AuthorName}" Size="28" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Style="{StaticResource ForgeBodyStrong}" Text="{Binding AuthorName}" ToolTip="{Binding AuthorEmail}" />
            <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding AuthorDateText}" />
            <TextBlock Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding CommitterText}"
                       Visibility="{Binding HasDistinctCommitter, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
          <TextBlock Style="{StaticResource GitFieldLabelStyle}" Text="Commit" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ForgeMono}" Text="{Binding ShortSha}" ToolTip="{Binding Sha}" />
          <ui:Button Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="6,0,0,0" AutomationProperties.AutomationId="Git.CopyShaButton"
                     AutomationProperties.Name="Copy SHA" Command="{Binding CopyShaCommand}" FontSize="12" Icon="{ui:SymbolIcon Copy16}"
                     Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Copy the full SHA" />
          <ui:Button Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="2,0,0,0" AutomationProperties.Name="Copy message"
                     Command="{Binding CopyMessageCommand}" FontSize="12" Icon="{ui:SymbolIcon TextDescription16}" Style="{StaticResource ForgeIconButtonStyle}"
                     ToolTip="Copy the message" />
        </StackPanel>

        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding HasParents, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource GitFieldLabelStyle}" Text="Parents" />
          <ItemsControl Focusable="False" ItemsSource="{Binding Parents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ParentLink}">
                <Button Command="{Binding DataContext.ShowParentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Content="{Binding ShortSha}" Style="{StaticResource GitLinkButtonStyle}" ToolTip="Show this commit" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1" Margin="24,4,12,4">
        <TextBlock Style="{StaticResource GitGroupTitleStyle}" Text="{Binding StatsText, Converter={StaticResource UpperCase}}" />
      </Grid>

      <Grid Grid.Row="2">
        <ListBox Margin="8,0,0,4" AutomationProperties.AutomationId="Git.CommitFiles" AutomationProperties.Name="Changed files"
                 ItemTemplate="{StaticResource FileRowTemplate}" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 SelectionMode="Single" Style="{StaticResource ForgeDenseListBoxStyle}" />
        <controls:SkeletonList IsActive="{Binding IsLoadingFiles}" RowCount="4" Visibility="{Binding IsLoadingFiles, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorPanel Margin="12" Error="{Binding FilesError}" RetryCommand="{Binding LoadCommand}" />
        <TextBlock Margin="24,8" Style="{StaticResource ForgeBodySecondary}" Text="No file changes in this commit." TextWrapping="Wrap"
                   Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" Style="{StaticResource ForgeGridSplitterStyle}" />

    <!-- ===== Diff of the selected file (read-only) ===== -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Padding="16,8,12,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding SelectedFile, Converter={StaticResource NotNullToVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Style="{StaticResource ForgeBodyStrong}" Text="{Binding SelectedFile.DisplayName}" ToolTip="{Binding SelectedFile.ToolTip}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding SelectedFile.Directory}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button AutomationProperties.Name="View history of file" Command="{Binding ViewFileHistoryCommand}" CommandParameter="{Binding SelectedFile}"
                       Icon="{ui:SymbolIcon History16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="View history of file" />
            <ui:Button AutomationProperties.Name="Open in editor" Command="{Binding OpenFileInEditorCommand}" CommandParameter="{Binding SelectedFile}"
                       Icon="{ui:SymbolIcon Code16}" Style="{StaticResource ForgeIconButtonStyle}" ToolTip="Open in editor" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <controls:DiffView AutomationProperties.AutomationId="Git.CommitDiff" Diff="{Binding Diff}" PlaceholderText="Select a file to see its changes."
                           Visibility="{Binding IsLoadingDiff, Converter={StaticResource InverseBoolToVisibility}}" />
        <controls:LoadingState IsActive="{Binding IsLoadingDiff}" Message="Loading the diff…"
                               Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorPanel Margin="24" Error="{Binding DiffError}" RetryCommand="{Binding RetryDiffCommand}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
