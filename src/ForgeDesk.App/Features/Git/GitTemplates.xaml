<!--
  Git feature: the Git tab of the project workspace (GitSectionViewModel) and its views (Changes,
  History, Branches, Stashes, Tags), the commit details panel and the Git dialogs. Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:git="clr-namespace:ForgeDesk.App.Features.Git"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Git/GitStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:GitSectionViewModel}">
    <git:GitSectionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ChangesViewModel}">
    <git:ChangesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
    <git:HistoryView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:BranchesViewModel}">
    <git:BranchesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:StashesViewModel}">
    <git:StashesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TagsViewModel}">
    <git:TagsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CommitDetailsViewModel}">
    <git:CommitDetailsView />
  </DataTemplate>

  <!-- Dialogs (hosted by the shared DialogWindow) -->
  <DataTemplate DataType="{x:Type vm:GitIdentityDialogViewModel}">
    <git:GitIdentityDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:StashDialogViewModel}">
    <git:StashDialogView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CreateTagDialogViewModel}">
    <git:CreateTagDialogView />
  </DataTemplate>
</ResourceDictionary>
