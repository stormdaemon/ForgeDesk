<!--
  Styles of the Git tab: sub-navigation segments, list rows (group headers, file and commit rows,
  hover actions), state glyphs, ref pills, filter chips and selectable text. Merged by GitTemplates.xaml.
  Brushes are DynamicResource so the light and dark themes both work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell">

  <shell:InverseBooleanConverter x:Key="GitInverseBoolean" />

  <!-- Keyboard focus ring of the custom controls below. -->
  <Style x:Key="GitFocusVisualStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" StrokeThickness="2"
                     Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Sub-navigation: Changes · History · Branches · Stashes · Tags ================= -->

  <Style x:Key="GitSegmentItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource GitFocusVisualStyle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GitSegmentedListStyle" TargetType="ListBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource GitSegmentItemStyle}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Padding="2,2,0,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Counter next to a segment ("5"); red while conflicts remain. -->
  <Style x:Key="GitSegmentBadgeStyle" TargetType="Border" BasedOn="{StaticResource ForgeCountBadgeStyle}">
    <Setter Property="Margin" Value="6,0,0,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding BadgeTone}" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource ForgeDangerSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Lists ======================================================================= -->

  <!-- Rows of the grouped lists (Changes, Branches): headers are not selectable. -->
  <Style x:Key="GitGroupedRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsHeader}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Two-line rows (branches, stashes, tags). -->
  <Style x:Key="GitTallRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource GitGroupedRowStyle}">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!--
    History rows: fixed 32 px and no vertical gap, so the graph lines of consecutive rows join.
    Same hover and accent-pill selection as the other lists.
  -->
  <Style x:Key="GitCommitRowStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="4,0,12,0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="4" />
            <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource ForgeAccentBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Caption of a group of rows ("STAGED CHANGES 3"). -->
  <Style x:Key="GitGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Title of a pane ("Changes", "Stashes"). -->
  <Style x:Key="GitPaneTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeSubtitle}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Hover actions of a row: shown while the row is hovered or selected. -->
  <Style x:Key="GitRowActionsStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Small square icon button of a row (Stage, Unstage, Discard…). Give it a ToolTip and an AutomationProperties.Name. -->
  <Style x:Key="GitRowButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ForgeIconButtonStyle}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- One-letter file state (M, A, D, R, ?, U) on a tinted square. -->
  <Style x:Key="GitStateBadgeStyle" TargetType="Border">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ForgeNeutralSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeNeutralBrush}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource ForgeMonoFont}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StateTone}" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource ForgeWarningSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateTone}" Value="Success">
        <Setter Property="Background" Value="{DynamicResource ForgeSuccessSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateTone}" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource ForgeDangerSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateTone}" Value="Info">
        <Setter Property="Background" Value="{DynamicResource ForgeInfoSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeInfoBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A branch or tag on a commit. The current branch is accented. -->
  <Style x:Key="GitRefPillStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,0,6,1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ForgeNeutralSubtleBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="CurrentBranch">
        <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Head">
        <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Branch">
        <Setter Property="Background" Value="{DynamicResource ForgeInfoSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeInfoBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Tag">
        <Setter Property="Background" Value="{DynamicResource ForgeWarningSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Active filter ("File: src/app.cs ✕"). -->
  <Style x:Key="GitFilterChipStyle" TargetType="Border">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="10,0,2,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
  </Style>

  <!-- ✕ inside a filter chip. -->
  <Style x:Key="GitChipCloseButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ForgeIconButtonStyle}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Commit SHA or parent shown as a link. -->
  <Style x:Key="GitLinkButtonStyle" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource GitFocusVisualStyle}" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeInfoBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Text" FontFamily="{DynamicResource ForgeMonoFont}" FontSize="12" Foreground="{TemplateBinding Foreground}"
                     Text="{TemplateBinding Content}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Read-only text that can be selected and copied (commit messages), looking like a TextBlock. -->
  <Style x:Key="GitSelectableTextStyle" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ForgeAccentBrush}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="ContextMenu" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Label of a detail field ("Author", "Parents"). -->
  <Style x:Key="GitFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="Width" Value="72" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Full-width button of a detail card (Switch, Merge, Delete…). -->
  <Style x:Key="GitCardActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
</ResourceDictionary>
