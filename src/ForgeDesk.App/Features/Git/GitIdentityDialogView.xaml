<UserControl x:Class="ForgeDesk.App.Features.Git.GitIdentityDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitIdentityDialogViewModel}"
             d:DesignWidth="480"
             AutomationProperties.AutomationId="Git.IdentityDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Explanation}" TextWrapping="Wrap" />

        <TextBlock Margin="0,16,0,6" Style="{StaticResource ForgeCaption}" Text="Name" />
        <ui:TextBox x:Name="NameBox" AutomationProperties.AutomationId="Git.IdentityName" AutomationProperties.Name="Name" ClearButtonEnabled="False"
                    PlaceholderText="Ada Lovelace" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,12,0,6" Style="{StaticResource ForgeCaption}" Text="Email" />
        <ui:TextBox AutomationProperties.AutomationId="Git.IdentityEmail" AutomationProperties.Name="Email" ClearButtonEnabled="False"
                    PlaceholderText="you@example.com" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="Git.IdentitySaveButton"
                   Command="{Binding ConfirmCommand}" Content="Save and commit" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
