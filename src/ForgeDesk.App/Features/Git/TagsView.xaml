<UserControl x:Class="ForgeDesk.App.Features.Git.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:conv="clr-namespace:ForgeDesk.App.Converters"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Git;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagsViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000"
             x:Name="Root"
             AutomationProperties.AutomationId="Git.TagsView"
             Focusable="False">
  <UserControl.Resources>
    <!-- A tag: name, kind, message, target commit, date; push and delete on hover. -->
    <DataTemplate x:Key="TagRowTemplate" DataType="{x:Type vm:TagRowViewModel}">
      <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MinWidth="140" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{Binding PushCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Push tag">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="CloudArrowUp16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ShowInHistoryCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Show in history"
                      InputGestureText="Enter">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="History16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding CopyNameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Copy name">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Delete tag…" InputGestureText="Del">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Delete16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource ForgeWarningBrush}" Symbol="Tag16" />
        <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" FontFamily="{DynamicResource ForgeMonoFont}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <controls:Pill Grid.Column="2" Margin="0,0,12,0" Text="{Binding KindText}">
          <controls:Pill.Style>
            <Style TargetType="controls:Pill">
              <Setter Property="Kind" Value="Neutral" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnnotated}" Value="True">
                  <Setter Property="Kind" Value="Info" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:Pill.Style>
        </controls:Pill>
        <TextBlock Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Summary}" />
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource ForgeMonoSecondary}" Text="{Binding ShortSha}" ToolTip="{Binding TargetSha}" />
        <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}"
                   Visibility="{Binding Date, Converter={StaticResource NullToCollapsed}}">
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource RelativeTime}">
              <Binding Path="Date" />
              <Binding Path="Now" Source="{x:Static conv:UiClock.Instance}" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <StackPanel Grid.Column="6" MinWidth="56" Style="{StaticResource GitRowActionsStyle}">
          <ui:Button AutomationProperties.Name="Push tag" Command="{Binding DataContext.PushCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                     CommandParameter="{Binding}" Icon="{ui:SymbolIcon CloudArrowUp16}" Style="{StaticResource GitRowButtonStyle}" ToolTip="Push tag" />
          <ui:Button AutomationProperties.Name="Delete tag" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                     CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete16}" Style="{StaticResource GitRowButtonStyle}" ToolTip="Delete tag… (Del)" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="24,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox MaxWidth="320" HorizontalAlignment="Left" AutomationProperties.AutomationId="Git.TagFilter" AutomationProperties.Name="Filter tags"
                  ClearButtonEnabled="True" Icon="{ui:SymbolIcon Search16}" PlaceholderText="Filter tags" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,12,0" IsIndeterminate="True"
                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button AutomationProperties.AutomationId="Git.CreateTagButton" Command="{Binding CreateCommand}" Content="Create tag…" Icon="{ui:SymbolIcon Tag16}"
                   ToolTip="Tag the current commit (tag any commit from History)" ToolTipService.ShowOnDisabled="True" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <ListBox x:Name="TagList" Margin="8,0,8,4" AutomationProperties.AutomationId="Git.TagList" AutomationProperties.Name="Tags"
               ItemContainerStyle="{StaticResource GitTallRowStyle}" ItemTemplate="{StaticResource TagRowTemplate}" ItemsSource="{Binding Tags}"
               MouseDoubleClick="OnTagDoubleClick" PreviewKeyDown="OnTagListKeyDown" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
               SelectionMode="Single" Style="{StaticResource ForgeDenseListBoxStyle}" />
      <controls:SkeletonList IsActive="{Binding IsLoading}" RowCount="6" RowHeight="44" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      <controls:ErrorPanel Margin="24" Error="{Binding Error}" RetryCommand="{Binding ReloadCommand}" />
      <controls:EmptyState AutomationProperties.AutomationId="Git.NoTagsState" Icon="Tag24" Title="No tags yet"
                           Description="Tags name important commits, like releases. Tag the current commit here, or any commit from History."
                           ActionText="Create tag…" ActionCommand="{Binding CreateCommand}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      <controls:EmptyState Icon="Search24" Title="No tag matches this filter" Description="Check the spelling, or clear the filter to see every tag."
                           ActionText="Clear filter" ActionCommand="{Binding ClearFilterCommand}"
                           Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
