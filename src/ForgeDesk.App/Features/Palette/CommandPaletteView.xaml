<UserControl x:Class="ForgeDesk.App.Features.Palette.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.App.Controls"
             xmlns:palette="clr-namespace:ForgeDesk.App.Features.Palette"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Palette;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
             Focusable="False">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:PaletteGroupHeaderViewModel}">
      <TextBlock Margin="0,10,0,4" FontSize="11" FontWeight="SemiBold" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Title}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PaletteResultViewModel}">
      <Grid Height="36" Background="Transparent" ToolTip="{Binding Subtitle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Width="20" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}, ConverterParameter=Search20}" />
        <DockPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" LastChildFill="True">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource ForgeBody}" palette:HighlightedText.Segments="{Binding TitleSegments}" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding Subtitle}"
                     Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
        </DockPanel>
        <controls:KeyHint Grid.Column="2" Keys="{Binding Shortcut}" Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </DataTemplate>

    <Style x:Key="PaletteRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHeader}" Value="True">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="12,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Prefix chip: "> Actions", "@ Projects"… -->
    <Style x:Key="PrefixChipStyle" TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="4,2,10,2" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- The margin keeps the shadow inside the transparent popup. -->
  <Border Width="640" Margin="24,0,24,36" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
          BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" Direction="270" Opacity="0.35" ShadowDepth="8" Color="Black" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Search field -->
      <Grid Grid.Row="0" Margin="16,0,12,0" Height="52">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Search20" />
        <Grid Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="PlaceholderText" Margin="2,0,0,0" VerticalAlignment="Center" FontSize="15" IsHitTestVisible="False"
                     Style="{StaticResource ForgeBodySecondary}" Text="{Binding Placeholder}"
                     Visibility="{Binding Text, ElementName=QueryBox, Converter={StaticResource NullToVisible}}" />
          <TextBox x:Name="QueryBox" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Search or run a command"
                   Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource TextFillColorPrimaryBrush}" FontSize="15"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </ControlTemplate>
            </TextBox.Template>
            <TextBox.InputBindings>
              <KeyBinding Key="Down" Command="{Binding MoveNextCommand}" />
              <KeyBinding Key="Up" Command="{Binding MovePreviousCommand}" />
              <KeyBinding Key="Tab" Command="{Binding MoveNextCommand}" />
              <KeyBinding Key="Tab" Modifiers="Shift" Command="{Binding MovePreviousCommand}" />
              <KeyBinding Key="Enter" Command="{Binding ExecuteSelectedCommand}" />
              <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </Grid>
        <!-- Appears only for searches slower than 200 ms, so typing never flickers a spinner. -->
        <Grid Grid.Column="2" Opacity="0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToHidden}}">
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="RevealSpinner">
                      <Storyboard>
                        <DoubleAnimation BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="RevealSpinner" />
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
        </Grid>
      </Grid>

      <!-- Prefix chips (until something is typed) -->
      <ItemsControl Grid.Row="1" Margin="16,0,16,10" Focusable="False" ItemsSource="{Binding PrefixHints}"
                    Visibility="{Binding ShowPrefixHints, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PalettePrefixHint}">
            <Button Command="{Binding DataContext.ApplyPrefixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Prefix}" Style="{StaticResource PrefixChipStyle}"
                    ToolTip="{Binding Prefix, StringFormat=Type {0} to search only these}">
              <StackPanel Orientation="Horizontal">
                <controls:KeyHint Keys="{Binding Prefix}" />
                <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="{Binding Label}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource ForgeDividerStyle}" />

      <!-- Results -->
      <Grid Grid.Row="2">
        <ListBox x:Name="Results" MaxHeight="440" Padding="8,0,8,8" Focusable="False" ItemContainerStyle="{StaticResource PaletteRowStyle}"
                 ItemsSource="{Binding Rows}" PreviewMouseLeftButtonUp="OnResultsMouseUp" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 SelectionChanged="OnResultsSelectionChanged" Style="{StaticResource ForgeDenseListBoxStyle}" />
        <TextBlock Margin="16,20" HorizontalAlignment="Center" Style="{StaticResource ForgeBodySecondary}" Text="{Binding NoResultsText}"
                   TextWrapping="Wrap" Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <!-- Keyboard hints -->
      <Border Grid.Row="3" Padding="16,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
        <StackPanel Orientation="Horizontal">
          <controls:KeyHint Keys="Up" />
          <controls:KeyHint Keys="Down" />
          <TextBlock Margin="4,0,16,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="to navigate" />
          <controls:KeyHint Keys="Enter" />
          <TextBlock Margin="4,0,16,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="to run" />
          <controls:KeyHint Keys="Esc" />
          <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource ForgeCaptionSecondary}" Text="to close" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
