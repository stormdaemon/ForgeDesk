<!--
  Palette feature: the command palette card for CommandPaletteViewModel. The shell hosts it in a
  Popup (so it renders above the terminal HWND). Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:palette="clr-namespace:ForgeDesk.App.Features.Palette"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Palette;assembly=ForgeDesk.Presentation">

  <DataTemplate DataType="{x:Type vm:CommandPaletteViewModel}">
    <palette:CommandPaletteView />
  </DataTemplate>
</ResourceDictionary>
