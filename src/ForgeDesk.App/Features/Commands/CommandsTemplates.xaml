<!--
  Commands feature: the Commands tab of the project workspace (CommandsSectionViewModel), the
  selected run's detail and the command editor dialog. Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:commands="clr-namespace:ForgeDesk.App.Features.Commands"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Commands;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Commands/CommandsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:CommandsSectionViewModel}">
    <commands:CommandsSectionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RunDetailViewModel}">
    <commands:RunDetailView />
  </DataTemplate>

  <!-- Dialogs (hosted by the shared DialogWindow) -->
  <DataTemplate DataType="{x:Type vm:CommandEditorDialogViewModel}">
    <commands:CommandEditorDialogView />
  </DataTemplate>
</ResourceDictionary>
