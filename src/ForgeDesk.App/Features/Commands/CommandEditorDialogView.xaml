<UserControl x:Class="ForgeDesk.App.Features.Commands.CommandEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.Commands;assembly=ForgeDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandEditorDialogViewModel}"
             d:DesignWidth="520"
             AutomationProperties.AutomationId="Commands.EditorDialog">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource ForgeTitle}" Text="{Binding Title}" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource ForgeBodySecondary}" Text="{Binding Explanation}" TextWrapping="Wrap" />

        <TextBlock Margin="0,16,0,6" Style="{StaticResource ForgeCaption}" Text="Name" />
        <ui:TextBox x:Name="NameBox" AutomationProperties.AutomationId="Commands.EditorName" AutomationProperties.Name="Command name" ClearButtonEnabled="False"
                    PlaceholderText="Start API" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding NameError}"
                   TextWrapping="Wrap" Visibility="{Binding NameError, Converter={StaticResource NullToCollapsed}}" />

        <TextBlock Margin="0,12,0,6" Style="{StaticResource ForgeCaption}" Text="Command line" />
        <ui:TextBox AutomationProperties.AutomationId="Commands.EditorCommandLine" AutomationProperties.Name="Command line" ClearButtonEnabled="False"
                    FontFamily="{DynamicResource ForgeMonoFont}" PlaceholderText="npm run dev -- --port 4000"
                    Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding CommandLineError}"
                   TextWrapping="Wrap" Visibility="{Binding CommandLineError, Converter={StaticResource NullToCollapsed}}" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Category" />
            <ComboBox AutomationProperties.AutomationId="Commands.EditorCategory" AutomationProperties.Name="Category" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CommandCategoryOption}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Symbol="{Binding Icon, Converter={StaticResource SymbolFromName}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,6" Style="{StaticResource ForgeCaption}" Text="Working directory (optional)" />
            <ui:TextBox AutomationProperties.AutomationId="Commands.EditorWorkingDirectory" AutomationProperties.Name="Working directory" ClearButtonEnabled="False"
                        FontFamily="{DynamicResource ForgeMonoFont}" PlaceholderText="src/web" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,6,0,0" Style="{StaticResource ForgeCaptionSecondary}" Text="{Binding WorkingDirectoryHint}" TextWrapping="Wrap"
                   Visibility="{Binding WorkingDirectoryError, Converter={StaticResource NullToVisible}}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ForgeDangerBrush}" Style="{StaticResource ForgeCaption}" Text="{Binding WorkingDirectoryError}"
                   TextWrapping="Wrap" Visibility="{Binding WorkingDirectoryError, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" AutomationProperties.AutomationId="Commands.EditorConfirmButton"
                   Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
