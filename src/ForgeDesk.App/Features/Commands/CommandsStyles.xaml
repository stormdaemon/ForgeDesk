<!--
  Styles of the Commands tab: grouped rows (category headers are not selectable), hover actions,
  run buttons, source pills, run status glyphs and the log viewer lines. Merged by CommandsTemplates.xaml.
  Brushes are DynamicResource so the light and dark themes both work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell">

  <shell:StatusToneToKindConverter x:Key="CommandsToneToKind" />
  <shell:InverseBooleanConverter x:Key="CommandsInverseBoolean" />

  <!-- Title of a pane ("Commands", "Runs"). -->
  <Style x:Key="CommandsPaneTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeSubtitle}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Caption of a group of rows ("BUILD", "RUNNING"). -->
  <Style x:Key="CommandsGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeCaptionSecondary}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rows of the grouped lists: headers are neither selectable nor focusable. -->
  <Style x:Key="CommandsGroupedRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ForgeDenseListBoxItemStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsHeader}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="4,6,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Two-line command rows. -->
  <Style x:Key="CommandsCommandRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource CommandsGroupedRowStyle}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="10,0,6,0" />
  </Style>

  <!-- Run rows. -->
  <Style x:Key="CommandsRunRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource CommandsGroupedRowStyle}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10,0,10,0" />
  </Style>

  <!-- Hover actions of a row: shown while the row is hovered or selected. -->
  <Style x:Key="CommandsRowActionsStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Small square icon button of a row. Give it a ToolTip and an AutomationProperties.Name. -->
  <Style x:Key="CommandsRowButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ForgeIconButtonStyle}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ▶ Run / ■ Stop of a command row: quiet until hovered, accent glyph; red while the command runs. -->
  <Style x:Key="CommandsRunButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0,10,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- "package.json", "custom" -->
  <Style x:Key="CommandsSourcePillStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0,5,1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ForgeNeutralSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCustom}" Value="True">
        <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Active filter chip ("Category: Build ✕"). -->
  <Style x:Key="CommandsFilterChipStyle" TargetType="Border">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Padding" Value="10,0,2,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
  </Style>

  <!-- Status glyph of a finished run, colored by its status. -->
  <Style x:Key="CommandsRunStatusIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeNeutralBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Succeeded">
        <Setter Property="Foreground" Value="{DynamicResource ForgeSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Failed">
        <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Interrupted">
        <Setter Property="Foreground" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Field label of the run header ("Started", "Directory"). -->
  <Style x:Key="CommandsMetaIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- ===== Log viewer =================================================================== -->

  <!-- A log line: no hover chrome, compact, tinted for stderr / errors / search results. -->
  <Style x:Key="CommandsLogLineItemStyle" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="12,1,12,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsErrorLine}" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ForgeDangerSubtleBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ForgeDangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMatch}" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ForgeWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrentMatch}" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ForgeWarningSubtleBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ForgeWarningBrush}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CommandsLogTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ForgeCodeFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsStdErr}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForgeWarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsErrorLine}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ForgeDangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Surface of the log (slightly recessed). -->
  <Style x:Key="CommandsLogSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Read-only, selectable text without chrome (error summary). -->
  <Style x:Key="CommandsSelectableMonoStyle" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource ForgeMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ForgeAccentBrush}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
