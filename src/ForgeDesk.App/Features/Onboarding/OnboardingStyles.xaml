<!--
  Styles of the onboarding flow: progress dots, highlight tiles, big choice buttons.
  Merged by OnboardingTemplates.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:ForgeDesk.App.Shell">

  <shell:StatusToneToKindConverter x:Key="OnboardingStatusToneToKind" />

  <Style x:Key="OnboardingFocusVisualStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True" StrokeThickness="2"
                     Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A progress dot: a pill for the current step, filled for done steps, hollow for the next ones. -->
  <Style x:Key="OnboardingDotStyle" TargetType="Border">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDone}" Value="True">
        <Setter Property="Background" Value="{DynamicResource ForgeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter Property="Width" Value="28" />
        <Setter Property="Background" Value="{DynamicResource ForgeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Value proposition tile of the welcome step. -->
  <Style x:Key="OnboardingTileStyle" TargetType="Border">
    <Setter Property="Width" Value="216" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="OnboardingIconTileStyle" TargetType="Border">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
  </Style>

  <!-- Big choice (add a folder, clone). -->
  <Style x:Key="OnboardingChoiceStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="300" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Title and lead paragraph of a step. -->
  <Style x:Key="OnboardingHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeDisplay}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style x:Key="OnboardingLeadStyle" TargetType="TextBlock" BasedOn="{StaticResource ForgeBodySecondary}">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- A check of the environment step (Git, GitHub CLI). -->
  <Style x:Key="OnboardingCheckCardStyle" TargetType="Border">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Text button styled as a link. -->
  <Style x:Key="OnboardingLinkStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Padding="0,2" Background="Transparent">
            <TextBlock x:Name="Label" FontSize="13" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
