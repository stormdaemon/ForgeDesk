<!--
  Onboarding feature: the first-launch step flow (the GitHub sign-in step reuses the Settings view of
  GitHubSignInViewModel). Merged by App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ForgeDesk.App.Features.Onboarding"
                    xmlns:vm="clr-namespace:ForgeDesk.Presentation.Onboarding;assembly=ForgeDesk.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ForgeDesk;component/Features/Onboarding/OnboardingStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
    <views:OnboardingView />
  </DataTemplate>
</ResourceDictionary>
