<dialogs:ForgeDialogWindow x:Class="ForgeDesk.App.Dialogs.PromptDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                           xmlns:dialogs="clr-namespace:ForgeDesk.App.Dialogs"
                           Width="480">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

    <Border Grid.Row="1" Background="{DynamicResource ContentDialogTopOverlay}">
      <StackPanel Margin="24,8,24,24">
        <TextBlock x:Name="HeadingText" Style="{StaticResource ForgeTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" Style="{StaticResource ForgeBody}" TextWrapping="Wrap" Visibility="Collapsed" />
        <ui:TextBox x:Name="Input" Margin="0,16,0,0" ClearButtonEnabled="False" />
        <TextBlock x:Name="ValidationText" Margin="0,6,0,0" Style="{StaticResource ForgeCaption}"
                   Foreground="{DynamicResource ForgeDangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Padding="24,20" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="2">
        <ui:Button x:Name="ConfirmButton" Margin="0,0,4,0" HorizontalAlignment="Stretch" Appearance="Primary" Click="OnConfirm" />
        <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Secondary" Click="OnCancel" Content="Cancel" />
      </UniformGrid>
    </Border>
  </Grid>
</dialogs:ForgeDialogWindow>
