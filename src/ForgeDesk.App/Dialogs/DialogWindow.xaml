<dialogs:ForgeDialogWindow x:Class="ForgeDesk.App.Dialogs.DialogWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                           xmlns:dialogs="clr-namespace:ForgeDesk.App.Dialogs"
                           Title="{Binding Title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="{Binding Title}" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

    <!-- The view comes from the view model's implicit DataTemplate (Features/*/*Templates.xaml). -->
    <ContentControl x:Name="Host" Grid.Row="1" Content="{Binding}" Focusable="False" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</dialogs:ForgeDialogWindow>
